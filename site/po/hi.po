#. type: Title ###
#: docs/api.md
#, no-wrap
msgid "PrinterStatus { #printerstatus }"
msgstr "PrinterStatus { #printerstatus }"

#. type: Plain text
#: docs/api.md
#, no-wrap
msgid ""
"| Field | Type | Meaning |\n"
"|---|---|---|\n"
"| `printer` | string |  |\n"
"| `host` | string |  |\n"
"| `name` | string | Its name in `printers.toml`. |\n"
"| `model` | string |  |\n"
"| `state` | string |  |\n"
"| `error` | null or Warning |  |\n"
"| `dpi` | number |  |\n"
