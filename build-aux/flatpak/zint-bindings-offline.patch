-	BYPRODUCTS "${CMAKE_CURRENT_BUILD_DIR}/zint-stubs"
-	WORKING_DIRECTORY "${CMAKE_CURRENT_BUILD_DIR}"
-	COMMENT "Generating stub file"
-	VERBATIM
-)
-
