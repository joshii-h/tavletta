#, python-format
msgid "%d %%"
msgstr "%d %%"

#. translators: print speed in inches per second, as label printers state it
#: tavletta/ui/texts.py:280
#, python-format
msgid "%d in/s"
msgstr "%d pol./s"

#: tavletta/ui/texts.py:289 tavletta/server/web/ui.js:66
msgid "Image"
msgstr "Imagem"

#: tavletta/ui/texts.py:324
#, python-format
msgid "Endless, %(width)s wide"
msgstr "Contínua, %(width)s de largura"

#: tavletta/ui/texts.py:334
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "Verifique se a etiqueta inteira está dentro da seleção. Arraste para movê-la ou mover suas bordas, ou desenhe uma nova."

#: tavletta/ui/texts.py:338
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "Várias áreas podem ser a etiqueta. Verifique a seleção ou tente a próxima."

#: tavletta/ui/texts.py:340
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "Tudo o que está impresso na página está selecionado. Arraste para escolher a etiqueta."

#: tavletta/ui/texts.py:341
msgid "Nothing is printed on this page."
msgstr "Não há nada impresso nesta página."

#: tavletta/ui/texts.py:346
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Arquivos PDF precisam do Poppler (poppler-glib), que não está instalado"

#: tavletta/ui/texts.py:357
msgid "System printer (CUPS, IPP)"
msgstr "Impressora do sistema (CUPS, IPP)"

#: tavletta/ui/texts.py:358
msgid "Receipt printer (ESC/POS)"
msgstr "Impressora de cupons (ESC/POS)"

#. translators: %s is a printer model, e.g. "Brother QL"
#: tavletta/ui/texts.py:360
#, python-format
msgid "%s, continuous rolls"
msgstr "%s, rolos contínuos"

#. translators: %s is a printer model, e.g. "Brother QL"
#: tavletta/ui/texts.py:362
#, python-format
msgid "%s, die-cut labels"
msgstr "%s, etiquetas pré-cortadas"

#: tavletta/ui/texts.py:385
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Elemento %(n)d: o código está vazio"

#: tavletta/ui/texts.py:386
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Elemento %(n)d: o EAN-13 precisa de exatamente 12 dígitos"

#: tavletta/ui/texts.py:387
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Elemento %(n)d: o dígito verificador do EAN-13 está errado"

#: tavletta/ui/texts.py:388
#, python-format
msgid "Element %(n)d: Code 128 holds at most %(max)d characters"
msgstr "Elemento %(n)d: o Code 128 comporta no máximo %(max)d caracteres"

#: tavletta/ui/texts.py:390
#, python-format
msgid ""
"Element %(n)d: the bars are too thin to scan reliably – use a longer or "
"larger label, or shorter content"
msgstr "Elemento %(n)d: as barras são finas demais para uma leitura confiável – use uma etiqueta mais longa ou maior, ou um conteúdo mais curto"

#: tavletta/ui/texts.py:394
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Elemento %(n)d: o Code 128 só aceita letras latinas, dígitos e pontuação"

#: tavletta/ui/texts.py:396
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Elemento %(n)d: o EAN-8 precisa de 7 dígitos, ou 8 com o dígito verificador"

#: tavletta/ui/texts.py:397
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "Elemento %(n)d: o UPC-A precisa de 11 dígitos, ou 12 com o dígito verificador"

#: tavletta/ui/texts.py:399
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "Elemento %(n)d: o UPC-E precisa de 7 dígitos começando com 0 ou 1, ou 8 com o dígito verificador"

#: tavletta/ui/texts.py:401
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "Elemento %(n)d: o ITF-14 precisa de 13 dígitos, ou 14 com o dígito verificador"

#: tavletta/ui/texts.py:402
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "Elemento %(n)d: o dígito verificador está errado"

#: tavletta/ui/texts.py:404
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Elemento %(n)d: o Code 39 só aceita maiúsculas, dígitos, espaços e - . $ / + %%"

#: tavletta/ui/texts.py:407
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Elemento %(n)d: o Code 93 só aceita letras latinas, dígitos e pontuação"

#: tavletta/ui/texts.py:410
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Elemento %(n)d: os dados GS1 só aceitam letras latinas, dígitos e pontuação"

#: tavletta/ui/texts.py:413
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Elemento %(n)d: os dados GS1 devem ser identificadores de aplicação entre parênteses, cada um seguido do seu valor, p. ex. (01)09501101530003(10)AB12"

#: tavletta/ui/texts.py:416
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Elemento %(n)d: (%(ai)s) não é um identificador de aplicação GS1"

#: tavletta/ui/texts.py:418
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Elemento %(n)d: o valor do identificador de aplicação (%(ai)s) tem o comprimento errado"

#: tavletta/ui/texts.py:421
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Elemento %(n)d: o dígito verificador do identificador de aplicação (%(ai)s) está errado"

#: tavletta/ui/texts.py:424
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Elemento %(n)d: o valor do identificador de aplicação (%(ai)s) não é válido: contém uma data, um número ou um caractere não permitido"

#: tavletta/ui/texts.py:428
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Elemento %(n)d: nenhum número UPC-A se abrevia para estes dígitos UPC-E – confira-os ou use UPC-A"

#: tavletta/ui/texts.py:432
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Elemento %(n)d: leitores configurados para Full ASCII leem um $, /, + ou %% antes de uma maiúscula como outro caractere"

#: tavletta/ui/texts.py:435
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Elemento %(n)d: o conteúdo é longo demais para este tipo de código"

#: tavletta/ui/texts.py:436
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Elemento %(n)d: o conteúdo não pode ser codificado neste tipo de código"

#: tavletta/ui/texts.py:438
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Elemento %(n)d: este tipo de código precisa da biblioteca Zint (zint-bindings), que não está instalada"

#: tavletta/ui/texts.py:441
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Elemento %(n)d: não foi possível ler a imagem"

#: tavletta/ui/texts.py:442
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Elemento %(n)d: este símbolo não está na biblioteca de símbolos"

#: tavletta/ui/texts.py:443
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Elemento %(n)d: não foi possível ler o documento"

#: tavletta/ui/texts.py:445
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Elemento %(n)d: arquivos PDF precisam do Poppler (poppler-glib), que não está instalado"

#: tavletta/ui/texts.py:447
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Não foi possível desenhar o elemento %(n)d"

#: tavletta/ui/texts.py:449
#, python-format
msgid ""
"Element %(n)d: the text is too long to be drawn in one line – break it into "
"lines or shorten it"
msgstr "Elemento %(n)d: o texto é longo demais para ser desenhado em uma linha – divida-o em linhas ou encurte-o"

#: tavletta/ui/texts.py:453
#, python-format
msgid ""
"Element %(n)d: the text is too tall to be drawn – use fewer lines or a "
"smaller size"
msgstr "Elemento %(n)d: o texto é alto demais para ser desenhado – use menos linhas ou um tamanho menor"

#: tavletta/ui/texts.py:456
#, python-format
msgid ""
"Element %(n)d: the font %(font)s is not installed – another font is used"
msgstr "Elemento %(n)d: a fonte %(font)s não está instalada – outra fonte é usada"

#: tavletta/ui/texts.py:459
msgid ""
"Safety margin, border, its inset and edge spacing leave no room – reduce them"
msgstr "A margem de segurança, a borda, seu recuo e a margem lateral não deixam espaço – reduza-os"

#: tavletta/ui/texts.py:461
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "O comprimento fixo é menor que o espaçamento – aumente-o"

#: tavletta/ui/texts.py:462
msgid "The background image cannot be read"
msgstr "Não foi possível ler a imagem de fundo"

#: tavletta/ui/texts.py:464
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Elemento %(n)d: os módulos do código têm apenas um ponto de impressão de largura e podem não ser lidos – aumente o código"

#: tavletta/ui/texts.py:468
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Elemento %(n)d: o espaço em branco de que o código precisa ao redor não cabe – aumente o código"

#: tavletta/ui/texts.py:472
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Elemento %(n)d: o código não cabe no seu espaço, nem com um ponto de impressão por módulo – aumente a etiqueta ou encurte o conteúdo"

#: tavletta/ui/texts.py:475
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Elemento %(n)d: %(name)s não é uma variável conhecida"

#: tavletta/ui/texts.py:477
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Elemento %(n)d: a data de %(name)s é anterior ao ano 1 ou posterior a 9999"

#: tavletta/ui/texts.py:480
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Elemento %(n)d: a variável %(name)s… não está fechada – termine-a com }"

#: tavletta/ui/texts.py:483
#, python-format
msgid ""
"Element %(n)d: on a black-and-white printer it hardly stands out from what "
"lies behind it, as a whole or in part – choose another colour or move it"
msgstr "Elemento %(n)d: em uma impressora em preto e branco ele mal se destaca do que está atrás, no todo ou em parte – escolha outra cor ou mova-o"

#: tavletta/ui/texts.py:486
#, python-format
msgid "Element %(n)d: the shape has neither a line nor a fill"
msgstr "Elemento %(n)d: a forma não tem linha nem preenchimento"

#: tavletta/ui/texts.py:488
#, python-format
msgid ""
"Element %(n)d reaches beyond the edge of the label and is cut off there – "
"move it or make it smaller"
msgstr "O elemento %(n)d ultrapassa a borda da etiqueta e é cortado ali – mova-o ou diminua-o"

#: tavletta/ui/texts.py:492
#, python-format
msgid ""
"Element %(n)d: the padding, frame, outline or shadow leave no room for the "
"text – make them smaller"
msgstr "Elemento %(n)d: a margem interna, a moldura, o contorno ou a sombra não deixam espaço para o texto – reduza-os"

#: tavletta/ui/texts.py:507
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Folhas já impressas: %(n)d de %(total)d."

#: tavletta/ui/texts.py:509
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Etiquetas já impressas: %(n)d de %(total)d."

#: tavletta/ui/texts.py:513
msgid "The sheets still waiting in the queue were canceled."
msgstr "As folhas que ainda aguardavam na fila foram canceladas."

#: tavletta/ui/texts.py:515
msgid "The labels still waiting in the queue were canceled."
msgstr "As etiquetas que ainda aguardavam na fila foram canceladas."

#: tavletta/ui/texts.py:526
#, python-format
msgid ""
"The label is %(size)s, but labels of %(loaded)s are loaded. Check the label "
"size, or load the matching roll."
msgstr "A etiqueta tem %(size)s, mas estão colocadas etiquetas de %(loaded)s. Verifique o tamanho da etiqueta ou coloque o rolo adequado."

#: tavletta/ui/texts.py:534
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap, or calibrate the printer."
msgstr "A etiqueta tem %(size)s com um espaço de %(gap)s, então uma nova começa a cada %(pitch)s. A impressora mediu uma etiqueta a cada %(measured)s. Verifique o tamanho da etiqueta e o espaço, ou calibre a impressora."

#: tavletta/ui/texts.py:540
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap."
msgstr "A etiqueta tem %(size)s com um espaço de %(gap)s, então uma nova começa a cada %(pitch)s. A impressora mediu uma etiqueta a cada %(measured)s. Verifique o tamanho da etiqueta e o espaço."

#: tavletta/ui/texts.py:557
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "A impressora não foi encontrada. Verifique se ela está ligada e na mesma rede, ou digite o endereço IP."

#: tavletta/ui/texts.py:561
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "A impressora não foi encontrada via USB. Verifique o cabo e se a impressora está ligada e ativa, depois procure novamente."

#: tavletta/ui/texts.py:564
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "A impressora não responde. Verifique se ela está ligada e ativa."

#: tavletta/ui/texts.py:566
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "A impressora parou de receber dados. Verifique se ela indica algum problema, como falta de etiquetas ou uma tampa aberta, e tente novamente."

#: tavletta/ui/texts.py:570
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "A impressora recusa a conexão. Desligue-a e ligue-a novamente. Se a interface web oferecer uma opção “Port 9100”, ative-a."

#: tavletta/ui/texts.py:573
msgid "No cassette is inserted. Insert one and try again."
msgstr "Nenhum cassete inserido. Insira um e tente novamente."

#: tavletta/ui/texts.py:574
msgid "The printer's cover is open. Close it and try again."
msgstr "A tampa da impressora está aberta. Feche-a e tente novamente."

#: tavletta/ui/texts.py:575
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "A etiqueta atolou. Abra a tampa, retire-a e tente novamente."

#: tavletta/ui/texts.py:576
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "O cassete não foi reconhecido. Insira-o novamente ou tente outro."

#: tavletta/ui/texts.py:577
msgid "The printer is busy. Wait a moment and try again."
msgstr "A impressora está ocupada. Aguarde um momento e tente novamente."

#: tavletta/ui/texts.py:578
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "A etiqueta é longa demais para esta impressora: no máximo %(max)s."

#: tavletta/ui/texts.py:579
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "A etiqueta é larga demais para esta impressora: no máximo %(max)s."

#: tavletta/ui/texts.py:580
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "A impressora está sem etiquetas. Coloque um novo rolo e tente novamente."

#: tavletta/ui/texts.py:581
msgid "The print head is open. Close it and try again."
msgstr "O cabeçote de impressão está aberto. Feche-o e tente novamente."

#: tavletta/ui/texts.py:583
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "A impressora não encontra a próxima etiqueta. Verifique se as etiquetas estão bem carregadas e passam pelo sensor de etiquetas."

#: tavletta/ui/texts.py:587
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Há um problema com a fita. Verifique se ela está bem colocada e se corresponde ao método de impressão configurado na impressora."

#: tavletta/ui/texts.py:593
#, python-format
msgid ""
"The printer finds no ribbon. Load a ribbon and try again. Labels that print "
"without one need “%(direct)s” under “%(method)s”."
msgstr "A impressora não encontra fita. Coloque uma fita e tente de novo. Etiquetas que imprimem sem fita precisam de “%(direct)s” em “%(method)s”."

#: tavletta/ui/texts.py:600
#, python-format
msgid ""
"A ribbon is loaded, but the printer prints without it (thermal direct). For "
"labels that need the ribbon choose “%(transfer)s” under “%(method)s”, or "
"remove the ribbon."
msgstr "Há uma fita colocada, mas a impressora imprime sem ela (térmica direta). Para etiquetas que precisam da fita, escolha “%(transfer)s” em “%(method)s”, ou retire a fita."

#: tavletta/ui/texts.py:605
msgid "The printer is paused. Resume it on its display and try again."
msgstr "A impressora está pausada. Retome-a no display e tente novamente."

#: tavletta/ui/texts.py:606
msgid "The printer is out of paper. Load paper and try again."
msgstr "A impressora está sem papel. Coloque papel e tente novamente."

#: tavletta/ui/texts.py:608
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "O papel está atolado. Remova-o conforme indicado no display da impressora e tente novamente."

#: tavletta/ui/texts.py:610
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "A impressora está sem toner ou tinta. Substitua e tente novamente."

#: tavletta/ui/texts.py:611
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "A impressora não consegue imprimir este tamanho. Escolha um tamanho de papel que ela ofereça."

#: tavletta/ui/texts.py:613
msgid ""
"The printer takes none of the formats Tavletta can send (PDF, PWG Raster, "
"JPEG)."
msgstr "A impressora não aceita nenhum dos formatos que o Tavletta pode enviar (PDF, PWG Raster, JPEG)."

#: tavletta/ui/texts.py:616
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "A fila da impressora está pausada. Retome-a nas configurações de impressora do sistema e tente novamente."

#: tavletta/ui/texts.py:620
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "O trabalho de impressão ficou retido na fila, por exemplo até ser liberado ou até que uma senha seja digitada. Verifique a fila nas configurações de impressora do sistema e tente novamente."

#: tavletta/ui/texts.py:624
msgid "The print job was canceled at the printer or in the queue."
msgstr "O trabalho de impressão foi cancelado na impressora ou na fila."

#: tavletta/ui/texts.py:625
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "A impressora não informou a resolução a tempo. Escolha-a em “%s”."

#: tavletta/ui/texts.py:628
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "O rolo colocado não corresponde à etiqueta. Coloque um rolo adequado ou escolha o tamanho da etiqueta ou o modelo da impressora do rolo colocado."

#: tavletta/ui/texts.py:631
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "A bateria da impressora está fraca – carregue-a ou conecte o adaptador de energia."

#: tavletta/ui/texts.py:632
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "O cabeçote de impressão está quente demais. Espere até ele esfriar e tente novamente."

#: tavletta/ui/texts.py:634
msgid ""
"Tavletta cannot print on this printer model: it does not take the raster "
"images Tavletta sends."
msgstr "O Tavletta não consegue imprimir neste modelo de impressora: ele não aceita as imagens raster que o Tavletta envia."

#: tavletta/ui/texts.py:638
msgid "Tavletta does not know this printer model and cannot print on it yet."
msgstr "O Tavletta não conhece este modelo de impressora e ainda não consegue imprimir nele."

#: tavletta/ui/texts.py:641
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "A impressora está no modo Editor Lite e aparece como unidade USB. Desligue o Editor Lite na impressora (a luz se apaga) e procure novamente."

#: tavletta/ui/texts.py:645
msgid ""
"Tavletta is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "O Tavletta não tem permissão para usar a porta USB da impressora. Adicione seu usuário ao grupo “lp” (sudo usermod -aG lp $USER) e depois saia da sessão e entre novamente."

#: tavletta/ui/texts.py:649
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "A página é grande demais para ser gerada na resolução que a impressora aceita. Escolha um tamanho de papel menor ou imprima em uma impressora que aceite PDF."

#: tavletta/ui/texts.py:653
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Um código não cabe na etiqueta com a resolução desta impressora e seria cortado. Aumente a etiqueta ou encurte o conteúdo do código."

#: tavletta/ui/texts.py:657
msgid ""
"Tavletta is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "O Tavletta não tem permissão para usar a porta serial da impressora. Adicione seu usuário ao grupo “dialout” (sudo usermod -aG dialout $USER; no Arch Linux o grupo se chama “uucp”) e depois saia da sessão e entre novamente."

#: tavletta/ui/texts.py:662
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "A impressora relatou um problema. Desligue-a e ligue-a novamente e tente mais uma vez."

#: tavletta/ui/texts.py:673 tavletta/server/web/ui.js:452
msgid "Printed"
msgstr "Impressa"

#: tavletta/ui/texts.py:679
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Enviado para a impressora – será impresso quando chegar a vez dele"

#: tavletta/ui/texts.py:681
msgid "Sent to the printer – it did not confirm printing"
msgstr "Enviado para a impressora – ela não confirmou a impressão"

#: tavletta/ui/texts.py:685
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "Impresso com “%(used)s”, como o rolo colocado exige"

#: tavletta/ui/texts.py:689
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "O modo de cor “%(wanted)s” não está disponível nesta impressora, impresso com “%(used)s”"

#: tavletta/ui/texts.py:699
msgid "Warming up…"
msgstr "Aquecendo…"

#: tavletta/ui/texts.py:700
msgid "Cooling down…"
msgstr "Resfriando…"

#: tavletta/ui/texts.py:701
msgid "Cleaning…"
msgstr "Limpando…"

#: tavletta/ui/texts.py:702
msgid "Swipe the printer's panel to cut the label"
msgstr "Deslize o dedo no painel da impressora para cortar a etiqueta"

#: tavletta/ui/texts.py:704
msgid "Out of paper – load paper to continue"
msgstr "Sem papel – coloque papel para continuar"

#: tavletta/ui/texts.py:705
msgid "Cover open – close it to continue"
msgstr "Tampa aberta – feche-a para continuar"

#: tavletta/ui/texts.py:706
msgid "Paper jammed – remove it to continue"
msgstr "Papel atolado – remova-o para continuar"

#: tavletta/ui/texts.py:717
msgid "This label needs a newer version of Tavletta"
msgstr "Esta etiqueta precisa de uma versão mais recente do Tavletta"

#: tavletta/ui/texts.py:719
#, python-format
msgid "%s is not a Tavletta label"
msgstr "%s não é uma etiqueta do Tavletta"

#: tavletta/ui/texts.py:720 tavletta/ui/texts.py:740
#: tavletta/server/service.py:914
#, python-format
msgid "The file is damaged: %s"
msgstr "O arquivo está danificado: %s"

#: tavletta/ui/texts.py:727
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "O arquivo de dados %s não existe mais. Escolha-o novamente ou remova-o."

#: tavletta/ui/texts.py:731
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s não tem nenhuma planilha chamada %(sheet)s"

#: tavletta/ui/texts.py:733
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s não é uma tabela. Use um arquivo CSV, ODS ou XLSX."

#: tavletta/ui/texts.py:735
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s é grande demais para etiquetas em série. Divida-o em arquivos menores ou remova as linhas e colunas que não são necessárias."

#: tavletta/ui/texts.py:738
#, python-format
msgid "%s contains no data."
msgstr "%s não contém dados."

#: tavletta/ui/texts.py:749
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "A impressão parou na linha %(row)d. Para continuar, imprima novamente a partir da linha %(row)d."

#: tavletta/ui/texts.py:753
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "Cópias da linha %(row)d já impressas: %(copies)d."

#: tavletta/ui/texts.py:758
#, python-format
msgid "Row %(row)d goes at position %(position)d of sheet %(sheet)d."
msgstr "A linha %(row)d vai na posição %(position)d da folha %(sheet)d."

#: tavletta/ui/texts.py:769
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Não foi possível salvar %s: sem permissão de gravação nesse local"

#: tavletta/ui/texts.py:771
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Não foi possível salvar %s: o disco está cheio"

#: tavletta/ui/texts.py:781
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Este cassete parece ser de %(month)s de %(year)d. Papel ZINK antigo imprime cores mais pálidas."

#: tavletta/ui/variables.py:24
msgid "Date"
msgstr "Data"

#: tavletta/ui/variables.py:25
msgid "Best before (in 30 days)"
msgstr "Consumir de preferência antes de (em 30 dias)"

#: tavletta/ui/variables.py:26
msgid "Time"
msgstr "Hora"

#: tavletta/ui/variables.py:27 tavletta/ui/variables.py:113
msgid "Counter"
msgstr "Contador"

#: tavletta/ui/variables.py:28
msgid "Counter with leading zeros"
msgstr "Contador com zeros à esquerda"

#: tavletta/ui/variables.py:29
msgid "Copy number"
msgstr "Número da cópia"

#: tavletta/ui/variables.py:30
msgid "Number of copies"
msgstr "Número de cópias"

#: tavletta/ui/variables.py:31
msgid "Random ID"
msgstr "ID aleatório"

#: tavletta/ui/variables.py:41
msgid "Insert variable"
msgstr "Inserir variável"

#: tavletta/ui/variables.py:67
msgid ""
"Variables are filled in when printing. Every printed label gets the next "
"counter value, also from copy to copy. The preview shows the values of the "
"next print."
msgstr "As variáveis são preenchidas ao imprimir. Cada etiqueta impressa recebe o valor seguinte do contador, também de cópia para cópia. A prévia mostra os valores da próxima impressão."

#: tavletta/ui/variables.py:77
msgid "More about variables"
msgstr "Mais sobre variáveis"

#: tavletta/ui/variables.py:113
msgid "Goes up with every printed label, by the step"
msgstr "Aumenta a cada etiqueta impressa, conforme o passo"

#: tavletta/ui/variables.py:119
msgid "Next number"
msgstr "Próximo número"

#: tavletta/ui/variables.py:122 tavletta/server/web/batch.js:628
msgid "Step"
msgstr "Passo"

#: tavletta/ui/window.py:176 tavletta/server/web/app.js:47
#: tavletta/server/web/app.js:296
msgid "Templates"
msgstr "Modelos"

#: tavletta/ui/window.py:208
msgid "Shipping label…"
msgstr "Etiqueta de envio…"

#: tavletta/ui/window.py:211
msgid "Data for serial labels…"
msgstr "Dados para etiquetas em série…"

#: tavletta/ui/window.py:212
msgid "Forget allowed data files"
msgstr "Esquecer arquivos de dados permitidos"

#: tavletta/ui/window.py:213
msgid "Export PNG…"
msgstr "Exportar como PNG…"

#: tavletta/ui/window.py:217
msgid "Report a problem…"
msgstr "Relatar um problema…"

#: tavletta/ui/window.py:218
msgid "About Tavletta"
msgstr "Sobre o Tavletta"

#: tavletta/ui/window.py:743
msgid "Unsaved label"
msgstr "Etiqueta não salva"

#: tavletta/ui/window.py:915
msgid "content scaled down to fit"
msgstr "conteúdo reduzido para caber"

#: tavletta/ui/window.py:919
#, python-format
msgid "Problem: %s"
msgstr "Problema: %s"

#: tavletta/ui/window.py:938
#, python-format
msgid "Too long for this printer: at most %s"
msgstr "Longa demais para esta impressora: no máximo %s"

#: tavletta/ui/window.py:942
#, python-format
msgid "Too wide for this printer: at most %s"
msgstr "Larga demais para esta impressora: no máximo %s"

#: tavletta/ui/window.py:1020
msgid "The browser cannot be opened"
msgstr "Não foi possível abrir o navegador"

#: tavletta/ui/window.py:1022
msgid "Copy link"
msgstr "Copiar link"

#: tavletta/ui/window.py:1094
msgid "Only local files can be dropped"
msgstr "Só é possível soltar arquivos locais"

#: tavletta/ui/window.py:1147
msgid "Please wait until printing has finished"
msgstr "Aguarde até a impressão terminar"

#: tavletta/server/config.py:79
#, python-format
msgid "%(file)s: %(key)s: %(problem)s"
msgstr "%(file)s: %(key)s: %(problem)s"

#: tavletta/server/config.py:89 tavletta/server/config.py:93
#: tavletta/server/config.py:99 tavletta/server/main.py:344
#, python-format
msgid "Cannot read %(file)s: %(reason)s"
msgstr "Não foi possível ler %(file)s: %(reason)s"

#: tavletta/server/config.py:109
msgid "expected a table"
msgstr "esperava-se uma tabela"

#: tavletta/server/config.py:119 tavletta/server/config.py:453
msgid "missing"
msgstr "ausente"

#: tavletta/server/config.py:122
msgid "expected text"
msgstr "esperava-se um texto"

#: tavletta/server/config.py:124
msgid "control characters are not allowed"
msgstr "caracteres de controle não são permitidos"

#: tavletta/server/config.py:130
msgid "expected true or false"
msgstr "esperava-se true ou false"

#: tavletta/server/config.py:141
#, python-format
msgid "expected a number from %(min)s to %(max)s"
msgstr "esperava-se um número de %(min)s a %(max)s"

#: tavletta/server/config.py:148
#, python-format
msgid "expected one of: %s"
msgstr "esperava-se um de: %s"

#: tavletta/server/config.py:153 tavletta/server/config.py:159
msgid "unknown key"
msgstr "chave desconhecida"

#: tavletta/server/config.py:162
msgid "nothing defined"
msgstr "nada definido"

#: tavletta/server/config.py:168
msgid "not a valid name: letters, digits, . _ - (up to 64)"
msgstr "nome inválido: letras, dígitos, . _ - (até 64)"

#: tavletta/server/config.py:209
msgid "only one printer can be the default"
msgstr "só uma impressora pode ser a padrão"

#: tavletta/server/config.py:223
msgid "not a valid printer address"
msgstr "endereço de impressora inválido"

#: tavletta/server/config.py:245
msgid "this printer model does not cut"
msgstr "este modelo de impressora não corta"

#: tavletta/server/config.py:247
msgid "this printer model has no colour settings"
msgstr "este modelo de impressora não tem ajustes de cor"

#: tavletta/server/config.py:408
msgid "expected a date such as 2027-12-31"
msgstr "esperava-se uma data como 2027-12-31"

#: tavletta/server/config.py:427
msgid "the same token twice"
msgstr "o mesmo token duas vezes"

#: tavletta/server/config.py:440
#, python-format
msgid "%s can be changed by every user of this computer: chmod 600 it"
msgstr "%s pode ser alterado por qualquer usuário deste computador: aplique chmod 600 a ele"

#: tavletta/server/config.py:450
msgid "not a token hash: expected sha256:… or scrypt:…"
msgstr "não é um hash de token: esperava-se sha256:… ou scrypt:…"

