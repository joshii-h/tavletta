Build zint-bindings with plain CMake, offline (Flatpak, distributions)

- no bundled vcpkg: it clones and bootstraps vcpkg from the network;
  fmt, pybind11, zlib and libpng come from the SDK and the manifest
- no type stubs: their generator pip-installs its tools at configure time
  (network); the stubs are type hints only, not needed at run time
- fmt::format is declared in fmt/format.h: fmt/core.h no longer
  includes it since fmt 11 (the SDK has fmt 12)

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,6 +1,5 @@
 cmake_minimum_required(VERSION 3.28...4.1)
 
-include(scripts/cmake/bundled-vcpkg.cmake)
 if(SKBUILD)
 	set(PROJECT_VERSION "${SKBUILD_PROJECT_VERSION}")
 else()
@@ -72,37 +71,5 @@
 add_dependencies(${extension} _generate_enums)
 
 
-# scripts/generate-stub.py ---------------------------------------------------------------------------------------------
