msgstr "Tất cả các hàng"

#: tavletta/server/web/batch.js:552
msgid "Some rows"
msgstr "Một số hàng"

#: tavletta/server/web/batch.js:553
msgid "Ranges of a field"
msgstr "Các khoảng của một trường"

#: tavletta/server/web/batch.js:559
msgid "Which rows?"
msgstr "Những hàng nào?"

#: tavletta/server/web/batch.js:594
msgid ""
"Several fields: their values are put together row by row (the first with the "
"first), never every combination."
msgstr "Nhiều trường: giá trị của chúng được ghép theo từng hàng (giá trị đầu với giá trị đầu), không bao giờ ghép mọi tổ hợp."

#: tavletta/server/web/batch.js:595
msgid ""
"Several fields: a row is printed if its values lie in the ranges of all of "
"them."
msgstr "Nhiều trường: một hàng được in nếu các giá trị của nó nằm trong khoảng của tất cả các trường."

#: tavletta/server/web/batch.js:626
msgid "From"
msgstr "Từ"

#: tavletta/server/web/batch.js:626
msgid "For example 3000, 00300 or INV-0001; or the whole range, 3000-5685"
msgstr "Ví dụ 3000, 00300 hoặc INV-0001; hoặc cả khoảng, 3000-5685"

#: tavletta/server/web/batch.js:627
msgid "To"
msgstr "Đến"

#: tavletta/server/web/batch.js:633
msgid "Remove range"
msgstr "Gỡ bỏ khoảng"

#: tavletta/server/web/batch.js:655
msgid "Add a range"
msgstr "Thêm khoảng"

#: tavletta/server/web/batch.js:663
msgid "Or the same value for all"
msgstr "Hoặc cùng một giá trị cho tất cả"

#: tavletta/server/web/batch.js:663
msgid "Used if no range is given for this field."
msgstr "Được dùng nếu trường này không có khoảng nào."

#: tavletta/server/web/batch.js:676 tavletta/server/web/batch.js:695
msgid "Rows"
msgstr "Hàng"

#: tavletta/server/web/batch.js:676
msgid "For example 1-20, 25, 30-"
msgstr "Ví dụ 1-20, 25, 30-"

#: tavletta/server/web/batch.js:699
msgid "Rows {first} to {last} of {total}"
msgstr "Hàng {first} đến {last} trên {total}"

#: tavletta/server/web/batch.js:735
msgid "Page {page} of {pages}"
msgstr "Trang {page} trên {pages}"

#: tavletta/server/web/batch.js:741
msgid "Previous page"
msgstr "Trang trước"

#: tavletta/server/web/batch.js:742
msgid "Next page"
msgstr "Trang sau"

#: tavletta/server/web/batch.js:756
msgid "Write the rows as numbers and ranges, such as 1-20, 25."
msgstr "Hãy viết các hàng dưới dạng số và khoảng, ví dụ 1-20, 25."

#: tavletta/server/web/batch.js:818
msgid "The same for all labels"
msgstr "Giống nhau cho tất cả các nhãn"

#: tavletta/server/web/batch.js:835 tavletta/server/web/print.js:203
msgid "Printing needs a token with the role Print or Admin."
msgstr "Để in cần một mã có vai trò “In” hoặc “Quản trị”."

#: tavletta/server/web/batch.js:837 tavletta/server/web/print.js:222
msgid "Copies must be a whole number from 1."
msgstr "Số bản phải là số nguyên từ 1 trở lên."

#: tavletta/server/web/batch.js:838 tavletta/server/web/print.js:223
msgid "At most {max} copies on this printer."
msgstr "Tối đa {max} bản trên máy in này."

#: tavletta/server/web/batch.js:839
msgid "At most {max} rows in one print job."
msgstr "Tối đa {max} hàng trong một lệnh in."

#: tavletta/server/web/batch.js:840
msgid ""
"At most {max} labels in one print job. Choose fewer rows, or print them in "
"several jobs."
msgstr "Tối đa {max} nhãn trong một lệnh in. Hãy chọn ít hàng hơn, hoặc in chúng trong nhiều lệnh."

#: tavletta/server/web/batch.js:841 tavletta/server/web/print.js:204
msgid "Confirm above that it should print on the labels loaded."
msgstr "Hãy xác nhận ở trên rằng sẽ in lên các nhãn đang lắp."

#: tavletta/server/web/batch.js:848
msgid "At most {max} labels in one print job; {left} more could be added."
msgstr "Tối đa {max} nhãn trong một lệnh in; có thể thêm {left} nhãn nữa."

#: tavletta/server/web/batch.js:849 tavletta/server/web/batch.js:911
#: tavletta/server/web/print.js:244
msgid "Print {count} labels"
msgstr "In {count} nhãn"

#: tavletta/server/web/batch.js:871
msgid "First: {value}"
msgstr "Đầu tiên: {value}"

#: tavletta/server/web/batch.js:872
msgid "Last: {value}"
msgstr "Cuối cùng: {value}"

#: tavletta/server/web/batch.js:875 tavletta/server/web/batch.js:876
msgid "Preview of the label {value}"
msgstr "Bản xem trước của nhãn {value}"

#: tavletta/server/web/batch.js:905 tavletta/server/web/print.js:242
msgid "Print {count} labels?"
msgstr "In {count} nhãn?"

#: tavletta/server/web/batch.js:919
msgid "Too much data for one print job ({size} MB). Choose fewer rows."
msgstr "Quá nhiều dữ liệu cho một lệnh in ({size} MB). Hãy chọn ít hàng hơn."

#: tavletta/server/web/batch.js:971
msgid "First printed: {first}, last printed in full: {last}"
msgstr "In đầu tiên: {first}, in trọn vẹn cuối cùng: {last}"

#: tavletta/server/web/batch.js:971
msgid "(not all numbers in between)"
msgstr "(không phải mọi số ở giữa)"

#: tavletta/server/web/batch.js:982
msgid "Continue from {value}"
msgstr "Tiếp tục từ {value}"

#: tavletta/server/web/batch.js:984
msgid "A label of a row that was printed in part is printed again in full."
msgstr "Nhãn của một hàng chỉ in được một phần sẽ được in lại trọn vẹn."

#: tavletta/server/web/batch.js:992
msgid "New series"
msgstr "Hàng loạt mới"

#: tavletta/server/web/print.js:38
msgid "Back to the templates"
msgstr "Quay lại các mẫu"

#: tavletta/server/web/print.js:47
