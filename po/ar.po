msgstr "لا يوجد عمود بيانات لـ {name}. اختر عمودًا، أو القيمة نفسها للجميع."

#: tavletta/server/web/batch.js:476
msgid "Continuing: {count} rows left."
msgstr "المتابعة: الصفوف المتبقية: {count}."

#: tavletta/server/web/batch.js:480
msgid "Choose again"
msgstr "الاختيار مجددًا"

#: tavletta/server/web/batch.js:486 tavletta/server/web/batch.js:612
msgid "All rows"
msgstr "كل الصفوف"

#: tavletta/server/web/batch.js:487
msgid "Some rows"
msgstr "بعض الصفوف"

#: tavletta/server/web/batch.js:488
msgid "Ranges of a field"
msgstr "نطاقات حقل"

#: tavletta/server/web/batch.js:494
msgid "Which rows?"
msgstr "أي صفوف؟"

#: tavletta/server/web/batch.js:529
msgid ""
"Several fields: their values are put together row by row (the first with the "
"first), never every combination."
msgstr "عدة حقول: تُجمع قيمها صفًا بصف (الأولى مع الأولى)، وليس كل التوافيق."

#: tavletta/server/web/batch.js:530
msgid ""
"Several fields: a row is printed if its values lie in the ranges of all of "
"them."
msgstr "عدة حقول: يُطبع الصف إذا كانت قيمه ضمن نطاقات الحقول كلها."

#: tavletta/server/web/batch.js:561
msgid "From"
msgstr "من"

#: tavletta/server/web/batch.js:561
msgid "For example 3000, 00300 or INV-0001; or the whole range, 3000-5685"
msgstr "مثلًا 3000 أو 00300 أو INV-0001؛ أو النطاق كاملًا، 3000-5685"

#: tavletta/server/web/batch.js:562
msgid "To"
msgstr "إلى"

#: tavletta/server/web/batch.js:568
msgid "Remove range"
msgstr "إزالة النطاق"

#: tavletta/server/web/batch.js:590
msgid "Add a range"
msgstr "إضافة نطاق"

#: tavletta/server/web/batch.js:598
msgid "Or the same value for all"
msgstr "أو القيمة نفسها للجميع"

#: tavletta/server/web/batch.js:598
msgid "Used if no range is given for this field."
msgstr "تُستخدم إذا لم يُحدَّد نطاق لهذا الحقل."

#: tavletta/server/web/batch.js:611 tavletta/server/web/batch.js:630
msgid "Rows"
msgstr "الصفوف"

#: tavletta/server/web/batch.js:611
msgid "For example 1-20, 25, 30-"
msgstr "مثلًا 1-20, 25, 30-"

#: tavletta/server/web/batch.js:634
msgid "Rows {first} to {last} of {total}"
msgstr "الصفوف {first} إلى {last} من {total}"

#: tavletta/server/web/batch.js:670
msgid "Page {page} of {pages}"
msgstr "الصفحة {page} من {pages}"

#: tavletta/server/web/batch.js:676
msgid "Previous page"
msgstr "الصفحة السابقة"

#: tavletta/server/web/batch.js:677
msgid "Next page"
msgstr "الصفحة التالية"

#: tavletta/server/web/batch.js:691
msgid "Write the rows as numbers and ranges, such as 1-20, 25."
msgstr "اكتب الصفوف كأرقام ونطاقات، مثل 1-20, 25."

#: tavletta/server/web/batch.js:753
msgid "The same for all labels"
msgstr "نفسها لكل الملصقات"

#: tavletta/server/web/batch.js:770 tavletta/server/web/print.js:203
msgid "Printing needs a token with the role Print or Admin."
msgstr "تحتاج الطباعة إلى رمز بدور «طباعة» أو «المسؤول»."

#: tavletta/server/web/batch.js:772 tavletta/server/web/print.js:222
msgid "Copies must be a whole number from 1."
msgstr "يجب أن يكون عدد النسخ عددًا صحيحًا من 1 فأكثر."

#: tavletta/server/web/batch.js:773 tavletta/server/web/print.js:223
msgid "At most {max} copies on this printer."
msgstr "{max} نسخة على الأكثر على هذه الطابعة."

#: tavletta/server/web/batch.js:774
msgid "At most {max} rows in one print job."
msgstr "{max} صف على الأكثر في مهمة طباعة واحدة."

#: tavletta/server/web/batch.js:775
msgid ""
"At most {max} labels in one print job. Choose fewer rows, or print them in "
"several jobs."
msgstr "{max} ملصق على الأكثر في مهمة طباعة واحدة. اختر صفوفًا أقل، أو اطبعها في عدة مهام."

#: tavletta/server/web/batch.js:776 tavletta/server/web/print.js:204
msgid "Confirm above that it should print on the labels loaded."
msgstr "أكّد أعلاه أن الطباعة تتم على الملصقات الموضوعة."

#: tavletta/server/web/batch.js:783
msgid "At most {max} labels in one print job; {left} more could be added."
msgstr "{max} ملصق على الأكثر في مهمة طباعة واحدة؛ يمكن إضافة {left} أخرى."

#: tavletta/server/web/batch.js:784 tavletta/server/web/batch.js:846
#: tavletta/server/web/print.js:244
msgid "Print {count} labels"
msgstr "طباعة الملصقات ({count})"

#: tavletta/server/web/batch.js:806
msgid "First: {value}"
msgstr "الأول: {value}"

#: tavletta/server/web/batch.js:807
msgid "Last: {value}"
msgstr "الأخير: {value}"

#: tavletta/server/web/batch.js:810 tavletta/server/web/batch.js:811
msgid "Preview of the label {value}"
msgstr "معاينة الملصق {value}"

#: tavletta/server/web/batch.js:840 tavletta/server/web/print.js:242
msgid "Print {count} labels?"
msgstr "هل تريد طباعة الملصقات ({count})؟"

#: tavletta/server/web/batch.js:854
msgid "Too much data for one print job ({size} MB). Choose fewer rows."
msgstr "البيانات كثيرة جدًا لمهمة طباعة واحدة ({size} MB). اختر صفوفًا أقل."

#: tavletta/server/web/batch.js:905
msgid "First printed: {first}, last printed in full: {last}"
msgstr "أول ما طُبع: {first}، آخر ما طُبع كاملًا: {last}"

#: tavletta/server/web/batch.js:916
msgid "Continue from {value}"
msgstr "المتابعة من {value}"

#: tavletta/server/web/batch.js:918
msgid "A label of a row that was printed in part is printed again in full."
msgstr "يُطبع ملصق الصف الذي طُبع جزئيًا مرة أخرى كاملًا."

#: tavletta/server/web/batch.js:926
msgid "New series"
msgstr "سلسلة جديدة"

#: tavletta/server/web/print.js:38
msgid "Back to the templates"
msgstr "العودة إلى القوالب"

#: tavletta/server/web/print.js:47
msgid "Printer: {model}, at the address set on the server"
msgstr "الطابعة: {model}، على العنوان المعيَّن في الخادم"

#: tavletta/server/web/print.js:80
msgid "No printer chosen."
msgstr "لم تُختر طابعة."

#: tavletta/server/web/print.js:81
msgid ""
"The printer is unreachable. Check that it is on and connected, then reload "
"the page."
msgstr "تعذّر الوصول إلى الطابعة. تحقّق من أنها تعمل ومتصلة، ثم أعد تحميل الصفحة."

#: tavletta/server/web/print.js:90
msgid "Data field {placeholder}"
msgstr "حقل البيانات {placeholder}"

#: tavletta/server/web/print.js:93
msgid "Variable {placeholder}"
msgstr "المتغير {placeholder}"

#: tavletta/server/web/print.js:98
msgid "Text of the element; changed here for this print only"
msgstr "نص العنصر؛ يُغيَّر هنا لهذه الطباعة فقط"

#: tavletta/server/web/print.js:105
msgid "Print {name}"
msgstr "طباعة {name}"

#: tavletta/server/web/print.js:145
msgid "Start number"
msgstr "رقم البداية"

#: tavletta/server/web/print.js:145
msgid ""
"The counter {placeholder} starts here; next number saved in the template: "
"{next}"
msgstr "يبدأ العدّاد {placeholder} من هنا؛ الرقم التالي المحفوظ في القالب: {next}"

#: tavletta/server/web/print.js:150
msgid "At most {max}"
msgstr "{max} على الأكثر"

#: tavletta/server/web/print.js:160
msgid "Fields"
msgstr "الحقول"

#: tavletta/server/web/print.js:160
msgid "This template has no fields to fill in."
msgstr "لا يحتوي هذا القالب على حقول لتعبئتها."

#: tavletta/server/web/print.js:216
msgid "{name} is empty. Enter a value."
msgstr "{name} فارغ. أدخل قيمة."

#: tavletta/server/web/print.js:219
msgid "The start number must be a whole number from 0."
msgstr "يجب أن يكون رقم البداية عددًا صحيحًا من 0 فأكثر."

#: tavletta/server/web/print.js:224
msgid "At most {max} labels in one print job."
msgstr "{max} ملصق على الأكثر في مهمة طباعة واحدة."

