#!/bin/sh
# The installed command, without a display: its version, and a label with a
# QR code and one with a Data Matrix code (Zint) rendered to PNG.
set -eu
cd "$AUTOPKGTEST_TMP"
tavletta --version
cp "$OLDPWD/docs/examples/party.tavletta" qr.tavletta
sed 's/"symbology": *"qr"/"symbology": "datamatrix"/' qr.tavletta > datamatrix.tavletta
for label in qr datamatrix; do
  tavletta print "$label.tavletta" --dry-run --no-query --no-save-counter --output "$label.png"
  test -s "$label.png"
done
