#: tavletta/app.py:150 tavletta/ui/styles.py:183
msgid "Box and frame"
msgstr "Caixa e moldura"

#: tavletta/app.py:224 tavletta/cli.py:186
msgid "Design and print labels"
msgstr "Crie e imprima etiquetas"

#: tavletta/app.py:227
msgid ""
"Tavletta is Romansh for a small tablet (from tavla, table/board). Pronounced "
"tav-LET-ta."
msgstr "Tavletta significa “tabuinha” em romanche (de tavla, tábua). Pronuncia-se tav-LET-ta."

#. translators: replace with your name to be credited in the About dialog
#: tavletta/app.py:233
msgid "translator-credits"
msgstr "Tavletta contributors"

#: tavletta/app.py:241
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Ideias para as variáveis (contador, data, UUID), sem código"

#: tavletta/app.py:244
msgid "Protocol knowledge"
msgstr "Conhecimento de protocolos"

#: tavletta/app.py:249
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "De %(projects)s e dos manuais dos fabricantes, reescrito sem o código deles; veja THIRD_PARTY_NOTICES.md"

#: tavletta/cli.py:110
#, python-format
msgid "%(name)s is filled from the data rows ({%(name)s}) and cannot be set"
msgstr "%(name)s é preenchido a partir das linhas de dados ({%(name)s}) e não pode ser definido"

#: tavletta/cli.py:112
#, python-format
msgid "%(name)s is a data column ({%(name)s}) – give a data file with --data"
msgstr "%(name)s é uma coluna de dados ({%(name)s}) – informe um arquivo de dados com --data"

#: tavletta/cli.py:130
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "esperado NAME=VALUE: %s"

#: tavletta/cli.py:146
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "esperado um número inteiro de %(min)d a %(max)d: %(value)s"

#: tavletta/cli.py:180
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "esperavam-se linhas como 3-10, 5 ou 7-: %s"

#: tavletta/cli.py:187
msgid "Without a command the application starts; label files given open in it."
msgstr "Sem comando, o aplicativo é iniciado; os arquivos de etiqueta indicados são abertos nele."

#: tavletta/cli.py:193
msgid "print a label file without opening a window"
msgstr "imprime um arquivo de etiqueta sem abrir uma janela"

#: tavletta/cli.py:194
msgid "Print a label file without opening a window."
msgstr "Imprime um arquivo de etiqueta sem abrir uma janela."

#: tavletta/cli.py:196
msgid "the label (.tavletta)"
msgstr "a etiqueta (.tavletta)"

#: tavletta/cli.py:199
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "modelo de impressora, por padrão o da etiqueta: %s"

#: tavletta/cli.py:202
msgid "printer address, by default the one set in the app"
msgstr "endereço da impressora, por padrão o definido no aplicativo"

#: tavletta/cli.py:205
msgid "number of copies"
msgstr "número de cópias"

#: tavletta/cli.py:215
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "texto do elemento NAME, ou valor da variável {=NAME}; as variáveis em um texto são preenchidas; repetível"

#: tavletta/cli.py:225
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "como --set, mas o valor é usado como está: as chaves não são variáveis"

#: tavletta/cli.py:231
msgid "counter of the first label, instead of the one saved in the label"
msgstr "contador da primeira etiqueta, em vez do salvo na etiqueta"

#: tavletta/cli.py:237
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "imprimir com os padrões do modelo de impressora em vez do corte, cores, qualidade, extras (impressão em cadeia, alta resolução, avanço da fita), configurações da impressora e contornos das folhas de etiquetas escolhidos por último no aplicativo; o endereço e a margem de segurança permanecem"

#: tavletta/cli.py:246
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, with --printer-defaults the "
"one set on the printer"
msgstr "método de impressão de uma impressora térmica que tenha essa configuração: printer (conforme configurado na impressora), transfer (com fita) ou direct (térmica direta, sem fita); por padrão o escolhido no aplicativo; com --printer-defaults, o configurado na impressora"

#: tavletta/cli.py:255
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "não consultar a impressora antes de renderizar (modelo, fita e resolução)"

#: tavletta/cli.py:261
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "não salvar o próximo valor do contador na etiqueta (um arquivo somente leitura); a próxima impressão começa no mesmo número"

#: tavletta/cli.py:270
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "etiquetas em série: uma etiqueta para cada linha deste arquivo CSV, ODS ou XLSX; por padrão o arquivo de dados da etiqueta"

#: tavletta/cli.py:275
msgid "the sheet of the data file, by default the first"
msgstr "a planilha do arquivo de dados, por padrão a primeira"

#: tavletta/cli.py:281
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "somente estas linhas do arquivo de dados, por ex. 3-10, 5 ou 7- (contadas a partir de 1)"

#: tavletta/cli.py:284
msgid "check and render only, do not print"
msgstr "apenas verificar e gerar, não imprimir"

#: tavletta/cli.py:290
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "com --dry-run: salva cada etiqueta em PNG como a janela a exporta, no máximo 600 dpi (- para stdout: só a primeira)"

#: tavletta/cli.py:296
msgid "list the printers found on the network"
msgstr "lista as impressoras encontradas na rede"

#: tavletta/cli.py:297
msgid "List the printers found on the network: model, address, name."
msgstr "Lista as impressoras encontradas na rede: modelo, endereço, nome."

#: tavletta/cli.py:299
#, python-format
msgid "only this printer model: %s"
msgstr "apenas este modelo de impressora: %s"

#: tavletta/cli.py:311
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "esperava-se um endereço ou rede como 172.16.0.0/12: %s"

#: tavletta/cli.py:321
msgid "the folder with the label files the server may use"
msgstr "a pasta com os arquivos de etiqueta que o servidor pode usar"

#: tavletta/cli.py:328
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "imprimir somente neste endereço de impressora (* corresponde a qualquer coisa); repetível"

#: tavletta/cli.py:334
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: as impressoras que os clientes podem usar, por nome"

#: tavletta/cli.py:341
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "máximo de etiquetas em um trabalho de impressão, cópias vezes linhas (padrão 10000)"

#: tavletta/cli.py:346
msgid "search the network for printers (off by default)"
msgstr "procurar impressoras na rede (desativado por padrão)"

#: tavletta/cli.py:352
msgid ""
"allow document pages (PDF, images) in labels sent with the request; PDFs are "
"then drawn in a separate process with limits (off by default)"
msgstr "permitir páginas de documento (PDF, imagens) nas etiquetas enviadas com a solicitação; os PDFs são então desenhados em um processo separado com limites (desativado por padrão)"

#: tavletta/cli.py:361
msgid "run a print server with a REST API"
msgstr "executar um servidor de impressão com uma REST API"

#: tavletta/cli.py:362
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Executa um servidor de impressão: uma REST API e, com --mcp, MCP para clientes de IA."

#: tavletta/cli.py:365
msgid "address to listen on (default 127.0.0.1)"
msgstr "endereço em que escutar (padrão 127.0.0.1)"

#: tavletta/cli.py:371
#, python-format
msgid "port to listen on (default %d)"
msgstr "porta em que escutar (padrão %d)"

#: tavletta/cli.py:377
msgid ""
"file with the access token; else the environment variable TAVLETTA_TOKEN"
msgstr "arquivo com o token de acesso; caso contrário, a variável de ambiente TAVLETTA_TOKEN"

#: tavletta/cli.py:383
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: tokens de acesso nomeados com funções"

#: tavletta/cli.py:385
msgid "also serve MCP at /mcp"
msgstr "também disponibilizar MCP em /mcp"

#: tavletta/cli.py:389
msgid "do not serve the web page at /: only the REST API (and MCP)"
msgstr "não disponibilizar a página web em /: somente a REST API (e MCP)"

#: tavletta/cli.py:396
msgid "largest request body in MB (default 4)"
msgstr "tamanho máximo do corpo da solicitação em MB (padrão 4)"

#: tavletta/cli.py:405
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "um proxy reverso cujo cabeçalho X-Forwarded-For indica o cliente, p. ex. 172.16.0.0/12; repetível"

#: tavletta/cli.py:414
msgid "allow requests from web pages of this origin; repeatable"
msgstr "permitir solicitações de páginas web desta origem; repetível"

#: tavletta/cli.py:419
msgid "serve MCP on standard input and output"
msgstr "disponibilizar MCP na entrada e saída padrão"

#: tavletta/cli.py:421
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "Disponibiliza MCP na entrada e saída padrão, para clientes de IA como o Claude Desktop."

#: tavletta/cli.py:431
msgid "manage the access tokens of the print server"
msgstr "gerenciar os tokens de acesso do servidor de impressão"

#: tavletta/cli.py:432
msgid "Manage the access tokens of the print server."
msgstr "Gerencia os tokens de acesso do servidor de impressão."

#: tavletta/cli.py:437
msgid "make a token and add its hash to tokens.toml"
msgstr "criar um token e adicionar o hash dele ao tokens.toml"

#: tavletta/cli.py:438
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Cria um token, adiciona o hash dele ao tokens.toml e mostra o token uma única vez."

#: tavletta/cli.py:440
msgid "name of the token, e.g. the device"
msgstr "nome do token, por ex. o dispositivo"

#: tavletta/cli.py:445
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: só visualizar; print: também imprimir; admin: também todos os trabalhos de impressão"

#: tavletta/cli.py:447
msgid "tokens.toml to add it to"
msgstr "tokens.toml ao qual adicioná-lo"

#: tavletta/cli.py:453
msgid "only this printer of printers.toml; repeatable"
msgstr "somente esta impressora do printers.toml; repetível"

#: tavletta/cli.py:456
msgid "printers.toml, to check --printer"
msgstr "printers.toml, para verificar --printer"

#: tavletta/cli.py:458
msgid "valid until, e.g. 2027-12-31"
msgstr "válido até, por ex. 2027-12-31"

#: tavletta/cli.py:459
msgid "a note for people"
msgstr "uma observação para pessoas"

#: tavletta/cli.py:461
msgid "store the hash with scrypt instead of SHA-256"
msgstr "armazenar o hash com scrypt em vez de SHA-256"

#: tavletta/cli.py:467
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "ler da entrada padrão um token escolhido por você (armazenado com scrypt) em vez de criar um"

#: tavletta/cli.py:487 tavletta/server/config.py:220
#: tavletta/server/service.py:612
#, python-format
msgid "Unknown printer model: %s"
msgstr "Modelo de impressora desconhecido: %s"

#: tavletta/cli.py:494 tavletta/ui/files.py:84 tavletta/ui/files.py:137
#: tavletta/ui/texts.py:347 tavletta/ui/texts.py:729
#: tavletta/server/service.py:903
#, python-format
msgid "Cannot open %s"
msgstr "Não foi possível abrir %s"

#: tavletta/cli.py:516 tavletta/server/main.py:262
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s não é uma data, esperado p. ex. 2026-12-31 ou 2026-12-31T08:30"

#: tavletta/cli.py:564
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} é preenchido ao imprimir e não pode ser definido"

#: tavletta/cli.py:570
#, python-format
msgid "The label has no element or variable named %s"
msgstr "A etiqueta não tem nenhum elemento ou variável com o nome %s"

#: tavletta/cli.py:599 tavletta/ui/printing.py:123
#: tavletta/server/service.py:1288
msgid "The label is empty"
msgstr "A etiqueta está vazia"

#: tavletta/cli.py:636
msgid "Cannot write the output"
msgstr "Não é possível gravar a saída"

#: tavletta/cli.py:667
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output grava imagens PNG: informe um nome terminado em .png"

#: tavletta/cli.py:692 tavletta/cli.py:901 tavletta/ui/printing.py:582
#: tavletta/ui/printing.py:746 tavletta/server/service.py:1147
#: tavletta/server/service.py:1170 tavletta/server/service.py:1472
#: tavletta/server/service.py:1708
msgid "The label cannot be prepared for printing."
msgstr "Não foi possível preparar a etiqueta para impressão."

#: tavletta/cli.py:779
msgid "No printer found – give its address with --host"
msgstr "Nenhuma impressora encontrada – informe o endereço com --host"

#: tavletta/cli.py:781
msgid ""
"Several printers found – choose one with --host (tavletta list-printers)"
msgstr "Várias impressoras encontradas – escolha uma com --host (tavletta list-printers)"

#: tavletta/cli.py:792 tavletta/ui/texts.py:772 tavletta/server/service.py:1698
#, python-format
msgid "Cannot save %s"
msgstr "Não foi possível salvar %s"

#: tavletta/cli.py:794 tavletta/server/service.py:1701
msgid "the labels were printed, but the next counter value was not saved"
msgstr "as etiquetas foram impressas, mas o próximo valor do contador não foi salvo"

#: tavletta/cli.py:809 tavletta/server/service.py:1317
msgid "nothing was printed: the next counter value could not be saved"
msgstr "nada foi impresso: o próximo valor do contador não poderia ser salvo"

#: tavletta/cli.py:869 tavletta/cli.py:896 tavletta/cli.py:1260
msgid "Interrupted"
msgstr "Interrompido"

#: tavletta/cli.py:952 tavletta/ui/printing.py:488
#: tavletta/server/service.py:1193
#, python-format
msgid "At most %d labels in one print job"
msgstr "No máximo %d etiquetas em um trabalho de impressão"

#: tavletta/cli.py:971
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method: este modelo de impressora não tem configuração de método de impressão: %s"

#: tavletta/cli.py:1013
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet e --rows exigem um arquivo de dados (--data)"

#: tavletta/cli.py:1022 tavletta/ui/printing.py:615
#: tavletta/server/service.py:1005
msgid "No rows to print"
msgstr "Nenhuma linha para imprimir"

#: tavletta/cli.py:1032
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "A etiqueta usa um arquivo de dados fora da sua pasta: informe-o com --data"

#: tavletta/cli.py:1059 tavletta/ui/window.py:922
#: tavletta/server/service.py:1064
#, python-format
msgid "No such column: %s"
msgstr "Coluna inexistente: %s"

#: tavletta/cli.py:1064 tavletta/ui/printing.py:695
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "O código de barras ou o código QR destas linhas não pode ser criado a partir dos valores delas, por exemplo um EAN-13 com letras ou uma célula vazia. Corrija o arquivo de dados e leia-o novamente, ou imprima sem estas linhas."

#: tavletta/cli.py:1069 tavletta/ui/printing.py:700
#, python-format
msgid "Rows: %s"
msgstr "Linhas: %s"

#: tavletta/cli.py:1077
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Aguardando o fim de outra impressão de %s…"

#: tavletta/cli.py:1084 tavletta/server/service.py:791
#: tavletta/server/service.py:1466
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s ainda está bloqueado por outra impressão – tente mais tarde"

#: tavletta/cli.py:1090
msgid "--output needs --dry-run"
msgstr "--output requer --dry-run"

#: tavletta/cli.py:1107
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "O próximo valor do contador não é salvo: a próxima impressão repetirá os números"

#: tavletta/cli.py:1203
msgid "Waiting for the printer's answer…"
msgstr "Aguardando a resposta da impressora…"

#: tavletta/cli.py:1231 tavletta/ui/printer.py:343
msgid "No printer found"
msgstr "Nenhuma impressora encontrada"

#: tavletta/ui/data.py:91
msgid "Tables (CSV, ODS, XLSX)"
msgstr "Tabelas (CSV, ODS, XLSX)"

#: tavletta/ui/data.py:98
msgid "Choose data file"
msgstr "Escolher arquivo de dados"

#: tavletta/ui/data.py:108 tavletta/ui/files.py:104 tavletta/ui/files.py:126
#: tavletta/ui/files.py:207 tavletta/ui/texts.py:220
msgid "Only local files can be used"
msgstr "Só é possível usar arquivos locais"

#: tavletta/ui/data.py:167
msgid "Tavletta asks again before reading data files outside a label's folder"
msgstr "O Tavletta vai perguntar de novo antes de ler arquivos de dados fora da pasta de uma etiqueta"

#: tavletta/ui/data.py:179
msgid "Read the data file?"
msgstr "Ler o arquivo de dados?"

#: tavletta/ui/data.py:181
#, python-format
msgid ""
"This label uses a data file outside its folder:\n"
"\n"
"%s\n"
"\n"
"Read it only if you know where the label comes from."
msgstr "Esta etiqueta usa um arquivo de dados fora da sua pasta:\n\n%s\n\nLeia-o somente se você souber de onde vem a etiqueta."

#: tavletta/ui/data.py:186
msgid "Not now"
msgstr "Agora não"

#: tavletta/ui/data.py:187
msgid "Read data file"
msgstr "Ler arquivo de dados"

#: tavletta/ui/data.py:265
msgid "Reading…"
msgstr "Lendo…"

#: tavletta/ui/data.py:267
msgid "Not read: outside the label's folder"
msgstr "Não lido: fora da pasta da etiqueta"

#: tavletta/ui/data.py:270
#, python-format
msgid "Rows: %(rows)d · Columns: %(columns)d"
msgstr "Linhas: %(rows)d · Colunas: %(columns)d"

#: tavletta/ui/data.py:281 tavletta/ui/shortcuts.py:90
msgid "Serial labels"
msgstr "Etiquetas em série"

#: tavletta/ui/data.py:283
msgid ""
"One label for each row of a table. Insert columns into texts and codes; each "
"label shows the values of its row."
msgstr "Uma etiqueta para cada linha de uma tabela. Insira colunas nos textos e códigos; cada etiqueta mostra os valores da sua linha."

#: tavletta/ui/data.py:290
msgid "No data file"
msgstr "Nenhum arquivo de dados"

#: tavletta/ui/data.py:290
msgid "CSV, ODS or XLSX"
msgstr "CSV, ODS ou XLSX"

#: tavletta/ui/data.py:291 tavletta/ui/elements.py:355
#: tavletta/ui/elements.py:373 tavletta/ui/elements.py:386
msgid "Choose…"
msgstr "Escolher…"

#: tavletta/ui/data.py:304
msgid "Columns"
msgstr "Colunas"

#: tavletta/ui/data.py:320
msgid "Read again"
msgstr "Ler novamente"

#: tavletta/ui/data.py:324
msgid "Choose another file"
msgstr "Escolher outro arquivo"

#: tavletta/ui/data.py:326
msgid "Remove data file"
msgstr "Remover arquivo de dados"

#: tavletta/ui/data.py:337 tavletta/server/web/batch.js:404
msgid "Sheet"
msgstr "Planilha"

#: tavletta/ui/data.py:357
msgid "Insert column"
msgstr "Inserir coluna"

#: tavletta/ui/editor.py:738
#, python-format
msgid "Elements removed: %d"
msgstr "Elementos removidos: %d"

#: tavletta/ui/editor.py:738 tavletta/ui/shortcuts.py:53
#: tavletta/ui/window.py:187 tavletta/ui/window.py:987
msgid "Undo"
msgstr "Desfazer"

#: tavletta/ui/editor.py:819
msgid "Elements can be moved in the free layout"
msgstr "Os elementos se movem na disposição livre"

#: tavletta/ui/editor.py:820
msgid "Use free layout"
msgstr "Usar a disposição livre"

#: tavletta/ui/editor.py:830
msgid "No element selected"
msgstr "Nenhum elemento selecionado"

#: tavletta/ui/editor.py:832
#, python-format
msgid "Elements selected: %(n)d of %(total)d"
msgstr "Elementos selecionados: %(n)d de %(total)d"

#: tavletta/ui/editor.py:838
#, python-format
msgid "Element %(n)d of %(total)d: %(name)s"
msgstr "Elemento %(n)d de %(total)d: %(name)s"

#: tavletta/ui/editor.py:883
msgid "Arrange"
msgstr "Organizar"

#: tavletta/ui/editor.py:884
msgid "Align, distribute and snap the selected elements"
msgstr "Alinhar, distribuir e encaixar os elementos selecionados"

#: tavletta/ui/editor.py:900 tavletta/ui/image_crop.py:82
#: tavletta/ui/texts.py:120
msgid "Left"
msgstr "Esquerda"

#: tavletta/ui/editor.py:901 tavletta/ui/texts.py:76 tavletta/ui/texts.py:120
msgid "Centre"
msgstr "Centro"

#: tavletta/ui/editor.py:902 tavletta/ui/texts.py:120
