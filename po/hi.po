#: tavletta/ui/texts.py:243
#, python-format
msgid "%(name)s is too large to put on a label: at most %(size)d MB."
msgstr "%(name)s लेबल पर रखने के लिए बहुत बड़ी है: अधिकतम %(size)d MB."

#. translators: %(formats)s is a list of file formats: PNG, JPEG, …
#: tavletta/ui/texts.py:251
#, python-format
msgid ""
"%(name)s is not an image Tavletta can use. Images in %(formats)s can be used."
msgstr "%(name)s ऐसी छवि नहीं है जिसे Tavletta उपयोग कर सके। %(formats)s में छवियाँ उपयोग की जा सकती हैं।"

#: tavletta/ui/texts.py:259
#, python-format
msgid "%(name)s is not a label, an image or a data file"
msgstr "%(name)s न लेबल है, न छवि, न डेटा फ़ाइल"

#. translators: the print density a NIIMBOT model uses by default
#: tavletta/ui/texts.py:277
msgctxt "print density"
msgid "Default"
msgstr "डिफ़ॉल्ट"

#: tavletta/ui/texts.py:281
#, python-format
msgid "%d %%"
msgstr "%d%%"

#. translators: print speed in inches per second, as label printers state it
#: tavletta/ui/texts.py:284
#, python-format
msgid "%d in/s"
msgstr "%d इंच/से"

#: tavletta/ui/texts.py:293 tavletta/server/web/ui.js:66
msgid "Image"
msgstr "छवि"

#: tavletta/ui/texts.py:328
#, python-format
msgid "Endless, %(width)s wide"
msgstr "निरंतर, %(width)s चौड़ा"

#: tavletta/ui/texts.py:338
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "जाँचें कि पूरा लेबल चयन के अंदर है। चयन या उसके किनारों को खिसकाने के लिए खींचें, या नया बनाएँ।"

#: tavletta/ui/texts.py:342
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "कई क्षेत्र लेबल हो सकते हैं। चयन जाँचें या अगला आज़माएँ।"

#: tavletta/ui/texts.py:344
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "पृष्ठ पर छपा सब कुछ चुना गया है। लेबल चुनने के लिए खींचें।"

#: tavletta/ui/texts.py:345
msgid "Nothing is printed on this page."
msgstr "इस पृष्ठ पर कुछ भी छपा नहीं है।"

#: tavletta/ui/texts.py:350
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "PDF फ़ाइलों के लिए Poppler (poppler-glib) चाहिए, जो इंस्टॉल नहीं है"

#: tavletta/ui/texts.py:361
msgid "System printer (CUPS, IPP)"
msgstr "सिस्टम प्रिंटर (CUPS, IPP)"

#: tavletta/ui/texts.py:362
msgid "Receipt printer (ESC/POS)"
msgstr "रसीद प्रिंटर (ESC/POS)"

#. translators: %s is a printer model, e.g. "Brother QL"
#: tavletta/ui/texts.py:364
#, python-format
msgid "%s, continuous rolls"
msgstr "%s, लगातार रोल"

#. translators: %s is a printer model, e.g. "Brother QL"
#: tavletta/ui/texts.py:366
#, python-format
msgid "%s, die-cut labels"
msgstr "%s, पहले से कटे लेबल"

#: tavletta/ui/texts.py:389
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "तत्व %(n)d: कोड खाली है"

#: tavletta/ui/texts.py:390
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "तत्व %(n)d: EAN-13 के लिए ठीक 12 अंक चाहिए"

#: tavletta/ui/texts.py:391
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "तत्व %(n)d: EAN-13 का चेक अंक गलत है"

#: tavletta/ui/texts.py:392
#, python-format
msgid "Element %(n)d: Code 128 holds at most %(max)d characters"
msgstr "तत्व %(n)d: Code 128 में अधिकतम %(max)d वर्ण हो सकते हैं"

#: tavletta/ui/texts.py:394
#, python-format
msgid ""
"Element %(n)d: the bars are too thin to scan reliably – use a longer or "
"larger label, or shorter content"
msgstr "तत्व %(n)d: बार भरोसेमंद ढंग से स्कैन होने के लिए बहुत पतले हैं – लंबा या बड़ा लेबल इस्तेमाल करें, या छोटी सामग्री"

#: tavletta/ui/texts.py:398
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "तत्व %(n)d: Code 128 केवल लैटिन अक्षर, अंक और विराम चिह्न स्वीकार करता है"

#: tavletta/ui/texts.py:400
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "तत्व %(n)d: EAN-8 के लिए 7 अंक चाहिए, या चेक अंक सहित 8"

#: tavletta/ui/texts.py:401
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "तत्व %(n)d: UPC-A के लिए 11 अंक चाहिए, या चेक अंक सहित 12"

#: tavletta/ui/texts.py:403
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "तत्व %(n)d: UPC-E के लिए 0 या 1 से शुरू होने वाले 7 अंक चाहिए, या चेक अंक सहित 8"

#: tavletta/ui/texts.py:405
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "तत्व %(n)d: ITF-14 के लिए 13 अंक चाहिए, या चेक अंक सहित 14"

#: tavletta/ui/texts.py:406
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "तत्व %(n)d: चेक अंक गलत है"

#: tavletta/ui/texts.py:408
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "तत्व %(n)d: Code 39 केवल बड़े अक्षर, अंक, स्पेस और - . $ / + %% स्वीकार करता है"

#: tavletta/ui/texts.py:411
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "तत्व %(n)d: Code 93 केवल लैटिन अक्षर, अंक और विराम चिह्न स्वीकार करता है"

#: tavletta/ui/texts.py:414
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "तत्व %(n)d: GS1 डेटा केवल लैटिन अक्षर, अंक और विराम चिह्न स्वीकार करता है"

#: tavletta/ui/texts.py:417
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "तत्व %(n)d: GS1 डेटा कोष्ठक में एप्लिकेशन आइडेंटिफ़ायर होने चाहिए, हर एक के बाद उसका मान, जैसे (01)09501101530003(10)AB12"

#: tavletta/ui/texts.py:420
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "तत्व %(n)d: (%(ai)s) कोई GS1 एप्लिकेशन आइडेंटिफ़ायर नहीं है"

#: tavletta/ui/texts.py:422
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "तत्व %(n)d: एप्लिकेशन आइडेंटिफ़ायर (%(ai)s) के मान की लंबाई गलत है"

#: tavletta/ui/texts.py:425
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "तत्व %(n)d: एप्लिकेशन आइडेंटिफ़ायर (%(ai)s) का चेक अंक गलत है"

#: tavletta/ui/texts.py:428
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "तत्व %(n)d: एप्लिकेशन आइडेंटिफ़ायर (%(ai)s) का मान मान्य नहीं है: ऐसी तारीख, संख्या या वर्ण जिसकी यह अनुमति नहीं देता"

#: tavletta/ui/texts.py:432
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "तत्व %(n)d: कोई UPC-A संख्या इन UPC-E अंकों में छोटी नहीं होती – इन्हें जाँचें या UPC-A का उपयोग करें"

#: tavletta/ui/texts.py:436
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "तत्व %(n)d: Full ASCII पर सेट स्कैनर बड़े अक्षर से पहले $, /, + या %% को किसी दूसरे वर्ण के रूप में पढ़ते हैं"

#: tavletta/ui/texts.py:439
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "तत्व %(n)d: इस प्रकार के कोड के लिए सामग्री बहुत लंबी है"

#: tavletta/ui/texts.py:440
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "तत्व %(n)d: सामग्री को इस प्रकार के कोड में एन्कोड नहीं किया जा सकता"

#: tavletta/ui/texts.py:442
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "तत्व %(n)d: इस प्रकार के कोड के लिए Zint लाइब्रेरी (zint-bindings) चाहिए, जो इंस्टॉल नहीं है"

#: tavletta/ui/texts.py:445
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "तत्व %(n)d: छवि पढ़ी नहीं जा सकती"

#: tavletta/ui/texts.py:446
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "तत्व %(n)d: यह प्रतीक प्रतीक लाइब्रेरी में नहीं है"

#: tavletta/ui/texts.py:447
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "तत्व %(n)d: दस्तावेज़ पढ़ा नहीं जा सकता"

#: tavletta/ui/texts.py:449
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "तत्व %(n)d: PDF फ़ाइलों के लिए Poppler (poppler-glib) चाहिए, जो इंस्टॉल नहीं है"

#: tavletta/ui/texts.py:451
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "तत्व %(n)d नहीं बनाया जा सकता"

#: tavletta/ui/texts.py:453
#, python-format
msgid ""
"Element %(n)d: the text is too long to be drawn in one line – break it into "
"lines or shorten it"
msgstr "तत्व %(n)d: टेक्स्ट एक पंक्ति में बनाने के लिए बहुत लंबा है – इसे पंक्तियों में बाँटें या छोटा करें"

#: tavletta/ui/texts.py:457
#, python-format
msgid ""
"Element %(n)d: the text is too tall to be drawn – use fewer lines or a "
"smaller size"
msgstr "तत्व %(n)d: टेक्स्ट बनाने के लिए बहुत ऊँचा है – कम पंक्तियाँ या छोटा आकार उपयोग करें"

#: tavletta/ui/texts.py:460
#, python-format
msgid ""
"Element %(n)d: the font %(font)s is not installed – another font is used"
msgstr "तत्व %(n)d: फ़ॉन्ट %(font)s इंस्टॉल नहीं है – कोई दूसरा फ़ॉन्ट उपयोग होगा"

#: tavletta/ui/texts.py:463
msgid ""
"Safety margin, border, its inset and edge spacing leave no room – reduce them"
msgstr "सुरक्षा हाशिया, बॉर्डर, उसकी भीतरी दूरी और किनारे का अंतराल कोई जगह नहीं छोड़ते – इन्हें कम करें"

#: tavletta/ui/texts.py:465
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "निश्चित लंबाई अंतराल से छोटी है – इसे बढ़ाएँ"

#: tavletta/ui/texts.py:466
msgid "The background image cannot be read"
msgstr "पृष्ठभूमि छवि पढ़ी नहीं जा सकती"

#: tavletta/ui/texts.py:468
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "तत्व %(n)d: कोड के मॉड्यूल केवल एक प्रिंट बिंदु चौड़े हैं और शायद स्कैन न हों – कोड बड़ा करें"

#: tavletta/ui/texts.py:472
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "तत्व %(n)d: कोड के चारों ओर ज़रूरी खाली जगह नहीं समाती – कोड बड़ा करें"

#: tavletta/ui/texts.py:476
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "तत्व %(n)d: प्रति मॉड्यूल एक प्रिंट बिंदु पर भी कोड अपनी जगह में नहीं समाता – लेबल बड़ा करें या सामग्री छोटी करें"

#: tavletta/ui/texts.py:479
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "तत्व %(n)d: %(name)s कोई ज्ञात चर नहीं है"

#: tavletta/ui/texts.py:481
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "तत्व %(n)d: %(name)s की तारीख वर्ष 1 से पहले या 9999 के बाद है"

#: tavletta/ui/texts.py:484
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "तत्व %(n)d: चर %(name)s… बंद नहीं है – इसे } से समाप्त करें"

#: tavletta/ui/texts.py:487
#, python-format
msgid ""
"Element %(n)d: on a black-and-white printer it hardly stands out from what "
"lies behind it, as a whole or in part – choose another colour or move it"
msgstr "तत्व %(n)d: श्वेत-श्याम प्रिंटर पर यह पूरी तरह या आंशिक रूप से अपने पीछे की चीज़ों से मुश्किल से अलग दिखता है – कोई दूसरा रंग चुनें या इसे खिसकाएँ"

#: tavletta/ui/texts.py:490
#, python-format
msgid "Element %(n)d: the shape has neither a line nor a fill"
msgstr "तत्व %(n)d: आकृति में न रेखा है न भराव"

#: tavletta/ui/texts.py:492
#, python-format
msgid ""
"Element %(n)d reaches beyond the edge of the label and is cut off there – "
"move it or make it smaller"
msgstr "तत्व %(n)d लेबल के किनारे से बाहर जाता है और वहाँ कट जाता है – इसे खिसकाएँ या छोटा करें"

#: tavletta/ui/texts.py:496
#, python-format
msgid ""
"Element %(n)d: the padding, frame, outline or shadow leave no room for the "
"text – make them smaller"
msgstr "तत्व %(n)d: पैडिंग, फ़्रेम, आउटलाइन या छाया पाठ के लिए कोई जगह नहीं छोड़ते – इन्हें छोटा करें"

#: tavletta/ui/texts.py:515
#, python-format
msgid ""
"The job was sent, but its outcome is unknown: %(n)d of %(total)d labels "
"printed for certain, up to %(most)d may have."
msgstr "जॉब भेजा गया, लेकिन उसका परिणाम अज्ञात है: %(total)d में से %(n)d लेबल निश्चित रूप से प्रिंट हुए, शायद %(most)d तक।"

#: tavletta/ui/texts.py:520
#, python-format
msgid ""
"The job was sent, but its outcome is unknown: up to %(most)d of %(total)d "
"labels may have printed."
msgstr "जॉब भेजा गया, लेकिन उसका परिणाम अज्ञात है: %(total)d में से %(most)d तक लेबल प्रिंट हुए हो सकते हैं।"

#: tavletta/ui/texts.py:526
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "पहले ही प्रिंट हो चुकी शीटें: %(total)d में से %(n)d।"

#: tavletta/ui/texts.py:528
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "पहले ही प्रिंट हो चुके लेबल: %(total)d में से %(n)d।"

#: tavletta/ui/texts.py:532
msgid "The sheets still waiting in the queue were canceled."
msgstr "कतार में अभी भी प्रतीक्षा कर रही शीटें रद्द कर दी गईं।"

#: tavletta/ui/texts.py:534
msgid "The labels still waiting in the queue were canceled."
msgstr "कतार में अभी भी प्रतीक्षा कर रहे लेबल रद्द कर दिए गए।"

#: tavletta/ui/texts.py:545
#, python-format
msgid ""
"The label is %(size)s, but labels of %(loaded)s are loaded. Check the label "
"size, or load the matching roll."
msgstr "लेबल %(size)s का है, पर %(loaded)s के लेबल लगे हैं। लेबल का आकार जाँचें, या सही रोल लगाएँ।"

#: tavletta/ui/texts.py:553
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap, or calibrate the printer."
msgstr "लेबल %(size)s का है और गैप %(gap)s है, इसलिए हर %(pitch)s पर नया लेबल शुरू होता है। प्रिंटर ने हर %(measured)s पर एक लेबल मापा। लेबल का आकार और गैप जाँचें, या प्रिंटर को कैलिब्रेट करें।"

#: tavletta/ui/texts.py:559
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap."
msgstr "लेबल %(size)s का है और गैप %(gap)s है, इसलिए हर %(pitch)s पर नया लेबल शुरू होता है। प्रिंटर ने हर %(measured)s पर एक लेबल मापा। लेबल का आकार और गैप जाँचें।"

#: tavletta/ui/texts.py:576
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "प्रिंटर नहीं मिला। जाँचें कि वह चालू है और उसी नेटवर्क में है, या उसका IP पता दर्ज करें।"

#: tavletta/ui/texts.py:580
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "USB पर प्रिंटर नहीं मिल रहा। केबल जाँचें और देखें कि प्रिंटर चालू है और स्लीप मोड में नहीं है, फिर दोबारा खोजें।"

#: tavletta/ui/texts.py:583
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "प्रिंटर जवाब नहीं दे रहा। जाँचें कि वह चालू है और स्लीप मोड में नहीं है।"

#: tavletta/ui/texts.py:585
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "प्रिंटर ने डेटा लेना बंद कर दिया है। जाँचें कि क्या वह कोई समस्या दिखा रहा है, जैसे लेबल खत्म होना या कवर खुला होना, फिर दोबारा प्रयास करें।"

#: tavletta/ui/texts.py:589
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "प्रिंटर कनेक्शन अस्वीकार कर रहा है। उसे बंद करके फिर चालू करें। यदि उसके वेब इंटरफ़ेस में “Port 9100” विकल्प है, तो उसे चालू करें।"

#: tavletta/ui/texts.py:592
msgid "No cassette is inserted. Insert one and try again."
msgstr "कोई कैसेट नहीं लगी है। कैसेट लगाएँ और फिर से प्रयास करें।"

#: tavletta/ui/texts.py:593
msgid "The printer's cover is open. Close it and try again."
msgstr "प्रिंटर का ढक्कन खुला है। उसे बंद करें और फिर से प्रयास करें।"

#: tavletta/ui/texts.py:594
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "लेबल अटक गया है। ढक्कन खोलें, लेबल निकालें और फिर से प्रयास करें।"

#: tavletta/ui/texts.py:595
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "कैसेट पहचानी नहीं गई। उसे फिर से लगाएँ या कोई दूसरी कैसेट आज़माएँ।"

#: tavletta/ui/texts.py:596
msgid "The printer is busy. Wait a moment and try again."
msgstr "प्रिंटर व्यस्त है। थोड़ा रुकें और फिर से प्रयास करें।"

#: tavletta/ui/texts.py:597
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "लेबल इस प्रिंटर के लिए बहुत लंबा है: अधिकतम %(max)s।"

#: tavletta/ui/texts.py:598
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "यह लेबल इस प्रिंटर के लिए बहुत चौड़ा है: अधिकतम %(max)s।"

#: tavletta/ui/texts.py:599
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "प्रिंटर में लेबल खत्म हो गए हैं। नया रोल लगाएँ और फिर कोशिश करें।"

#: tavletta/ui/texts.py:600
msgid "The print head is open. Close it and try again."
msgstr "प्रिंट हेड खुला है। उसे बंद करें और फिर कोशिश करें।"

#: tavletta/ui/texts.py:602
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "प्रिंटर को अगला लेबल नहीं मिल रहा। जाँचें कि लेबल सही ढंग से लगे हैं और लेबल सेंसर से होकर गुज़रते हैं।"

#: tavletta/ui/texts.py:606
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "रिबन में समस्या है। जाँचें कि वह सही ढंग से लगा है और प्रिंटर पर सेट प्रिंट विधि से मेल खाता है।"

#: tavletta/ui/texts.py:612
#, python-format
msgid ""
"The printer finds no ribbon. Load a ribbon and try again. Labels that print "
"without one need “%(direct)s” under “%(method)s”."
msgstr "प्रिंटर को रिबन नहीं मिल रहा। रिबन लगाएँ और फिर से कोशिश करें। बिना रिबन के छपने वाले लेबल के लिए “%(method)s” में “%(direct)s” चाहिए।"

#: tavletta/ui/texts.py:619
#, python-format
msgid ""
"A ribbon is loaded, but the printer prints without it (thermal direct). For "
"labels that need the ribbon choose “%(transfer)s” under “%(method)s”, or "
"remove the ribbon."
msgstr "रिबन लगा है, पर प्रिंटर उसके बिना प्रिंट करता है (डायरेक्ट थर्मल)। रिबन की ज़रूरत वाले लेबल के लिए “%(method)s” में “%(transfer)s” चुनें, या रिबन निकाल दें।"

#: tavletta/ui/texts.py:624
msgid "The printer is paused. Resume it on its display and try again."
msgstr "प्रिंटर रुका हुआ है। उसकी डिस्प्ले पर फिर से शुरू करें और दोबारा कोशिश करें।"

#: tavletta/ui/texts.py:627
#, python-format
msgid ""
"The printer ran out of memory for the job. Lower “%s” in the printer "
"settings, then try again."
msgstr "इस जॉब के लिए प्रिंटर की मेमोरी कम पड़ गई। प्रिंटर सेटिंग्स में “%s” घटाएँ, फिर दोबारा कोशिश करें।"

#: tavletta/ui/texts.py:631
msgid "The printer is out of paper. Load paper and try again."
msgstr "प्रिंटर में कागज़ खत्म हो गया है। कागज़ डालें और दोबारा कोशिश करें।"

#: tavletta/ui/texts.py:633
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "कागज़ फँस गया है। प्रिंटर की डिस्प्ले पर दिखाए अनुसार उसे निकालें और दोबारा कोशिश करें।"

#: tavletta/ui/texts.py:635
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "प्रिंटर में टोनर या स्याही खत्म हो गई है। उसे बदलें और दोबारा कोशिश करें।"

#: tavletta/ui/texts.py:636
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "प्रिंटर इस आकार में प्रिंट नहीं कर सकता। प्रिंटर द्वारा समर्थित कागज़ का आकार चुनें।"

#: tavletta/ui/texts.py:638
msgid ""
"The printer takes none of the formats Tavletta can send (PDF, PWG Raster, "
"JPEG)."
msgstr "प्रिंटर Tavletta द्वारा भेजे जा सकने वाले किसी भी फ़ॉर्मैट (PDF, PWG Raster, JPEG) को स्वीकार नहीं करता।"

#: tavletta/ui/texts.py:641
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "प्रिंटर की कतार रुकी हुई है। सिस्टम की प्रिंटर सेटिंग में उसे फिर से शुरू करें और दोबारा कोशिश करें।"

#: tavletta/ui/texts.py:645
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "प्रिंट जॉब कतार में रोक दिया गया, उदाहरण के लिए जब तक उसे जारी न किया जाए या पासवर्ड न डाला जाए। सिस्टम की प्रिंटर सेटिंग में कतार जाँचें और दोबारा कोशिश करें।"

#: tavletta/ui/texts.py:649
msgid "The print job was canceled at the printer or in the queue."
msgstr "प्रिंट जॉब प्रिंटर पर या कतार में रद्द कर दिया गया।"

#: tavletta/ui/texts.py:650
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "प्रिंटर ने समय पर अपना रिज़ॉल्यूशन नहीं बताया। इसे “%s” में चुनें।"

#: tavletta/ui/texts.py:653
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "लगाया गया रोल लेबल से मेल नहीं खाता। सही रोल लगाएँ, या लगाए गए रोल के अनुसार लेबल का आकार या प्रिंटर मॉडल चुनें।"

#: tavletta/ui/texts.py:656
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "प्रिंटर की बैटरी कम है – इसे चार्ज करें या पावर एडॉप्टर लगाएँ।"

#: tavletta/ui/texts.py:657
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "प्रिंट हेड बहुत गर्म है। ठंडा होने तक प्रतीक्षा करें, फिर से कोशिश करें।"

#: tavletta/ui/texts.py:659
msgid ""
"Tavletta cannot print on this printer model: it does not take the raster "
"images Tavletta sends."
msgstr "Tavletta इस प्रिंटर मॉडल पर प्रिंट नहीं कर सकता: यह Tavletta की भेजी रैस्टर छवियाँ स्वीकार नहीं करता।"

#: tavletta/ui/texts.py:663
msgid "Tavletta does not know this printer model and cannot print on it yet."
msgstr "Tavletta इस प्रिंटर मॉडल को नहीं जानता और अभी इस पर प्रिंट नहीं कर सकता।"

#: tavletta/ui/texts.py:666
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "प्रिंटर Editor Lite मोड में है और USB ड्राइव के रूप में दिखता है। प्रिंटर पर Editor Lite बंद करें (उसकी लाइट बुझ जाती है), फिर से खोजें।"

#: tavletta/ui/texts.py:670
msgid ""
"Tavletta is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Tavletta को प्रिंटर का USB पोर्ट इस्तेमाल करने की अनुमति नहीं है। अपने उपयोगकर्ता को समूह “lp” में जोड़ें (sudo usermod -aG lp $USER), फिर लॉग आउट करके दोबारा लॉग इन करें।"

#: tavletta/ui/texts.py:674
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "प्रिंटर जिस रिज़ॉल्यूशन को स्वीकार करता है, उस पर यह पेज बनाने के लिए बहुत बड़ा है। छोटा काग़ज़ आकार चुनें, या ऐसे प्रिंटर पर प्रिंट करें जो PDF स्वीकार करता हो।"

#: tavletta/ui/texts.py:678
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "इस प्रिंटर के रिज़ॉल्यूशन पर कोड लेबल पर नहीं समाता और कट जाएगा। लेबल बड़ा करें या कोड की सामग्री छोटी करें।"

#: tavletta/ui/texts.py:682
msgid ""
"Tavletta is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "Tavletta को प्रिंटर का सीरियल पोर्ट इस्तेमाल करने की अनुमति नहीं है। अपने उपयोगकर्ता को समूह “dialout” में जोड़ें (sudo usermod -aG dialout $USER; Arch Linux पर समूह का नाम “uucp” है), फिर लॉग आउट करके दोबारा लॉग इन करें।"

#: tavletta/ui/texts.py:687
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "प्रिंटर ने एक समस्या बताई। उसे बंद करके फिर चालू करें, फिर एक बार और प्रयास करें।"

#: tavletta/ui/texts.py:698 tavletta/server/web/ui.js:452
msgid "Printed"
msgstr "प्रिंट हो गया"

#: tavletta/ui/texts.py:704
msgid "Sent to the printer – it prints when its turn comes"
msgstr "प्रिंटर को भेज दिया गया – बारी आने पर प्रिंट होगा"

#: tavletta/ui/texts.py:706
msgid "Sent to the printer – it did not confirm printing"
msgstr "प्रिंटर को भेजा गया – उसने प्रिंट होने की पुष्टि नहीं की"

#: tavletta/ui/texts.py:710
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "“%(used)s” से प्रिंट किया गया, क्योंकि लगाए गए रोल को इसकी ज़रूरत है"

#: tavletta/ui/texts.py:714
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "रंग मोड “%(wanted)s” इस प्रिंटर पर उपलब्ध नहीं है, “%(used)s” से प्रिंट किया गया"

#: tavletta/ui/texts.py:724
msgid "Warming up…"
msgstr "गर्म हो रहा है…"

#: tavletta/ui/texts.py:725
msgid "Cooling down…"
msgstr "ठंडा हो रहा है…"

#: tavletta/ui/texts.py:726
msgid "Cleaning…"
msgstr "सफ़ाई हो रही है…"

#: tavletta/ui/texts.py:727
msgid "Swipe the printer's panel to cut the label"
msgstr "लेबल काटने के लिए प्रिंटर के पैनल पर स्वाइप करें"

#: tavletta/ui/texts.py:729
msgid "Out of paper – load paper to continue"
msgstr "कागज़ खत्म – जारी रखने के लिए कागज़ डालें"

#: tavletta/ui/texts.py:730
msgid "Cover open – close it to continue"
msgstr "ढक्कन खुला है – जारी रखने के लिए उसे बंद करें"

#: tavletta/ui/texts.py:731
msgid "Paper jammed – remove it to continue"
msgstr "कागज़ फँस गया – जारी रखने के लिए उसे निकालें"

#: tavletta/ui/texts.py:742
msgid "This label needs a newer version of Tavletta"
msgstr "इस लेबल के लिए Tavletta का नया संस्करण चाहिए"

#: tavletta/ui/texts.py:744
#, python-format
msgid "%s is not a Tavletta label"
msgstr "%s कोई Tavletta लेबल नहीं है"

#: tavletta/ui/texts.py:745 tavletta/ui/texts.py:765
#: tavletta/server/service.py:993
#, python-format
msgid "The file is damaged: %s"
msgstr "फ़ाइल खराब है: %s"

#: tavletta/ui/texts.py:752
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "डेटा फ़ाइल %s अब मौजूद नहीं है। उसे फिर से चुनें या हटाएँ।"

#: tavletta/ui/texts.py:756
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s में %(sheet)s नाम की कोई शीट नहीं है"

#: tavletta/ui/texts.py:758
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s तालिका नहीं है। CSV, ODS या XLSX फ़ाइल इस्तेमाल करें।"

#: tavletta/ui/texts.py:760
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s सीरियल लेबल के लिए बहुत बड़ी है। इसे छोटी फ़ाइलों में बाँटें या अनावश्यक पंक्तियाँ और स्तंभ हटाएँ।"

#: tavletta/ui/texts.py:763
#, python-format
msgid "%s contains no data."
msgstr "%s में कोई डेटा नहीं है।"

#: tavletta/ui/texts.py:778
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "प्रिंटिंग पंक्ति %(row)d पर रुक गई। जारी रखने के लिए पंक्ति %(row)d से फिर से प्रिंट करें।"

#: tavletta/ui/texts.py:783
#, python-format
msgid ""
"Row %(row)d and the rows after it may have printed already: going on from it "
"may print them twice."
msgstr "पंक्ति %(row)d और उसके बाद की पंक्तियाँ शायद पहले ही प्रिंट हो चुकी हैं: वहाँ से जारी रखने पर वे दो बार प्रिंट हो सकती हैं।"

#: tavletta/ui/texts.py:787
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "पंक्ति %(row)d की पहले से प्रिंट हुई प्रतियाँ: %(copies)d।"

#: tavletta/ui/texts.py:792
#, python-format
msgid "Row %(row)d goes at position %(position)d of sheet %(sheet)d."
msgstr "पंक्ति %(row)d शीट %(sheet)d की स्थिति %(position)d पर आती है।"

#: tavletta/ui/texts.py:803
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "%s सहेजा नहीं जा सकता: वहाँ लिखने की अनुमति नहीं है"

#: tavletta/ui/texts.py:805
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "%s सहेजा नहीं जा सकता: डिस्क भरी हुई है"

#: tavletta/ui/texts.py:815
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "यह कैसेट शायद %(month)s %(year)d की है। पुराना ZINK कागज़ फीके रंग छापता है।"

#: tavletta/ui/variables.py:24
msgid "Date"
msgstr "तारीख़"

#: tavletta/ui/variables.py:25
msgid "Best before (in 30 days)"
msgstr "इससे पहले उपयोग करें (30 दिन बाद)"

#: tavletta/ui/variables.py:26
msgid "Time"
msgstr "समय"

#: tavletta/ui/variables.py:27 tavletta/ui/variables.py:113
msgid "Counter"
msgstr "काउंटर"

#: tavletta/ui/variables.py:28
msgid "Counter with leading zeros"
msgstr "शुरुआती शून्यों वाला काउंटर"

#: tavletta/ui/variables.py:29
msgid "Copy number"
msgstr "प्रति क्रमांक"

#: tavletta/ui/variables.py:30
msgid "Number of copies"
msgstr "प्रतियों की संख्या"

#: tavletta/ui/variables.py:31
msgid "Random ID"
msgstr "यादृच्छिक ID"

#: tavletta/ui/variables.py:41
msgid "Insert variable"
msgstr "चर डालें"

#: tavletta/ui/variables.py:67
msgid ""
"Variables are filled in when printing. Every printed label gets the next "
"counter value, also from copy to copy. The preview shows the values of the "
"next print."
msgstr "चर प्रिंट करते समय भरे जाते हैं। प्रिंट होने वाले हर लेबल को अगला काउंटर मान मिलता है, एक प्रति से दूसरी प्रति तक भी। पूर्वावलोकन अगले प्रिंट के मान दिखाता है।"

#: tavletta/ui/variables.py:77
msgid "More about variables"
msgstr "चर के बारे में और जानें"

#: tavletta/ui/variables.py:113
msgid "Goes up with every printed label, by the step"
msgstr "हर प्रिंट हुए लेबल के साथ चरण के अनुसार बढ़ता है"

#: tavletta/ui/variables.py:119
msgid "Next number"
msgstr "अगली संख्या"

#: tavletta/ui/variables.py:122 tavletta/server/web/batch.js:628
msgid "Step"
msgstr "चरण"

#: tavletta/ui/window.py:176 tavletta/server/web/app.js:49
#: tavletta/server/web/app.js:342
msgid "Templates"
msgstr "टेम्पलेट"

#: tavletta/ui/window.py:208
msgid "Shipping label…"
msgstr "शिपिंग लेबल…"

#: tavletta/ui/window.py:211
msgid "Data for serial labels…"
msgstr "सीरियल लेबल के लिए डेटा…"

#: tavletta/ui/window.py:212
msgid "Forget allowed data files"
msgstr "अनुमति वाली डेटा फ़ाइलें भूलें"

#: tavletta/ui/window.py:213
msgid "Export PNG…"
msgstr "PNG में निर्यात करें…"

#: tavletta/ui/window.py:217
msgid "Report a problem…"
msgstr "समस्या की रिपोर्ट करें…"

#: tavletta/ui/window.py:218
msgid "About Tavletta"
msgstr "Tavletta के बारे में"

#: tavletta/ui/window.py:743
msgid "Unsaved label"
msgstr "बिना सहेजा लेबल"

#: tavletta/ui/window.py:915
msgid "content scaled down to fit"
msgstr "फ़िट करने के लिए सामग्री छोटी की गई"

#: tavletta/ui/window.py:919
#, python-format
msgid "Problem: %s"
msgstr "समस्या: %s"

#: tavletta/ui/window.py:938
#, python-format
msgid "Too long for this printer: at most %s"
msgstr "इस प्रिंटर के लिए बहुत लंबा: अधिकतम %s"

#: tavletta/ui/window.py:942
#, python-format
msgid "Too wide for this printer: at most %s"
msgstr "इस प्रिंटर के लिए बहुत चौड़ा: अधिकतम %s"

#: tavletta/ui/window.py:1020
msgid "The browser cannot be opened"
msgstr "ब्राउज़र खोला नहीं जा सकता"

#: tavletta/ui/window.py:1022
msgid "Copy link"
msgstr "लिंक कॉपी करें"

#: tavletta/ui/window.py:1094
msgid "Only local files can be dropped"
msgstr "केवल स्थानीय फ़ाइलें छोड़ी जा सकती हैं"

#: tavletta/ui/window.py:1147
msgid "Please wait until printing has finished"
msgstr "कृपया प्रिंटिंग पूरी होने तक प्रतीक्षा करें"

#: tavletta/server/config.py:80
#, python-format
msgid "%(file)s: %(key)s: %(problem)s"
msgstr "%(file)s: %(key)s: %(problem)s"

#: tavletta/server/config.py:90 tavletta/server/config.py:94
#: tavletta/server/config.py:100 tavletta/server/main.py:419
#, python-format
msgid "Cannot read %(file)s: %(reason)s"
msgstr "%(file)s पढ़ी नहीं जा सकती: %(reason)s"

#: tavletta/server/config.py:110
msgid "expected a table"
msgstr "तालिका अपेक्षित है"

#: tavletta/server/config.py:120 tavletta/server/config.py:457
#: tavletta/server/oidc.py:226 tavletta/server/oidc.py:318
msgid "missing"
msgstr "अनुपस्थित"

#: tavletta/server/config.py:123
msgid "expected text"
msgstr "पाठ अपेक्षित है"

#: tavletta/server/config.py:125
msgid "control characters are not allowed"
msgstr "नियंत्रण वर्णों की अनुमति नहीं है"

#: tavletta/server/config.py:131
msgid "expected true or false"
msgstr "true या false अपेक्षित है"

#: tavletta/server/config.py:142
#, python-format
msgid "expected a number from %(min)s to %(max)s"
msgstr "%(min)s से %(max)s तक की संख्या अपेक्षित है"

#: tavletta/server/config.py:149
#, python-format
msgid "expected one of: %s"
msgstr "इनमें से एक अपेक्षित है: %s"

#: tavletta/server/config.py:154 tavletta/server/config.py:160
#: tavletta/server/oidc.py:287
msgid "unknown key"
msgstr "अज्ञात कुंजी"

#: tavletta/server/config.py:163
msgid "nothing defined"
msgstr "कुछ भी परिभाषित नहीं"

#: tavletta/server/config.py:169
msgid "not a valid name: letters, digits, . _ - (up to 64)"
msgstr "मान्य नाम नहीं: अक्षर, अंक, . _ - (अधिकतम 64)"

#: tavletta/server/config.py:210
msgid "only one printer can be the default"
msgstr "केवल एक प्रिंटर डिफ़ॉल्ट हो सकता है"

#: tavletta/server/config.py:224
msgid "not a valid printer address"
msgstr "मान्य प्रिंटर पता नहीं"

#: tavletta/server/config.py:246
msgid "this printer model does not cut"
msgstr "यह प्रिंटर मॉडल कट नहीं करता"

#: tavletta/server/config.py:248
msgid "this printer model has no colour settings"
msgstr "इस प्रिंटर मॉडल में रंग सेटिंग नहीं हैं"

#: tavletta/server/config.py:412
msgid "expected a date such as 2027-12-31"
msgstr "2027-12-31 जैसी तारीख़ अपेक्षित है"

#: tavletta/server/config.py:431
msgid "the same token twice"
msgstr "एक ही टोकन दो बार"

#: tavletta/server/config.py:444
#, python-format
msgid "%s can be changed by every user of this computer: chmod 600 it"
msgstr "%s को इस कंप्यूटर का हर उपयोगकर्ता बदल सकता है: उस पर chmod 600 चलाएँ"

#: tavletta/server/config.py:454
msgid "not a token hash: expected sha256:… or scrypt:…"
msgstr "टोकन हैश नहीं: sha256:… या scrypt:… अपेक्षित है"

#: tavletta/server/config.py:480
msgid "expected a list of printer names"
msgstr "प्रिंटर नामों की सूची अपेक्षित है"

#: tavletta/server/config.py:484 tavletta/server/main.py:445
