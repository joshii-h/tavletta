Description: depend on labelprinter by name, not on a Git URL
 pyproject.toml pins the labelprinter fork by a direct Git URL, which pip
 can install but dh_python3 cannot map to a package. Debian gets it from
 python3-labelprinter, built from the same commit of the fork.
Author: Joshua Hirsig <joshuahirsig@gmail.com>
Forwarded: not-needed
Last-Update: 2026-11-17
---
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -28,7 +28,7 @@
     # every other symbology: libzint (BSD-3-Clause) with its Python binding (Apache-2.0)
     "zint-bindings>=1.2.2",
     # native VC-500W protocol; fork until sgrimee/labelprinter-vc500w#1-#3 are merged
-    "labelprinter @ git+https://github.com/joshii-h/labelprinter-vc500w.git@a6f2957de323f71f364b3acd6624da8b9885587a",
+    "labelprinter",
 ]
 # PyGObject (GTK 4, libadwaita, Pango) and pycairo come from the system,
 # install with a venv that has --system-site-packages (see install.sh).
