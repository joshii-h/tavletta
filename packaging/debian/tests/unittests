#!/bin/sh
# The program's tests against the installed package, without a display (the
# tests marked gui skip), as the build runs them: in a copy of the source
# tree whose tavletta/ is the installed module.
set -eu
installed="$(cd / && python3 -c 'import os, tavletta; print(os.path.dirname(tavletta.__file__))')"
case "$installed" in
  /usr/lib/python3/dist-packages/tavletta) ;;
  *) echo "not the package's module: $installed" >&2; exit 1 ;;
esac
src="$AUTOPKGTEST_TMP/src"
mkdir "$src"
tar --exclude=./tavletta --exclude=./debian --exclude=./.pybuild -cf - . | tar -xf - -C "$src"
ln -s "$installed" "$src/tavletta"
cd "$src"
# Not those about the source tree rather than the program: test_packaging.py
# (the repository's packaging files), and the data licences next to the data,
# which this package keeps in /usr/share/doc/tavletta instead. CI=1: a test
# that would skip for a missing tool fails, as on the CI runners.
CI=1 FONTCONFIG_FILE="$src/tests/fonts.conf" python3 -m pytest -q -p no:cacheprovider -n auto -m "not gui" \
  --ignore=tests/test_packaging.py \
  --deselect tests/test_sheets.py::test_the_license_comes_with_the_data \
  --deselect tests/test_symbols.py::test_the_icon_data_and_its_license_are_packaged
