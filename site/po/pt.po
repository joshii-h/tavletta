"|---|---|---|\n"
"| `printer` | string |  |\n"
"| `host` | string |  |\n"
"| `name` | string | O seu nome em `printers.toml`. |\n"
"| `model` | string |  |\n"
"| `state` | string |  |\n"
"| `error` | null or Warning |  |\n"
"| `dpi` | number |  |\n"
