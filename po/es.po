#, python-format
msgid "%s, die-cut labels"
msgstr "%s, etiquetas troqueladas"

#: tavletta/ui/texts.py:385
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Elemento %(n)d: el código está vacío"

#: tavletta/ui/texts.py:386
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Elemento %(n)d: EAN-13 necesita exactamente 12 dígitos"

#: tavletta/ui/texts.py:387
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Elemento %(n)d: el dígito de control EAN-13 es incorrecto"

#: tavletta/ui/texts.py:388
#, python-format
msgid "Element %(n)d: Code 128 holds at most %(max)d characters"
msgstr "Elemento %(n)d: Code 128 admite como máximo %(max)d caracteres"

#: tavletta/ui/texts.py:390
#, python-format
msgid ""
"Element %(n)d: the bars are too thin to scan reliably – use a longer or "
"larger label, or shorter content"
msgstr "Elemento %(n)d: las barras son demasiado finas para escanearse con fiabilidad – use una etiqueta más larga o más grande, o un contenido más corto"

#: tavletta/ui/texts.py:394
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Elemento %(n)d: Code 128 solo admite letras latinas, dígitos y signos de puntuación"

#: tavletta/ui/texts.py:396
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Elemento %(n)d: EAN-8 necesita 7 dígitos, u 8 con el dígito de control"

#: tavletta/ui/texts.py:397
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "Elemento %(n)d: UPC-A necesita 11 dígitos, o 12 con el dígito de control"

#: tavletta/ui/texts.py:399
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "Elemento %(n)d: UPC-E necesita 7 dígitos que empiecen por 0 o 1, u 8 con el dígito de control"

#: tavletta/ui/texts.py:401
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "Elemento %(n)d: ITF-14 necesita 13 dígitos, o 14 con el dígito de control"

#: tavletta/ui/texts.py:402
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "Elemento %(n)d: el dígito de control es incorrecto"

#: tavletta/ui/texts.py:404
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Elemento %(n)d: Code 39 solo admite mayúsculas, dígitos, espacios y - . $ / + %%"

#: tavletta/ui/texts.py:407
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Elemento %(n)d: Code 93 solo admite letras latinas, dígitos y signos de puntuación"

#: tavletta/ui/texts.py:410
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Elemento %(n)d: los datos GS1 solo admiten letras latinas, dígitos y signos de puntuación"

#: tavletta/ui/texts.py:413
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Elemento %(n)d: los datos GS1 deben ser identificadores de aplicación entre paréntesis, cada uno seguido de su valor, p. ej. (01)09501101530003(10)AB12"

#: tavletta/ui/texts.py:416
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Elemento %(n)d: (%(ai)s) no es un identificador de aplicación GS1"

#: tavletta/ui/texts.py:418
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Elemento %(n)d: el valor del identificador de aplicación (%(ai)s) tiene una longitud incorrecta"

#: tavletta/ui/texts.py:421
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Elemento %(n)d: el dígito de control del identificador de aplicación (%(ai)s) es incorrecto"

#: tavletta/ui/texts.py:424
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Elemento %(n)d: el valor del identificador de aplicación (%(ai)s) no es válido: contiene una fecha, un número o un carácter no permitido"

#: tavletta/ui/texts.py:428
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Elemento %(n)d: ningún número UPC-A se abrevia a estos dígitos UPC-E – revíselos o use UPC-A"

#: tavletta/ui/texts.py:432
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Elemento %(n)d: los escáneres en modo Full ASCII leen un $, /, + o %% delante de una mayúscula como otro carácter"

#: tavletta/ui/texts.py:435
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Elemento %(n)d: el contenido es demasiado largo para este tipo de código"

#: tavletta/ui/texts.py:436
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Elemento %(n)d: el contenido no se puede codificar en este tipo de código"

#: tavletta/ui/texts.py:438
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Elemento %(n)d: este tipo de código necesita la biblioteca Zint (zint-bindings), que no está instalada"

#: tavletta/ui/texts.py:441
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Elemento %(n)d: no se puede leer la imagen"

#: tavletta/ui/texts.py:442
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Elemento %(n)d: este símbolo no está en la biblioteca de símbolos"

#: tavletta/ui/texts.py:443
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Elemento %(n)d: no se puede leer el documento"

#: tavletta/ui/texts.py:445
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Elemento %(n)d: los archivos PDF necesitan Poppler (poppler-glib), que no está instalado"

#: tavletta/ui/texts.py:447
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "No se puede dibujar el elemento %(n)d"

#: tavletta/ui/texts.py:449
#, python-format
msgid ""
"Element %(n)d: the text is too long to be drawn in one line – break it into "
"lines or shorten it"
msgstr "Elemento %(n)d: el texto es demasiado largo para dibujarse en una sola línea – divídalo en líneas o acórtelo"

#: tavletta/ui/texts.py:453
#, python-format
msgid ""
"Element %(n)d: the text is too tall to be drawn – use fewer lines or a "
"smaller size"
msgstr "Elemento %(n)d: el texto es demasiado alto para dibujarse – use menos líneas o un tamaño menor"

#: tavletta/ui/texts.py:456
#, python-format
msgid ""
"Element %(n)d: the font %(font)s is not installed – another font is used"
msgstr "Elemento %(n)d: la fuente %(font)s no está instalada – se usa otra"

#: tavletta/ui/texts.py:459
msgid ""
"Safety margin, border, its inset and edge spacing leave no room – reduce them"
msgstr "El margen de seguridad, el borde, su desplazamiento interior y el margen lateral no dejan espacio: redúzcalos"

#: tavletta/ui/texts.py:461
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "La longitud fija es menor que el espaciado: auméntela"

#: tavletta/ui/texts.py:462
msgid "The background image cannot be read"
msgstr "No se puede leer la imagen de fondo"

#: tavletta/ui/texts.py:464
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Elemento %(n)d: los módulos del código tienen solo un punto de impresión de ancho y quizá no se puedan escanear – amplía el código"

#: tavletta/ui/texts.py:468
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Elemento %(n)d: el espacio en blanco que el código necesita a su alrededor no cabe – amplía el código"

#: tavletta/ui/texts.py:472
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Elemento %(n)d: el código no cabe en su espacio, ni siquiera con un punto de impresión por módulo – amplía la etiqueta o acorta el contenido"

#: tavletta/ui/texts.py:475
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Elemento %(n)d: %(name)s no es una variable conocida"

#: tavletta/ui/texts.py:477
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Elemento %(n)d: la fecha de %(name)s es anterior al año 1 o posterior a 9999"

#: tavletta/ui/texts.py:480
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Elemento %(n)d: la variable %(name)s… no está cerrada – termínala con }"

#: tavletta/ui/texts.py:483
#, python-format
msgid ""
"Element %(n)d: on a black-and-white printer it hardly stands out from what "
"lies behind it, as a whole or in part – choose another colour or move it"
msgstr "Elemento %(n)d: en una impresora en blanco y negro apenas se distingue de lo que hay detrás, total o parcialmente – elija otro color o muévalo"

#: tavletta/ui/texts.py:486
#, python-format
msgid "Element %(n)d: the shape has neither a line nor a fill"
msgstr "Elemento %(n)d: la forma no tiene ni línea ni relleno"

#: tavletta/ui/texts.py:488
#, python-format
msgid ""
"Element %(n)d reaches beyond the edge of the label and is cut off there – "
"move it or make it smaller"
msgstr "El elemento %(n)d sobrepasa el borde de la etiqueta y se corta allí – muévelo o hazlo más pequeño"

#: tavletta/ui/texts.py:492
#, python-format
msgid ""
"Element %(n)d: the padding, frame, outline or shadow leave no room for the "
"text – make them smaller"
msgstr "Elemento %(n)d: el margen interior, el marco, el contorno o la sombra no dejan espacio para el texto – redúzcalos"

#: tavletta/ui/texts.py:507
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Hojas ya impresas: %(n)d de %(total)d."

#: tavletta/ui/texts.py:509
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Etiquetas ya impresas: %(n)d de %(total)d."

#: tavletta/ui/texts.py:513
msgid "The sheets still waiting in the queue were canceled."
msgstr "Se cancelaron las hojas que aún esperaban en la cola."

#: tavletta/ui/texts.py:515
msgid "The labels still waiting in the queue were canceled."
msgstr "Se cancelaron las etiquetas que aún esperaban en la cola."

#: tavletta/ui/texts.py:526
#, python-format
msgid ""
"The label is %(size)s, but labels of %(loaded)s are loaded. Check the label "
"size, or load the matching roll."
msgstr "La etiqueta mide %(size)s, pero hay cargadas etiquetas de %(loaded)s. Compruebe el tamaño de la etiqueta o cargue el rollo adecuado."

#: tavletta/ui/texts.py:534
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap, or calibrate the printer."
msgstr "La etiqueta mide %(size)s con una separación de %(gap)s, así que empieza una nueva cada %(pitch)s. La impresora ha medido una etiqueta cada %(measured)s. Compruebe el tamaño de la etiqueta y la separación, o calibre la impresora."

#: tavletta/ui/texts.py:540
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap."
msgstr "La etiqueta mide %(size)s con una separación de %(gap)s, así que empieza una nueva cada %(pitch)s. La impresora ha medido una etiqueta cada %(measured)s. Compruebe el tamaño de la etiqueta y la separación."

#: tavletta/ui/texts.py:557
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "No se encuentra la impresora. Compruebe que esté encendida y en la misma red, o escriba su dirección IP."

#: tavletta/ui/texts.py:561
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "No se encuentra la impresora por USB. Compruebe el cable y que la impresora esté encendida y activa, y vuelva a buscar."

#: tavletta/ui/texts.py:564
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "La impresora no responde. Compruebe que esté encendida y activa."

#: tavletta/ui/texts.py:566
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "La impresora ha dejado de aceptar datos. Compruebe si muestra algún problema, como falta de etiquetas o una tapa abierta, y vuelva a intentarlo."

#: tavletta/ui/texts.py:570
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "La impresora rechaza la conexión. Apáguela y vuelva a encenderla. Si su interfaz web ofrece una opción «Port 9100», actívela."

#: tavletta/ui/texts.py:573
msgid "No cassette is inserted. Insert one and try again."
msgstr "No hay ningún casete insertado. Inserte uno e inténtelo de nuevo."

#: tavletta/ui/texts.py:574
msgid "The printer's cover is open. Close it and try again."
msgstr "La tapa de la impresora está abierta. Ciérrela e inténtelo de nuevo."

#: tavletta/ui/texts.py:575
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "La etiqueta está atascada. Abra la tapa, retírela e inténtelo de nuevo."

#: tavletta/ui/texts.py:576
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "No se reconoce el casete. Vuelva a insertarlo o pruebe con otro."

#: tavletta/ui/texts.py:577
msgid "The printer is busy. Wait a moment and try again."
msgstr "La impresora está ocupada. Espere un momento e inténtelo de nuevo."

#: tavletta/ui/texts.py:578
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "La etiqueta es demasiado larga para esta impresora: como máximo %(max)s."

#: tavletta/ui/texts.py:579
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "La etiqueta es demasiado ancha para esta impresora: máximo %(max)s."

#: tavletta/ui/texts.py:580
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "La impresora se ha quedado sin etiquetas. Cargue un rollo nuevo e inténtelo de nuevo."

#: tavletta/ui/texts.py:581
msgid "The print head is open. Close it and try again."
msgstr "El cabezal de impresión está abierto. Ciérrelo e inténtelo de nuevo."

#: tavletta/ui/texts.py:583
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "La impresora no encuentra la siguiente etiqueta. Compruebe que las etiquetas estén bien cargadas y pasen por el sensor de etiquetas."

#: tavletta/ui/texts.py:587
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Hay un problema con la cinta de transferencia térmica. Compruebe que esté bien colocada y que coincida con el método de impresión configurado en la impresora."

#: tavletta/ui/texts.py:593
#, python-format
msgid ""
"The printer finds no ribbon. Load a ribbon and try again. Labels that print "
"without one need “%(direct)s” under “%(method)s”."
msgstr "La impresora no encuentra la cinta. Coloque una cinta y vuelva a intentarlo. Las etiquetas que se imprimen sin cinta necesitan «%(direct)s» en «%(method)s»."

#: tavletta/ui/texts.py:600
#, python-format
msgid ""
"A ribbon is loaded, but the printer prints without it (thermal direct). For "
"labels that need the ribbon choose “%(transfer)s” under “%(method)s”, or "
"remove the ribbon."
msgstr "Hay una cinta colocada, pero la impresora imprime sin ella (térmica directa). Para etiquetas que necesitan la cinta, elija «%(transfer)s» en «%(method)s», o quite la cinta."

#: tavletta/ui/texts.py:605
msgid "The printer is paused. Resume it on its display and try again."
msgstr "La impresora está en pausa. Reanúdela desde su pantalla e inténtelo de nuevo."

#: tavletta/ui/texts.py:606
msgid "The printer is out of paper. Load paper and try again."
msgstr "La impresora se ha quedado sin papel. Cargue papel e inténtelo de nuevo."

#: tavletta/ui/texts.py:608
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Hay un atasco de papel. Retírelo como indica la pantalla de la impresora e inténtelo de nuevo."

#: tavletta/ui/texts.py:610
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "La impresora se ha quedado sin tóner o tinta. Sustitúyalo e inténtelo de nuevo."

#: tavletta/ui/texts.py:611
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "La impresora no puede imprimir este tamaño. Elija un tamaño de papel que ofrezca."

#: tavletta/ui/texts.py:613
msgid ""
"The printer takes none of the formats Tavletta can send (PDF, PWG Raster, "
"JPEG)."
msgstr "La impresora no acepta ninguno de los formatos que Tavletta puede enviar (PDF, PWG Raster, JPEG)."

#: tavletta/ui/texts.py:616
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "La cola de la impresora está en pausa. Reanúdela en los ajustes de impresoras del sistema e inténtelo de nuevo."

#: tavletta/ui/texts.py:620
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "El trabajo de impresión quedó retenido en la cola, por ejemplo hasta que se libere o se introduzca una contraseña. Revise la cola en los ajustes de impresoras del sistema e inténtelo de nuevo."

#: tavletta/ui/texts.py:624
msgid "The print job was canceled at the printer or in the queue."
msgstr "El trabajo de impresión se canceló en la impresora o en la cola."

#: tavletta/ui/texts.py:625
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "La impresora no ha informado de su resolución a tiempo. Elíjala en «%s»."

#: tavletta/ui/texts.py:628
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "El rollo cargado no corresponde a la etiqueta. Cargue un rollo adecuado o elija el tamaño de etiqueta o el modelo de impresora del rollo cargado."

#: tavletta/ui/texts.py:631
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "La batería de la impresora está baja – cárguela o conecte el adaptador de corriente."

#: tavletta/ui/texts.py:632
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "El cabezal de impresión está demasiado caliente. Espere a que se enfríe e inténtelo de nuevo."

#: tavletta/ui/texts.py:634
msgid ""
"Tavletta cannot print on this printer model: it does not take the raster "
"images Tavletta sends."
msgstr "Tavletta no puede imprimir en este modelo de impresora: no acepta las imágenes rasterizadas que envía Tavletta."

#: tavletta/ui/texts.py:638
msgid "Tavletta does not know this printer model and cannot print on it yet."
msgstr "Tavletta no conoce este modelo de impresora y todavía no puede imprimir en él."

#: tavletta/ui/texts.py:641
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "La impresora está en modo Editor Lite y aparece como unidad USB. Desactive Editor Lite en la impresora (su luz se apaga) y vuelva a buscar."

#: tavletta/ui/texts.py:645
msgid ""
"Tavletta is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Tavletta no tiene permiso para usar el puerto USB de la impresora. Añada su usuario al grupo «lp» (sudo usermod -aG lp $USER) y vuelva a iniciar sesión."

#: tavletta/ui/texts.py:649
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "La página es demasiado grande para generarla con la resolución que admite la impresora. Elija un tamaño de papel más pequeño o imprima en una impresora que admita PDF."

#: tavletta/ui/texts.py:653
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Un código no cabe en la etiqueta con la resolución de esta impresora y quedaría cortado. Amplía la etiqueta o acorta el contenido del código."

#: tavletta/ui/texts.py:657
msgid ""
"Tavletta is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "Tavletta no tiene permiso para usar el puerto serie de la impresora. Añada su usuario al grupo «dialout» (sudo usermod -aG dialout $USER; en Arch Linux el grupo se llama «uucp») y vuelva a iniciar sesión."

#: tavletta/ui/texts.py:662
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "La impresora informó de un problema. Apáguela y vuelva a encenderla, y luego inténtelo otra vez."

#: tavletta/ui/texts.py:673 tavletta/server/web/ui.js:452
msgid "Printed"
msgstr "Impreso"

#: tavletta/ui/texts.py:679
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Enviado a la impresora: se imprimirá cuando le llegue el turno"

#: tavletta/ui/texts.py:681
msgid "Sent to the printer – it did not confirm printing"
msgstr "Enviado a la impresora – no confirmó la impresión"

#: tavletta/ui/texts.py:685
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "Impreso con «%(used)s», como lo requiere el rollo cargado"

#: tavletta/ui/texts.py:689
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "El modo de color «%(wanted)s» no está disponible en esta impresora; se imprimió con «%(used)s»"

#: tavletta/ui/texts.py:699
msgid "Warming up…"
msgstr "Calentando…"

#: tavletta/ui/texts.py:700
msgid "Cooling down…"
msgstr "Enfriando…"

#: tavletta/ui/texts.py:701
msgid "Cleaning…"
msgstr "Limpiando…"

#: tavletta/ui/texts.py:702
msgid "Swipe the printer's panel to cut the label"
msgstr "Deslice el panel de la impresora para cortar la etiqueta"

#: tavletta/ui/texts.py:704
msgid "Out of paper – load paper to continue"
msgstr "Sin papel: cargue papel para continuar"

#: tavletta/ui/texts.py:705
msgid "Cover open – close it to continue"
msgstr "Tapa abierta: ciérrela para continuar"

#: tavletta/ui/texts.py:706
msgid "Paper jammed – remove it to continue"
msgstr "Atasco de papel: retírelo para continuar"

#: tavletta/ui/texts.py:717
msgid "This label needs a newer version of Tavletta"
msgstr "Esta etiqueta necesita una versión más reciente de Tavletta"

#: tavletta/ui/texts.py:719
#, python-format
msgid "%s is not a Tavletta label"
msgstr "%s no es una etiqueta de Tavletta"

#: tavletta/ui/texts.py:720 tavletta/ui/texts.py:740
#: tavletta/server/service.py:914
#, python-format
msgid "The file is damaged: %s"
msgstr "El archivo está dañado: %s"

#: tavletta/ui/texts.py:727
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "El archivo de datos %s ya no está. Vuelva a elegirlo o quítelo."

#: tavletta/ui/texts.py:731
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s no tiene ninguna hoja llamada %(sheet)s"

#: tavletta/ui/texts.py:733
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s no es una tabla. Use un archivo CSV, ODS o XLSX."

#: tavletta/ui/texts.py:735
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s es demasiado grande para etiquetas en serie. Divídalo en archivos más pequeños o quite las filas y columnas que no necesite."

#: tavletta/ui/texts.py:738
#, python-format
msgid "%s contains no data."
msgstr "%s no contiene datos."

#: tavletta/ui/texts.py:749
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "La impresión se detuvo en la fila %(row)d. Para continuar, vuelva a imprimir desde la fila %(row)d."

#: tavletta/ui/texts.py:753
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "Copias de la fila %(row)d ya impresas: %(copies)d."

#: tavletta/ui/texts.py:758
#, python-format
msgid "Row %(row)d goes at position %(position)d of sheet %(sheet)d."
msgstr "La fila %(row)d va en la posición %(position)d de la hoja %(sheet)d."

#: tavletta/ui/texts.py:769
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "No se puede guardar %s: no tiene permiso de escritura"

#: tavletta/ui/texts.py:771
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "No se puede guardar %s: el disco está lleno"

#: tavletta/ui/texts.py:781
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Este casete parece ser de %(month)s %(year)d. El papel ZINK antiguo imprime colores más pálidos."

#: tavletta/ui/variables.py:24
msgid "Date"
msgstr "Fecha"

#: tavletta/ui/variables.py:25
msgid "Best before (in 30 days)"
msgstr "Consumir preferentemente antes de (en 30 días)"

#: tavletta/ui/variables.py:26
msgid "Time"
msgstr "Hora"

#: tavletta/ui/variables.py:27 tavletta/ui/variables.py:113
msgid "Counter"
msgstr "Contador"

#: tavletta/ui/variables.py:28
msgid "Counter with leading zeros"
msgstr "Contador con ceros a la izquierda"

#: tavletta/ui/variables.py:29
msgid "Copy number"
msgstr "Número de copia"

#: tavletta/ui/variables.py:30
msgid "Number of copies"
msgstr "Número de copias"

#: tavletta/ui/variables.py:31
msgid "Random ID"
msgstr "ID aleatorio"

#: tavletta/ui/variables.py:41
msgid "Insert variable"
msgstr "Insertar variable"

#: tavletta/ui/variables.py:67
msgid ""
"Variables are filled in when printing. Every printed label gets the next "
"counter value, also from copy to copy. The preview shows the values of the "
"next print."
msgstr "Las variables se rellenan al imprimir. Cada etiqueta impresa recibe el siguiente valor del contador, también de copia en copia. La vista previa muestra los valores de la siguiente impresión."

#: tavletta/ui/variables.py:77
msgid "More about variables"
msgstr "Más información sobre las variables"

#: tavletta/ui/variables.py:113
msgid "Goes up with every printed label, by the step"
msgstr "Aumenta con cada etiqueta impresa, según el paso"

#: tavletta/ui/variables.py:119
msgid "Next number"
msgstr "Siguiente número"

#: tavletta/ui/variables.py:122 tavletta/server/web/batch.js:628
msgid "Step"
msgstr "Paso"

#: tavletta/ui/window.py:176 tavletta/server/web/app.js:49
#: tavletta/server/web/app.js:342
msgid "Templates"
msgstr "Plantillas"

#: tavletta/ui/window.py:208
msgid "Shipping label…"
msgstr "Etiqueta de envío…"

#: tavletta/ui/window.py:211
msgid "Data for serial labels…"
msgstr "Datos para etiquetas en serie…"

#: tavletta/ui/window.py:212
msgid "Forget allowed data files"
msgstr "Olvidar los archivos de datos permitidos"

#: tavletta/ui/window.py:213
msgid "Export PNG…"
msgstr "Exportar como PNG…"

#: tavletta/ui/window.py:217
msgid "Report a problem…"
msgstr "Informar de un problema…"

#: tavletta/ui/window.py:218
msgid "About Tavletta"
msgstr "Acerca de Tavletta"

#: tavletta/ui/window.py:743
msgid "Unsaved label"
msgstr "Etiqueta sin guardar"

#: tavletta/ui/window.py:915
msgid "content scaled down to fit"
msgstr "contenido reducido para que quepa"

#: tavletta/ui/window.py:919
#, python-format
msgid "Problem: %s"
msgstr "Problema: %s"

#: tavletta/ui/window.py:938
#, python-format
msgid "Too long for this printer: at most %s"
msgstr "Demasiado larga para esta impresora: como máximo %s"

#: tavletta/ui/window.py:942
#, python-format
msgid "Too wide for this printer: at most %s"
msgstr "Demasiado ancha para esta impresora: máximo %s"

#: tavletta/ui/window.py:1020
msgid "The browser cannot be opened"
msgstr "No se puede abrir el navegador"

#: tavletta/ui/window.py:1022
msgid "Copy link"
msgstr "Copiar enlace"

#: tavletta/ui/window.py:1094
msgid "Only local files can be dropped"
msgstr "Solo se pueden soltar archivos locales"

#: tavletta/ui/window.py:1147
msgid "Please wait until printing has finished"
msgstr "Espere a que termine la impresión"

#: tavletta/server/config.py:79
#, python-format
msgid "%(file)s: %(key)s: %(problem)s"
msgstr "%(file)s: %(key)s: %(problem)s"

#: tavletta/server/config.py:89 tavletta/server/config.py:93
#: tavletta/server/config.py:99 tavletta/server/main.py:383
#, python-format
msgid "Cannot read %(file)s: %(reason)s"
msgstr "No se puede leer %(file)s: %(reason)s"

#: tavletta/server/config.py:109
msgid "expected a table"
msgstr "se esperaba una tabla"

#: tavletta/server/config.py:119 tavletta/server/config.py:455
#: tavletta/server/oidc.py:226 tavletta/server/oidc.py:318
msgid "missing"
msgstr "falta"

#: tavletta/server/config.py:122
msgid "expected text"
msgstr "se esperaba texto"

#: tavletta/server/config.py:124
msgid "control characters are not allowed"
msgstr "no se permiten caracteres de control"

#: tavletta/server/config.py:130
msgid "expected true or false"
msgstr "se esperaba true o false"

#: tavletta/server/config.py:141
#, python-format
msgid "expected a number from %(min)s to %(max)s"
msgstr "se esperaba un número de %(min)s a %(max)s"

#: tavletta/server/config.py:148
#, python-format
msgid "expected one of: %s"
msgstr "se esperaba uno de: %s"

#: tavletta/server/config.py:153 tavletta/server/config.py:159
#: tavletta/server/oidc.py:287
msgid "unknown key"
msgstr "clave desconocida"

#: tavletta/server/config.py:162
msgid "nothing defined"
msgstr "no hay nada definido"

#: tavletta/server/config.py:168
msgid "not a valid name: letters, digits, . _ - (up to 64)"
msgstr "no es un nombre válido: letras, dígitos, . _ - (hasta 64)"

#: tavletta/server/config.py:209
msgid "only one printer can be the default"
msgstr "solo una impresora puede ser la predeterminada"

#: tavletta/server/config.py:223
msgid "not a valid printer address"
msgstr "no es una dirección de impresora válida"

#: tavletta/server/config.py:245
msgid "this printer model does not cut"
msgstr "este modelo de impresora no corta"

