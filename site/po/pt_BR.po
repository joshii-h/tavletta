msgid "`PUT /api/v1/labels/{name}` { #put-labels-name }"
msgstr "`PUT /api/v1/labels/{name}` { #put-labels-name }"

#. type: Plain text
#: docs/api.md
msgid ""
"Upload a label file (admin): checked as the app opens a file, then put into "
"the labels folder in one step."
msgstr ""
"Enviar um arquivo de etiqueta (admin): verificado como a aplicativo abre um "
"arquivo e depois colocado na pasta de etiquetas num só passo."

#. type: Bullet: '- '
#: docs/api.md
