#, python-format
msgid "Element %(n)d: Code 128 holds at most %(max)d characters"
msgstr "العنصر %(n)d: يتسع Code 128 لـ %(max)d حرفًا كحد أقصى"

#: tavletta/ui/texts.py:383
#, python-format
msgid ""
"Element %(n)d: the bars are too thin to scan reliably – use a longer or "
"larger label, or shorter content"
msgstr "العنصر %(n)d: الأشرطة أرق من أن تُمسح بشكل موثوق – استخدم ملصقًا أطول أو أكبر، أو محتوى أقصر"

#: tavletta/ui/texts.py:387
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "العنصر %(n)d: لا يقبل Code 128 إلا الحروف اللاتينية والأرقام وعلامات الترقيم"

#: tavletta/ui/texts.py:389
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "العنصر %(n)d: يتطلب EAN-8 7 أرقام، أو 8 مع رقم التحقق"

#: tavletta/ui/texts.py:390
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "العنصر %(n)d: يتطلب UPC-A 11 رقمًا، أو 12 مع رقم التحقق"

#: tavletta/ui/texts.py:392
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "العنصر %(n)d: يتطلب UPC-E 7 أرقام تبدأ بـ 0 أو 1، أو 8 مع رقم التحقق"

#: tavletta/ui/texts.py:394
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "العنصر %(n)d: يتطلب ITF-14 13 رقمًا، أو 14 مع رقم التحقق"

#: tavletta/ui/texts.py:395
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "العنصر %(n)d: رقم التحقق غير صحيح"

#: tavletta/ui/texts.py:397
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "العنصر %(n)d: لا يقبل Code 39 إلا الحروف الكبيرة والأرقام والمسافات و - . $ / + %%"

#: tavletta/ui/texts.py:400
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "العنصر %(n)d: لا يقبل Code 93 إلا الحروف اللاتينية والأرقام وعلامات الترقيم"

#: tavletta/ui/texts.py:403
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "العنصر %(n)d: لا تقبل بيانات GS1 إلا الحروف اللاتينية والأرقام وعلامات الترقيم"

#: tavletta/ui/texts.py:406
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "العنصر %(n)d: يجب أن تتكون بيانات GS1 من معرّفات التطبيق بين قوسين، يتبع كلًّا منها قيمته، مثل (01)09501101530003(10)AB12"

#: tavletta/ui/texts.py:409
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "العنصر %(n)d: (%(ai)s) ليس معرّف تطبيق GS1"

#: tavletta/ui/texts.py:411
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "العنصر %(n)d: طول قيمة معرّف التطبيق (%(ai)s) غير صحيح"

#: tavletta/ui/texts.py:414
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "العنصر %(n)d: رقم التحقق لمعرّف التطبيق (%(ai)s) غير صحيح"

#: tavletta/ui/texts.py:417
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "العنصر %(n)d: قيمة معرّف التطبيق (%(ai)s) غير صالحة: تاريخ أو رقم أو حرف لا يسمح به"

#: tavletta/ui/texts.py:421
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "العنصر %(n)d: لا يوجد رقم UPC-A يُختصر إلى أرقام UPC-E هذه – تحقق منها أو استخدم UPC-A"

#: tavletta/ui/texts.py:425
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "العنصر %(n)d: الماسحات المضبوطة على Full ASCII تقرأ $ أو / أو + أو %% قبل حرف كبير كحرف آخر"

#: tavletta/ui/texts.py:428
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "العنصر %(n)d: المحتوى طويل جدًا لهذا النوع من الرموز"

#: tavletta/ui/texts.py:429
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "العنصر %(n)d: يتعذّر ترميز المحتوى في هذا النوع من الرموز"

#: tavletta/ui/texts.py:431
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "العنصر %(n)d: يتطلب هذا النوع من الرموز مكتبة Zint (zint-bindings)، وهي غير مثبّتة"

#: tavletta/ui/texts.py:434
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "العنصر %(n)d: تعذّرت قراءة الصورة"

#: tavletta/ui/texts.py:435
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "العنصر %(n)d: هذه الأيقونة ليست في مكتبة الأيقونات"

#: tavletta/ui/texts.py:436
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "العنصر %(n)d: تعذّرت قراءة المستند"

#: tavletta/ui/texts.py:438
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "العنصر %(n)d: تحتاج ملفات PDF إلى Poppler ‏(poppler-glib)، وهو غير مثبّت"

#: tavletta/ui/texts.py:440
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "تعذّر رسم العنصر %(n)d"

#: tavletta/ui/texts.py:442
#, python-format
msgid ""
"Element %(n)d: the text is too long to be drawn in one line – break it into "
"lines or shorten it"
msgstr "العنصر %(n)d: النص أطول من أن يُرسم في سطر واحد – قسّمه إلى أسطر أو اختصره"

#: tavletta/ui/texts.py:446
#, python-format
msgid ""
"Element %(n)d: the text is too tall to be drawn – use fewer lines or a "
"smaller size"
msgstr "العنصر %(n)d: النص أطول ارتفاعًا من أن يُرسم – استخدم أسطرًا أقل أو حجمًا أصغر"

#: tavletta/ui/texts.py:449
#, python-format
msgid ""
"Element %(n)d: the font %(font)s is not installed – another font is used"
msgstr "العنصر %(n)d: الخط %(font)s غير مثبّت – يُستخدم خط آخر"

#: tavletta/ui/texts.py:452
msgid ""
"Safety margin, border, its inset and edge spacing leave no room – reduce them"
msgstr "لا يترك هامش الأمان والإطار وإزاحته للداخل وتباعد الحواف أي مساحة – قلّلها"

#: tavletta/ui/texts.py:454
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "الطول الثابت أقصر من التباعد – زِده"

#: tavletta/ui/texts.py:455
msgid "The background image cannot be read"
msgstr "تعذّرت قراءة صورة الخلفية"

#: tavletta/ui/texts.py:457
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "العنصر %(n)d: وحدات الرمز بعرض نقطة طباعة واحدة فقط وقد لا يمكن مسحها – كبّر الرمز"

#: tavletta/ui/texts.py:461
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "العنصر %(n)d: المساحة الفارغة التي يحتاجها الرمز حوله لا تتسع – كبّر الرمز"

#: tavletta/ui/texts.py:465
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "العنصر %(n)d: لا يتسع الرمز في مكانه حتى بنقطة طباعة واحدة لكل وحدة – كبّر الملصق أو اختصر المحتوى"

#: tavletta/ui/texts.py:468
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "العنصر %(n)d: %(name)s ليس متغيرًا معروفًا"

#: tavletta/ui/texts.py:470
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "العنصر %(n)d: تاريخ %(name)s قبل السنة 1 أو بعد 9999"

#: tavletta/ui/texts.py:473
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "العنصر %(n)d: المتغير %(name)s… غير مغلق – أنهِه بـ }"

#: tavletta/ui/texts.py:476
#, python-format
msgid ""
"Element %(n)d: on a black-and-white printer it hardly stands out from what "
"lies behind it, as a whole or in part – choose another colour or move it"
msgstr "العنصر %(n)d: لا يكاد يتميّز في الطابعة بالأبيض والأسود عمّا خلفه، كليًا أو جزئيًا – اختر لونًا آخر أو انقله"

#: tavletta/ui/texts.py:479
#, python-format
msgid "Element %(n)d: the shape has neither a line nor a fill"
msgstr "العنصر %(n)d: الشكل بلا خط ولا تعبئة"

#: tavletta/ui/texts.py:481
#, python-format
msgid ""
"Element %(n)d reaches beyond the edge of the label and is cut off there – "
"move it or make it smaller"
msgstr "العنصر %(n)d يتجاوز حافة الملصق ويُقص هناك – انقله أو صغّره"

#: tavletta/ui/texts.py:485
#, python-format
msgid ""
"Element %(n)d: the padding, frame, outline or shadow leave no room for the "
"text – make them smaller"
msgstr "العنصر %(n)d: لا يترك الحشو أو الإطار أو الحد الخارجي أو الظل أي مساحة للنص – قلّلها"

#: tavletta/ui/texts.py:500
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "الأوراق المطبوعة بالفعل: %(n)d من %(total)d."

#: tavletta/ui/texts.py:502
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "الملصقات المطبوعة بالفعل: %(n)d من %(total)d."

#: tavletta/ui/texts.py:506
msgid "The sheets still waiting in the queue were canceled."
msgstr "أُلغيت الأوراق التي كانت لا تزال تنتظر في قائمة الانتظار."

#: tavletta/ui/texts.py:508
msgid "The labels still waiting in the queue were canceled."
msgstr "أُلغيت الملصقات التي كانت لا تزال تنتظر في قائمة الانتظار."

#: tavletta/ui/texts.py:519
#, python-format
msgid ""
"The label is %(size)s, but labels of %(loaded)s are loaded. Check the label "
"size, or load the matching roll."
msgstr "حجم الملصق %(size)s، لكن الملصقات الموضوعة بحجم %(loaded)s. تحقق من حجم الملصق أو ضع الرول المناسب."

#: tavletta/ui/texts.py:527
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap, or calibrate the printer."
msgstr "حجم الملصق %(size)s مع فراغ %(gap)s، لذا يبدأ ملصق جديد كل %(pitch)s. قاست الطابعة ملصقًا كل %(measured)s. تحقق من حجم الملصق والفراغ، أو قم بمعايرة الطابعة."

#: tavletta/ui/texts.py:533
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap."
msgstr "حجم الملصق %(size)s مع فراغ %(gap)s، لذا يبدأ ملصق جديد كل %(pitch)s. قاست الطابعة ملصقًا كل %(measured)s. تحقق من حجم الملصق والفراغ."

#: tavletta/ui/texts.py:550
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "تعذّر العثور على الطابعة. تأكّد من أنها قيد التشغيل وعلى الشبكة نفسها، أو أدخل عنوان IP الخاص بها."

#: tavletta/ui/texts.py:554
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "لا يمكن العثور على الطابعة عبر USB. تحقّق من الكابل ومن أن الطابعة قيد التشغيل وليست في وضع السكون، ثم ابحث مجددًا."

#: tavletta/ui/texts.py:557
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "الطابعة لا تستجيب. تأكّد من أنها قيد التشغيل وليست في وضع السكون."

#: tavletta/ui/texts.py:559
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "توقفت الطابعة عن استقبال البيانات. تحقّق مما إذا كانت تعرض مشكلة، مثل نفاد الملصقات أو غطاء مفتوح، ثم حاول مرة أخرى."

#: tavletta/ui/texts.py:563
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "ترفض الطابعة الاتصال. أطفئها ثم شغّلها مجددًا. إن كانت واجهة الويب الخاصة بها توفّر خيار «Port 9100»، ففعّله."

#: tavletta/ui/texts.py:566
msgid "No cassette is inserted. Insert one and try again."
msgstr "لا توجد خرطوشة. أدخل خرطوشة وحاول مجددًا."

#: tavletta/ui/texts.py:567
msgid "The printer's cover is open. Close it and try again."
msgstr "غطاء الطابعة مفتوح. أغلقه وحاول مجددًا."

#: tavletta/ui/texts.py:568
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "الملصق عالق. افتح الغطاء وأزل الملصق ثم حاول مجددًا."

#: tavletta/ui/texts.py:569
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "لم يتم التعرّف على الخرطوشة. أعد إدخالها أو جرّب خرطوشة أخرى."

#: tavletta/ui/texts.py:570
msgid "The printer is busy. Wait a moment and try again."
msgstr "الطابعة مشغولة. انتظر قليلًا وحاول مجددًا."

#: tavletta/ui/texts.py:571
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "الملصق طويل جدًا لهذه الطابعة: الحد الأقصى %(max)s."

#: tavletta/ui/texts.py:572
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "الملصق أعرض من أن تطبعه هذه الطابعة: الحد الأقصى %(max)s."

#: tavletta/ui/texts.py:573
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "نفدت الملصقات من الطابعة. ضع رولًا جديدًا وحاول مرة أخرى."

#: tavletta/ui/texts.py:574
msgid "The print head is open. Close it and try again."
msgstr "رأس الطباعة مفتوح. أغلقه وحاول مرة أخرى."

#: tavletta/ui/texts.py:576
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "تعذّر على الطابعة العثور على الملصق التالي. تحقق من تحميل الملصقات بشكل صحيح ومن مرورها عبر حسّاس الملصقات."

#: tavletta/ui/texts.py:580
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "توجد مشكلة في شريط الحبر. تحقق من تركيبه بشكل صحيح ومن توافقه مع طريقة الطباعة المضبوطة على الطابعة."

#: tavletta/ui/texts.py:586
#, python-format
msgid ""
"The printer finds no ribbon. Load a ribbon and try again. Labels that print "
"without one need “%(direct)s” under “%(method)s”."
msgstr "لا تجد الطابعة شريط حبر. ركّب شريطًا وحاول مرة أخرى. الملصقات التي تُطبع بلا شريط تحتاج إلى «%(direct)s» في «%(method)s»."

#: tavletta/ui/texts.py:593
#, python-format
msgid ""
"A ribbon is loaded, but the printer prints without it (thermal direct). For "
"labels that need the ribbon choose “%(transfer)s” under “%(method)s”, or "
"remove the ribbon."
msgstr "شريط الحبر مركّب، لكن الطابعة تطبع بدونه (حرارية مباشرة). للملصقات التي تحتاج إلى الشريط اختر «%(transfer)s» في «%(method)s»، أو أزل الشريط."

#: tavletta/ui/texts.py:598
msgid "The printer is paused. Resume it on its display and try again."
msgstr "الطابعة متوقفة مؤقتًا. استأنف من شاشتها وحاول مرة أخرى."

#: tavletta/ui/texts.py:599
msgid "The printer is out of paper. Load paper and try again."
msgstr "نفد الورق من الطابعة. حمّل الورق وحاول مجددًا."

#: tavletta/ui/texts.py:601
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "الورق عالق. أزله كما تعرض شاشة الطابعة وحاول مجددًا."

#: tavletta/ui/texts.py:603
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "نفد الحبر أو مسحوق الحبر من الطابعة. استبدله وحاول مجددًا."

#: tavletta/ui/texts.py:604
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "لا تستطيع الطابعة طباعة هذا الحجم. اختر حجم ورق تدعمه."

#: tavletta/ui/texts.py:606
msgid ""
"The printer takes none of the formats Tavletta can send (PDF, PWG Raster, "
"JPEG)."
msgstr "لا تقبل الطابعة أيًّا من الصيغ التي يستطيع Tavletta إرسالها (PDF وPWG Raster وJPEG)."

#: tavletta/ui/texts.py:609
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "قائمة انتظار الطابعة متوقفة مؤقتًا. استأنفها من إعدادات الطابعة في النظام وحاول مجددًا."

#: tavletta/ui/texts.py:613
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "احتُجزت مهمة الطباعة في قائمة الانتظار، مثلًا إلى أن يُفرج عنها أو تُدخل كلمة مرور. تحقق من قائمة الانتظار في إعدادات الطابعة في النظام وحاول مجددًا."

#: tavletta/ui/texts.py:617
msgid "The print job was canceled at the printer or in the queue."
msgstr "أُلغيت مهمة الطباعة في الطابعة أو في قائمة الانتظار."

#: tavletta/ui/texts.py:618
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "لم تُبلغ الطابعة عن دقتها في الوقت المناسب. اخترها من «%s»."

#: tavletta/ui/texts.py:621
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "الرول الموضوع لا يناسب الملصق. ضع رولًا مناسبًا، أو اختر حجم الملصق أو طراز الطابعة الخاص بالرول الموضوع."

#: tavletta/ui/texts.py:624
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "بطارية الطابعة منخفضة – اشحنها أو وصّل محوّل الطاقة."

#: tavletta/ui/texts.py:625
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "رأس الطباعة ساخن جدًا. انتظر حتى يبرد، ثم حاول مرة أخرى."

#: tavletta/ui/texts.py:627
msgid ""
"Tavletta cannot print on this printer model: it does not take the raster "
"images Tavletta sends."
msgstr "لا يستطيع Tavletta الطباعة على طراز الطابعة هذا: فهو لا يقبل الصور النقطية التي يرسلها Tavletta."

#: tavletta/ui/texts.py:631
msgid "Tavletta does not know this printer model and cannot print on it yet."
msgstr "لا يعرف Tavletta طراز الطابعة هذا ولا يستطيع الطباعة عليه بعد."

#: tavletta/ui/texts.py:634
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "الطابعة في وضع Editor Lite وتظهر كمحرك أقراص USB. أوقف Editor Lite في الطابعة (ينطفئ مصباحه)، ثم ابحث مرة أخرى."

#: tavletta/ui/texts.py:638
msgid ""
"Tavletta is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "لا يملك Tavletta إذن استخدام منفذ USB الخاص بالطابعة. أضف المستخدم الخاص بك إلى المجموعة «lp» (sudo usermod -aG lp $USER)، ثم سجّل الخروج وسجّل الدخول مجددًا."

#: tavletta/ui/texts.py:642
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "الصفحة أكبر من أن تُنشأ بالدقة التي تقبلها الطابعة. اختر حجم ورق أصغر، أو اطبع على طابعة تقبل PDF."

#: tavletta/ui/texts.py:646
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "لا يتسع الرمز على الملصق بدقة هذه الطابعة وسيُقطع. كبّر الملصق أو اختصر محتوى الرمز."

#: tavletta/ui/texts.py:650
msgid ""
"Tavletta is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "لا يملك Tavletta إذن استخدام المنفذ التسلسلي الخاص بالطابعة. أضف المستخدم الخاص بك إلى المجموعة «dialout» (sudo usermod -aG dialout $USER؛ في Arch Linux اسم المجموعة «uucp»)، ثم سجّل الخروج وسجّل الدخول مجددًا."

#: tavletta/ui/texts.py:655
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "أبلغت الطابعة عن مشكلة. أطفئها ثم شغّلها مجددًا، ثم حاول مرة أخرى."

#: tavletta/ui/texts.py:666 tavletta/server/web/ui.js:456
msgid "Printed"
msgstr "تمت الطباعة"

#: tavletta/ui/texts.py:672
msgid "Sent to the printer – it prints when its turn comes"
msgstr "أُرسل إلى الطابعة – ستتم طباعته عندما يحين دوره"

#: tavletta/ui/texts.py:674
msgid "Sent to the printer – it did not confirm printing"
msgstr "أُرسل إلى الطابعة – لم تؤكد الطباعة"

#: tavletta/ui/texts.py:678
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "طُبع باستخدام «%(used)s» لأن الرول الموضوع يحتاج إلى ذلك"

#: tavletta/ui/texts.py:682
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "وضع الألوان «%(wanted)s» غير متاح على هذه الطابعة، طُبع باستخدام «%(used)s»"

