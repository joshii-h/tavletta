#: docs/api.md
#, no-wrap
msgid "`DELETE /api/v1/jobs/{id}` { #delete-jobs-id }"
msgstr "`DELETE /api/v1/jobs/{id}` { #delete-jobs-id }"

#. type: Plain text
#: docs/api.md
msgid ""
"Cancel a job: at once while it waits, after the current label while it "
"prints."
msgstr ""
"Cancelar um trabalho: de imediato enquanto espera, depois da etiqueta em "
"curso enquanto imprime."

#. type: Plain text
#: docs/api.md
#, no-wrap
msgid ""
"| Status | Answer | Codes |\n"
"|---|---|---|\n"
"| 202 | Canceled, or stopping after the current label |  |\n"
"| 404 | No such job | `job_not_found` |\n"
"| 409 | Already finished | `job_finished` |\n"
msgstr ""
"| Status | Resposta | Códigos |\n"
"|---|---|---|\n"
"| 202 | Cancelado, ou a parar após a etiqueta em curso |  |\n"
"| 404 | Esse trabalho não existe | `job_not_found` |\n"
"| 409 | Já terminado | `job_finished` |\n"

