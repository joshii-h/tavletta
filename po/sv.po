#, python-format
msgid "%(file)s: %(key)s: %(problem)s"
msgstr "%(file)s: %(key)s: %(problem)s"

#: tavletta/server/config.py:89 tavletta/server/config.py:93
#: tavletta/server/config.py:99 tavletta/server/main.py:344
#, python-format
msgid "Cannot read %(file)s: %(reason)s"
msgstr "Det går inte att läsa %(file)s: %(reason)s"

#: tavletta/server/config.py:109
msgid "expected a table"
msgstr "förväntade en tabell"

#: tavletta/server/config.py:119 tavletta/server/config.py:453
msgid "missing"
msgstr "saknas"

#: tavletta/server/config.py:122
msgid "expected text"
msgstr "förväntade text"

#: tavletta/server/config.py:124
msgid "control characters are not allowed"
msgstr "styrtecken är inte tillåtna"

#: tavletta/server/config.py:130
msgid "expected true or false"
msgstr "förväntade true eller false"

#: tavletta/server/config.py:141
#, python-format
msgid "expected a number from %(min)s to %(max)s"
msgstr "förväntade ett tal från %(min)s till %(max)s"

#: tavletta/server/config.py:148
#, python-format
msgid "expected one of: %s"
msgstr "förväntade ett av: %s"

#: tavletta/server/config.py:153 tavletta/server/config.py:159
msgid "unknown key"
msgstr "okänd nyckel"

#: tavletta/server/config.py:162
msgid "nothing defined"
msgstr "inget definierat"

#: tavletta/server/config.py:168
msgid "not a valid name: letters, digits, . _ - (up to 64)"
msgstr "inte ett giltigt namn: bokstäver, siffror, . _ - (högst 64)"

#: tavletta/server/config.py:209
msgid "only one printer can be the default"
msgstr "bara en skrivare kan vara standard"

#: tavletta/server/config.py:223
msgid "not a valid printer address"
msgstr "inte en giltig skrivaradress"

#: tavletta/server/config.py:245
msgid "this printer model does not cut"
msgstr "denna skrivarmodell skär inte"

#: tavletta/server/config.py:247
msgid "this printer model has no colour settings"
msgstr "denna skrivarmodell har inga färginställningar"

#: tavletta/server/config.py:408
msgid "expected a date such as 2027-12-31"
msgstr "förväntade ett datum som 2027-12-31"

#: tavletta/server/config.py:427
msgid "the same token twice"
msgstr "samma token två gånger"

#: tavletta/server/config.py:440
#, python-format
msgid "%s can be changed by every user of this computer: chmod 600 it"
msgstr "%s kan ändras av alla användare på den här datorn: kör chmod 600 på den"

#: tavletta/server/config.py:450
msgid "not a token hash: expected sha256:… or scrypt:…"
msgstr "inte en tokenhash: förväntade sha256:… eller scrypt:…"

#: tavletta/server/config.py:476
msgid "expected a list of printer names"
msgstr "förväntade en lista med skrivarnamn"

#: tavletta/server/config.py:480 tavletta/server/main.py:370
msgid "printers can only be limited with --printers"
msgstr "skrivare kan bara begränsas med --printers"

#: tavletta/server/config.py:482 tavletta/server/service.py:551
#, python-format
msgid "Unknown printer: %s"
msgstr "Okänd skrivare: %s"

#: tavletta/server/errors.py:29
#, python-format
msgid "Invalid value for %s"
msgstr "Ogiltigt värde för %s"

#: tavletta/server/http.py:469 tavletta/server/http.py:518
