msgid "None"
msgstr "Ei mitään"

#: tavletta/ui/texts.py:191
msgid "At the start"
msgstr "Alussa"

#: tavletta/ui/texts.py:192
msgid "At the end"
msgstr "Lopussa"

#: tavletta/ui/texts.py:193
msgid "At both ends"
msgstr "Molemmissa päissä"

#: tavletta/ui/texts.py:196
