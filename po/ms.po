#, python-format
msgid "%s, continuous rolls"
msgstr "%s, gulungan berterusan"

#. translators: %s is a printer model, e.g. "Brother QL"
#: tavletta/ui/texts.py:366
#, python-format
msgid "%s, die-cut labels"
msgstr "%s, label pra-potong"

#: tavletta/ui/texts.py:389
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Elemen %(n)d: kod kosong"

#: tavletta/ui/texts.py:390
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Elemen %(n)d: EAN-13 memerlukan tepat 12 digit"

#: tavletta/ui/texts.py:391
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Elemen %(n)d: digit semak EAN-13 salah"

#: tavletta/ui/texts.py:392
#, python-format
msgid "Element %(n)d: Code 128 holds at most %(max)d characters"
msgstr "Elemen %(n)d: Code 128 memuatkan paling banyak %(max)d aksara"

#: tavletta/ui/texts.py:394
#, python-format
msgid ""
"Element %(n)d: the bars are too thin to scan reliably – use a longer or "
"larger label, or shorter content"
msgstr "Elemen %(n)d: bar terlalu nipis untuk diimbas dengan andal – gunakan label yang lebih panjang atau lebih besar, atau kandungan yang lebih pendek"

#: tavletta/ui/texts.py:398
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Elemen %(n)d: Code 128 hanya menerima huruf Latin, digit dan tanda baca"

#: tavletta/ui/texts.py:400
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Elemen %(n)d: EAN-8 memerlukan 7 digit, atau 8 digit dengan digit semak"

#: tavletta/ui/texts.py:401
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "Elemen %(n)d: UPC-A memerlukan 11 digit, atau 12 digit dengan digit semak"

#: tavletta/ui/texts.py:403
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "Elemen %(n)d: UPC-E memerlukan 7 digit bermula dengan 0 atau 1, atau 8 digit dengan digit semak"

#: tavletta/ui/texts.py:405
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "Elemen %(n)d: ITF-14 memerlukan 13 digit, atau 14 digit dengan digit semak"

#: tavletta/ui/texts.py:406
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "Elemen %(n)d: digit semak salah"

#: tavletta/ui/texts.py:408
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Elemen %(n)d: Code 39 hanya menerima huruf besar, digit, ruang dan - . $ / + %%"

#: tavletta/ui/texts.py:411
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Elemen %(n)d: Code 93 hanya menerima huruf Latin, digit dan tanda baca"

#: tavletta/ui/texts.py:414
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Elemen %(n)d: data GS1 hanya menerima huruf Latin, digit dan tanda baca"

#: tavletta/ui/texts.py:417
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Elemen %(n)d: data GS1 mestilah pengecam aplikasi dalam kurungan, setiap satu diikuti oleh nilainya, cth. (01)09501101530003(10)AB12"

#: tavletta/ui/texts.py:420
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Elemen %(n)d: (%(ai)s) bukan pengecam aplikasi GS1"

#: tavletta/ui/texts.py:422
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Elemen %(n)d: panjang nilai pengecam aplikasi (%(ai)s) salah"

#: tavletta/ui/texts.py:425
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Elemen %(n)d: digit semak pengecam aplikasi (%(ai)s) salah"

#: tavletta/ui/texts.py:428
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Elemen %(n)d: nilai pengecam aplikasi (%(ai)s) tidak sah: mengandungi tarikh, nombor atau aksara yang tidak dibenarkan"

#: tavletta/ui/texts.py:432
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Elemen %(n)d: tiada nombor UPC-A yang dipendekkan kepada digit UPC-E ini – semak atau gunakan UPC-A"

#: tavletta/ui/texts.py:436
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Elemen %(n)d: pengimbas yang ditetapkan kepada Full ASCII membaca $, /, + atau %% sebelum huruf besar sebagai aksara lain"

#: tavletta/ui/texts.py:439
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Elemen %(n)d: kandungan terlalu panjang untuk jenis kod ini"

#: tavletta/ui/texts.py:440
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Elemen %(n)d: kandungan tidak dapat dikodkan dalam jenis kod ini"

#: tavletta/ui/texts.py:442
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Elemen %(n)d: jenis kod ini memerlukan pustaka Zint (zint-bindings), yang tidak dipasang"

#: tavletta/ui/texts.py:445
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Elemen %(n)d: imej tidak dapat dibaca"

#: tavletta/ui/texts.py:446
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Elemen %(n)d: simbol ini tiada dalam pustaka simbol"

#: tavletta/ui/texts.py:447
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Elemen %(n)d: dokumen tidak dapat dibaca"

#: tavletta/ui/texts.py:449
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Elemen %(n)d: fail PDF memerlukan Poppler (poppler-glib), yang tidak dipasang"

#: tavletta/ui/texts.py:451
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Elemen %(n)d tidak dapat dilukis"

#: tavletta/ui/texts.py:453
#, python-format
msgid ""
"Element %(n)d: the text is too long to be drawn in one line – break it into "
"lines or shorten it"
msgstr "Elemen %(n)d: teks terlalu panjang untuk dilukis dalam satu baris – pecahkan kepada beberapa baris atau pendekkan"

#: tavletta/ui/texts.py:457
#, python-format
msgid ""
"Element %(n)d: the text is too tall to be drawn – use fewer lines or a "
"smaller size"
msgstr "Elemen %(n)d: teks terlalu tinggi untuk dilukis – gunakan lebih sedikit baris atau saiz yang lebih kecil"

#: tavletta/ui/texts.py:460
#, python-format
msgid ""
"Element %(n)d: the font %(font)s is not installed – another font is used"
msgstr "Elemen %(n)d: fon %(font)s tidak dipasang – fon lain digunakan"

#: tavletta/ui/texts.py:463
msgid ""
"Safety margin, border, its inset and edge spacing leave no room – reduce them"
msgstr "Jidar keselamatan, sempadan, jarak ke dalamnya dan jarak tepi tidak meninggalkan ruang – kurangkan nilainya"

#: tavletta/ui/texts.py:465
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "Panjang tetap lebih pendek daripada jarak – tambahkan panjangnya"

#: tavletta/ui/texts.py:466
msgid "The background image cannot be read"
msgstr "Imej latar tidak dapat dibaca"

#: tavletta/ui/texts.py:468
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Elemen %(n)d: modul kod hanya selebar satu titik cetak dan mungkin tidak dapat diimbas – besarkan kod"

#: tavletta/ui/texts.py:472
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Elemen %(n)d: ruang kosong yang diperlukan di sekeliling kod tidak muat – besarkan kod"

#: tavletta/ui/texts.py:476
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Elemen %(n)d: kod tidak muat di ruangnya, walaupun dengan satu titik cetak setiap modul – besarkan label atau pendekkan kandungan"

#: tavletta/ui/texts.py:479
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Elemen %(n)d: %(name)s bukan pemboleh ubah yang diketahui"

#: tavletta/ui/texts.py:481
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Elemen %(n)d: tarikh %(name)s sebelum tahun 1 atau selepas 9999"

#: tavletta/ui/texts.py:484
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Elemen %(n)d: pemboleh ubah %(name)s… tidak ditutup – akhirinya dengan }"

#: tavletta/ui/texts.py:487
#, python-format
msgid ""
"Element %(n)d: on a black-and-white printer it hardly stands out from what "
"lies behind it, as a whole or in part – choose another colour or move it"
msgstr "Elemen %(n)d: pada pencetak hitam putih, elemen ini hampir tidak menonjol daripada apa yang di belakangnya, sepenuhnya atau sebahagiannya – pilih warna lain atau alihkannya"

#: tavletta/ui/texts.py:490
#, python-format
msgid "Element %(n)d: the shape has neither a line nor a fill"
msgstr "Elemen %(n)d: bentuk ini tiada garisan mahupun isian"

#: tavletta/ui/texts.py:492
#, python-format
msgid ""
"Element %(n)d reaches beyond the edge of the label and is cut off there – "
"move it or make it smaller"
msgstr "Elemen %(n)d melepasi tepi label dan terpotong di situ – alihkannya atau kecilkannya"

#: tavletta/ui/texts.py:496
#, python-format
msgid ""
"Element %(n)d: the padding, frame, outline or shadow leave no room for the "
"text – make them smaller"
msgstr "Elemen %(n)d: lapik, bingkai, garis luar atau bayang tidak meninggalkan ruang untuk teks – kecilkan nilainya"

#: tavletta/ui/texts.py:515
#, python-format
msgid ""
"The job was sent, but its outcome is unknown: %(n)d of %(total)d labels "
"printed for certain, up to %(most)d may have."
msgstr "Kerja telah dihantar, tetapi hasilnya tidak diketahui: %(n)d daripada %(total)d label pasti dicetak, sehingga %(most)d mungkin."

#: tavletta/ui/texts.py:520
#, python-format
msgid ""
"The job was sent, but its outcome is unknown: up to %(most)d of %(total)d "
"labels may have printed."
msgstr "Kerja telah dihantar, tetapi hasilnya tidak diketahui: sehingga %(most)d daripada %(total)d label mungkin telah dicetak."

#: tavletta/ui/texts.py:526
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Helaian yang sudah dicetak: %(n)d daripada %(total)d."

#: tavletta/ui/texts.py:528
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Label yang sudah dicetak: %(n)d daripada %(total)d."

#: tavletta/ui/texts.py:532
msgid "The sheets still waiting in the queue were canceled."
msgstr "Helaian yang masih menunggu dalam baris gilir telah dibatalkan."

#: tavletta/ui/texts.py:534
msgid "The labels still waiting in the queue were canceled."
msgstr "Label yang masih menunggu dalam baris gilir telah dibatalkan."

#: tavletta/ui/texts.py:545
#, python-format
msgid ""
"The label is %(size)s, but labels of %(loaded)s are loaded. Check the label "
"size, or load the matching roll."
msgstr "Label bersaiz %(size)s, tetapi label %(loaded)s dimasukkan. Semak saiz label, atau masukkan gulungan yang sepadan."

#: tavletta/ui/texts.py:553
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap, or calibrate the printer."
msgstr "Label berukuran %(size)s dengan jurang %(gap)s, jadi label baharu bermula setiap %(pitch)s. Pencetak mengukur satu label setiap %(measured)s. Semak saiz label dan jurang, atau tentukur pencetak."

#: tavletta/ui/texts.py:559
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap."
msgstr "Label berukuran %(size)s dengan jurang %(gap)s, jadi label baharu bermula setiap %(pitch)s. Pencetak mengukur satu label setiap %(measured)s. Semak saiz label dan jurang."

#: tavletta/ui/texts.py:576
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Pencetak tidak ditemui. Pastikan pencetak dihidupkan dan berada dalam rangkaian yang sama, atau masukkan alamat IP-nya."

#: tavletta/ui/texts.py:580
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "Pencetak tidak ditemui melalui USB. Semak kabel dan pastikan pencetak dihidupkan dan tidak dalam mod tidur, kemudian cari semula."

#: tavletta/ui/texts.py:583
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "Pencetak tidak menjawab. Pastikan pencetak dihidupkan dan tidak dalam mod tidur."

#: tavletta/ui/texts.py:585
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "Pencetak berhenti menerima data. Semak sama ada pencetak menunjukkan masalah, seperti label habis atau penutup terbuka, kemudian cuba lagi."

#: tavletta/ui/texts.py:589
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "Pencetak menolak sambungan. Matikan dan hidupkan semula. Jika antara muka webnya menawarkan pilihan “Port 9100”, hidupkan pilihan itu."

#: tavletta/ui/texts.py:592
msgid "No cassette is inserted. Insert one and try again."
msgstr "Tiada kaset dimasukkan. Masukkan kaset dan cuba lagi."

#: tavletta/ui/texts.py:593
msgid "The printer's cover is open. Close it and try again."
msgstr "Penutup pencetak terbuka. Tutup penutup dan cuba lagi."

#: tavletta/ui/texts.py:594
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Label tersekat. Buka penutup, keluarkan label dan cuba lagi."

#: tavletta/ui/texts.py:595
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Kaset tidak dikenali. Masukkan semula atau cuba kaset lain."

#: tavletta/ui/texts.py:596
msgid "The printer is busy. Wait a moment and try again."
msgstr "Pencetak sedang sibuk. Tunggu sebentar dan cuba lagi."

#: tavletta/ui/texts.py:597
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Label terlalu panjang untuk pencetak ini: maksimum %(max)s."

#: tavletta/ui/texts.py:598
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "Label terlalu lebar untuk pencetak ini: maksimum %(max)s."

#: tavletta/ui/texts.py:599
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "Label pencetak telah habis. Masukkan gulungan baharu dan cuba lagi."

#: tavletta/ui/texts.py:600
msgid "The print head is open. Close it and try again."
msgstr "Kepala cetak terbuka. Tutupkannya dan cuba lagi."

#: tavletta/ui/texts.py:602
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "Pencetak tidak dapat mencari label seterusnya. Semak bahawa label dimuatkan dengan betul dan melalui penderia label."

#: tavletta/ui/texts.py:606
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Terdapat masalah dengan reben. Semak bahawa ia dimasukkan dengan betul dan sepadan dengan kaedah cetakan yang ditetapkan pada pencetak."

#: tavletta/ui/texts.py:612
#, python-format
msgid ""
"The printer finds no ribbon. Load a ribbon and try again. Labels that print "
"without one need “%(direct)s” under “%(method)s”."
msgstr "Pencetak tidak menemui reben. Masukkan reben dan cuba lagi. Label yang dicetak tanpa reben memerlukan “%(direct)s” di bawah “%(method)s”."

#: tavletta/ui/texts.py:619
#, python-format
msgid ""
"A ribbon is loaded, but the printer prints without it (thermal direct). For "
"labels that need the ribbon choose “%(transfer)s” under “%(method)s”, or "
"remove the ribbon."
msgstr "Reben dimasukkan, tetapi pencetak mencetak tanpanya (terma terus). Untuk label yang memerlukan reben, pilih “%(transfer)s” di bawah “%(method)s”, atau keluarkan reben."

#: tavletta/ui/texts.py:624
msgid "The printer is paused. Resume it on its display and try again."
msgstr "Pencetak dijeda. Sambungkannya pada paparannya dan cuba lagi."

#: tavletta/ui/texts.py:627
#, python-format
msgid ""
"The printer ran out of memory for the job. Lower “%s” in the printer "
"settings, then try again."
msgstr "Memori pencetak tidak mencukupi untuk tugas ini. Kurangkan “%s” dalam tetapan pencetak, kemudian cuba lagi."

#: tavletta/ui/texts.py:631
msgid "The printer is out of paper. Load paper and try again."
msgstr "Pencetak kehabisan kertas. Masukkan kertas dan cuba lagi."

#: tavletta/ui/texts.py:633
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Kertas tersekat. Keluarkan seperti yang ditunjukkan pada paparan pencetak dan cuba lagi."

#: tavletta/ui/texts.py:635
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "Pencetak kehabisan toner atau dakwat. Gantikannya dan cuba lagi."

#: tavletta/ui/texts.py:636
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "Pencetak tidak dapat mencetak saiz ini. Pilih saiz kertas yang ditawarkannya."

#: tavletta/ui/texts.py:638
msgid ""
"The printer takes none of the formats Tavletta can send (PDF, PWG Raster, "
"JPEG)."
msgstr "Pencetak tidak menerima mana-mana format yang boleh dihantar oleh Tavletta (PDF, PWG Raster, JPEG)."

#: tavletta/ui/texts.py:641
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "Baris gilir pencetak dijeda. Sambungkannya dalam tetapan pencetak sistem dan cuba lagi."

#: tavletta/ui/texts.py:645
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "Kerja cetak ditahan dalam baris gilir, contohnya sehingga ia dilepaskan atau kata laluan dimasukkan. Semak baris gilir dalam tetapan pencetak sistem dan cuba lagi."

#: tavletta/ui/texts.py:649
msgid "The print job was canceled at the printer or in the queue."
msgstr "Kerja cetak telah dibatalkan pada pencetak atau dalam baris gilir."

#: tavletta/ui/texts.py:650
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "Pencetak tidak melaporkan resolusinya tepat pada masanya. Pilih di bawah “%s”."

#: tavletta/ui/texts.py:653
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "Gulungan yang dimasukkan tidak sepadan dengan label. Masukkan gulungan yang sepadan, atau pilih saiz label atau model pencetak bagi gulungan yang dimasukkan."

#: tavletta/ui/texts.py:656
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "Bateri pencetak lemah – cas atau sambungkan penyesuai kuasa."

#: tavletta/ui/texts.py:657
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "Kepala cetak terlalu panas. Tunggu sehingga ia sejuk, kemudian cuba lagi."

#: tavletta/ui/texts.py:659
msgid ""
"Tavletta cannot print on this printer model: it does not take the raster "
"images Tavletta sends."
msgstr "Tavletta tidak dapat mencetak pada model pencetak ini: ia tidak menerima imej raster yang dihantar oleh Tavletta."

#: tavletta/ui/texts.py:663
msgid "Tavletta does not know this printer model and cannot print on it yet."
msgstr "Tavletta belum mengenali model pencetak ini dan belum dapat mencetak padanya."

#: tavletta/ui/texts.py:666
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "Pencetak berada dalam mod Editor Lite dan muncul sebagai pemacu USB. Matikan Editor Lite pada pencetak (lampunya padam), kemudian cari lagi."

#: tavletta/ui/texts.py:670
msgid ""
"Tavletta is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Tavletta tidak dibenarkan menggunakan port USB pencetak. Tambahkan pengguna anda ke kumpulan “lp” (sudo usermod -aG lp $USER), kemudian log keluar dan log masuk semula."

#: tavletta/ui/texts.py:674
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "Halaman terlalu besar untuk dibuat pada resolusi yang diterima pencetak. Pilih saiz kertas yang lebih kecil, atau cetak pada pencetak yang menerima PDF."

#: tavletta/ui/texts.py:678
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Pada resolusi pencetak ini, kod tidak muat pada label dan akan terpotong. Besarkan label atau pendekkan kandungan kod."

#: tavletta/ui/texts.py:682
msgid ""
"Tavletta is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "Tavletta tidak dibenarkan menggunakan port bersiri pencetak. Tambahkan pengguna anda ke kumpulan “dialout” (sudo usermod -aG dialout $USER; pada Arch Linux kumpulan itu dinamakan “uucp”), kemudian log keluar dan log masuk semula."

#: tavletta/ui/texts.py:687
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "Pencetak melaporkan masalah. Matikan dan hidupkan semula, kemudian cuba sekali lagi."

#: tavletta/ui/texts.py:698 tavletta/server/web/ui.js:452
msgid "Printed"
msgstr "Telah dicetak"

#: tavletta/ui/texts.py:704
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Dihantar ke pencetak – akan dicetak apabila tiba gilirannya"

#: tavletta/ui/texts.py:706
msgid "Sent to the printer – it did not confirm printing"
msgstr "Dihantar ke pencetak – pencetak tidak mengesahkan pencetakan"

#: tavletta/ui/texts.py:710
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "Dicetak dengan “%(used)s” kerana gulungan yang dimasukkan memerlukannya"

#: tavletta/ui/texts.py:714
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "Mod warna “%(wanted)s” tidak tersedia pada pencetak ini, dicetak dengan “%(used)s”"

#: tavletta/ui/texts.py:724
msgid "Warming up…"
msgstr "Memanaskan…"

#: tavletta/ui/texts.py:725
msgid "Cooling down…"
msgstr "Menyejukkan…"

#: tavletta/ui/texts.py:726
msgid "Cleaning…"
msgstr "Membersihkan…"

#: tavletta/ui/texts.py:727
msgid "Swipe the printer's panel to cut the label"
msgstr "Leret panel pencetak untuk memotong label"

#: tavletta/ui/texts.py:729
msgid "Out of paper – load paper to continue"
msgstr "Kehabisan kertas – masukkan kertas untuk meneruskan"

#: tavletta/ui/texts.py:730
msgid "Cover open – close it to continue"
msgstr "Penutup terbuka – tutup untuk meneruskan"

#: tavletta/ui/texts.py:731
msgid "Paper jammed – remove it to continue"
msgstr "Kertas tersekat – keluarkan untuk meneruskan"

#: tavletta/ui/texts.py:742
msgid "This label needs a newer version of Tavletta"
msgstr "Label ini memerlukan versi Tavletta yang lebih baharu"

#: tavletta/ui/texts.py:744
#, python-format
msgid "%s is not a Tavletta label"
msgstr "%s bukan label Tavletta"

#: tavletta/ui/texts.py:745 tavletta/ui/texts.py:765
#: tavletta/server/service.py:993
#, python-format
msgid "The file is damaged: %s"
msgstr "Fail rosak: %s"

#: tavletta/ui/texts.py:752
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "Fail data %s sudah tiada. Pilih semula atau buang."

#: tavletta/ui/texts.py:756
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s tiada helaian bernama %(sheet)s"

#: tavletta/ui/texts.py:758
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s bukan jadual. Gunakan fail CSV, ODS atau XLSX."

#: tavletta/ui/texts.py:760
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s terlalu besar untuk label bersiri. Pecahkan kepada fail yang lebih kecil atau buang baris dan lajur yang tidak diperlukan."

#: tavletta/ui/texts.py:763
#, python-format
msgid "%s contains no data."
msgstr "%s tidak mengandungi data."

#: tavletta/ui/texts.py:778
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "Pencetakan berhenti pada baris %(row)d. Untuk meneruskan, cetak semula bermula dari baris %(row)d."

#: tavletta/ui/texts.py:783
#, python-format
msgid ""
"Row %(row)d and the rows after it may have printed already: going on from it "
"may print them twice."
msgstr "Baris %(row)d dan baris selepasnya mungkin sudah dicetak: meneruskan dari baris itu mungkin mencetaknya dua kali."

#: tavletta/ui/texts.py:787
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "Salinan baris %(row)d yang sudah dicetak: %(copies)d."

#: tavletta/ui/texts.py:792
#, python-format
msgid "Row %(row)d goes at position %(position)d of sheet %(sheet)d."
msgstr "Baris %(row)d diletakkan pada kedudukan %(position)d helaian %(sheet)d."

#: tavletta/ui/texts.py:803
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Tidak dapat menyimpan %s: tiada kebenaran untuk menulis di situ"

#: tavletta/ui/texts.py:805
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Tidak dapat menyimpan %s: cakera penuh"

#: tavletta/ui/texts.py:815
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Kaset ini nampaknya dibuat pada %(month)s %(year)d. Kertas ZINK lama mencetak warna yang lebih pudar."

#: tavletta/ui/variables.py:24
msgid "Date"
msgstr "Tarikh"

#: tavletta/ui/variables.py:25
msgid "Best before (in 30 days)"
msgstr "Terbaik sebelum (30 hari lagi)"

#: tavletta/ui/variables.py:26
msgid "Time"
msgstr "Masa"

#: tavletta/ui/variables.py:27 tavletta/ui/variables.py:113
msgid "Counter"
msgstr "Pembilang"

#: tavletta/ui/variables.py:28
msgid "Counter with leading zeros"
msgstr "Pembilang dengan sifar di hadapan"

#: tavletta/ui/variables.py:29
msgid "Copy number"
msgstr "Nombor salinan"

#: tavletta/ui/variables.py:30
msgid "Number of copies"
msgstr "Bilangan salinan"

#: tavletta/ui/variables.py:31
msgid "Random ID"
msgstr "ID rawak"

#: tavletta/ui/variables.py:41
msgid "Insert variable"
msgstr "Sisipkan pemboleh ubah"

#: tavletta/ui/variables.py:67
msgid ""
"Variables are filled in when printing. Every printed label gets the next "
"counter value, also from copy to copy. The preview shows the values of the "
"next print."
msgstr "Pemboleh ubah diisi semasa mencetak. Setiap label yang dicetak mendapat nilai pembilang seterusnya, juga dari salinan ke salinan. Pratonton menunjukkan nilai cetakan seterusnya."

#: tavletta/ui/variables.py:77
msgid "More about variables"
msgstr "Lebih lanjut tentang pemboleh ubah"

#: tavletta/ui/variables.py:113
msgid "Goes up with every printed label, by the step"
msgstr "Meningkat dengan setiap label yang dicetak, mengikut langkah"

#: tavletta/ui/variables.py:119
msgid "Next number"
msgstr "Nombor seterusnya"

#: tavletta/ui/variables.py:122 tavletta/server/web/batch.js:628
msgid "Step"
msgstr "Langkah"

#: tavletta/ui/window.py:176 tavletta/server/web/app.js:49
#: tavletta/server/web/app.js:342
msgid "Templates"
msgstr "Templat"

#: tavletta/ui/window.py:208
msgid "Shipping label…"
msgstr "Label penghantaran…"

#: tavletta/ui/window.py:211
msgid "Data for serial labels…"
msgstr "Data untuk label bersiri…"

#: tavletta/ui/window.py:212
msgid "Forget allowed data files"
msgstr "Lupakan fail data yang dibenarkan"

#: tavletta/ui/window.py:213
msgid "Export PNG…"
msgstr "Eksport sebagai PNG…"

#: tavletta/ui/window.py:217
msgid "Report a problem…"
msgstr "Laporkan masalah…"

#: tavletta/ui/window.py:218
msgid "About Tavletta"
msgstr "Perihal Tavletta"

#: tavletta/ui/window.py:743
msgid "Unsaved label"
msgstr "Label belum disimpan"

#: tavletta/ui/window.py:915
msgid "content scaled down to fit"
msgstr "kandungan dikecilkan supaya muat"

#: tavletta/ui/window.py:919
#, python-format
msgid "Problem: %s"
msgstr "Masalah: %s"

#: tavletta/ui/window.py:938
#, python-format
msgid "Too long for this printer: at most %s"
msgstr "Terlalu panjang untuk pencetak ini: maksimum %s"

#: tavletta/ui/window.py:942
#, python-format
msgid "Too wide for this printer: at most %s"
