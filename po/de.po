#: tavletta/ui/texts.py:289 tavletta/server/web/ui.js:66
msgid "Image"
msgstr "Bild"

#: tavletta/ui/texts.py:324
#, python-format
msgid "Endless, %(width)s wide"
msgstr "Endlos, %(width)s breit"

#: tavletta/ui/texts.py:334
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "Prüfen, ob das ganze Etikett in der Auswahl liegt. Ziehen, um sie oder ihre Kanten zu verschieben, oder eine neue aufziehen."

#: tavletta/ui/texts.py:338
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "Mehrere Bereiche könnten das Etikett sein. Die Auswahl prüfen oder den nächsten versuchen."

#: tavletta/ui/texts.py:340
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "Alles Gedruckte auf der Seite ist ausgewählt. Ziehen, um das Etikett zu wählen."

#: tavletta/ui/texts.py:341
msgid "Nothing is printed on this page."
msgstr "Auf dieser Seite ist nichts gedruckt."

#: tavletta/ui/texts.py:346
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "PDF-Dateien brauchen Poppler (poppler-glib), das nicht installiert ist"

#: tavletta/ui/texts.py:357
msgid "System printer (CUPS, IPP)"
msgstr "Systemdrucker (CUPS, IPP)"

#: tavletta/ui/texts.py:358
msgid "Receipt printer (ESC/POS)"
msgstr "Bondrucker (ESC/POS)"

#. translators: %s is a printer model, e.g. "Brother QL"
#: tavletta/ui/texts.py:360
#, python-format
msgid "%s, continuous rolls"
msgstr "%s, Endlosrollen"

#. translators: %s is a printer model, e.g. "Brother QL"
#: tavletta/ui/texts.py:362
#, python-format
msgid "%s, die-cut labels"
msgstr "%s, gestanzte Etiketten"

#: tavletta/ui/texts.py:385
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Element %(n)d: Der Code ist leer"

#: tavletta/ui/texts.py:386
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Element %(n)d: EAN-13 braucht genau 12 Ziffern"

#: tavletta/ui/texts.py:387
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Element %(n)d: Die EAN-13-Prüfziffer ist falsch"

#: tavletta/ui/texts.py:388
#, python-format
msgid "Element %(n)d: Code 128 holds at most %(max)d characters"
msgstr "Element %(n)d: Code 128 fasst höchstens %(max)d Zeichen"

#: tavletta/ui/texts.py:390
#, python-format
msgid ""
"Element %(n)d: the bars are too thin to scan reliably – use a longer or "
"larger label, or shorter content"
msgstr "Element %(n)d: Die Striche sind zu dünn, um zuverlässig gescannt zu werden – ein längeres oder grösseres Etikett oder kürzeren Inhalt verwenden"

#: tavletta/ui/texts.py:394
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Element %(n)d: Code 128 erlaubt nur lateinische Buchstaben, Ziffern und Satzzeichen"

#: tavletta/ui/texts.py:396
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Element %(n)d: EAN-8 braucht 7 Ziffern, oder 8 mit der Prüfziffer"

#: tavletta/ui/texts.py:397
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "Element %(n)d: UPC-A braucht 11 Ziffern, oder 12 mit der Prüfziffer"

#: tavletta/ui/texts.py:399
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "Element %(n)d: UPC-E braucht 7 Ziffern, beginnend mit 0 oder 1, oder 8 mit der Prüfziffer"

#: tavletta/ui/texts.py:401
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "Element %(n)d: ITF-14 braucht 13 Ziffern, oder 14 mit der Prüfziffer"

#: tavletta/ui/texts.py:402
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "Element %(n)d: Die Prüfziffer ist falsch"

#: tavletta/ui/texts.py:404
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Element %(n)d: Code 39 erlaubt nur Grossbuchstaben, Ziffern, Leerzeichen und - . $ / + %%"

#: tavletta/ui/texts.py:407
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Element %(n)d: Code 93 erlaubt nur lateinische Buchstaben, Ziffern und Satzzeichen"

#: tavletta/ui/texts.py:410
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Element %(n)d: GS1-Daten erlauben nur lateinische Buchstaben, Ziffern und Satzzeichen"

#: tavletta/ui/texts.py:413
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Element %(n)d: GS1-Daten bestehen aus Datenbezeichnern in Klammern, jeder gefolgt von seinem Wert, z. B. (01)09501101530003(10)AB12"

#: tavletta/ui/texts.py:416
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Element %(n)d: (%(ai)s) ist kein GS1-Datenbezeichner"

#: tavletta/ui/texts.py:418
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Element %(n)d: Der Wert des Datenbezeichners (%(ai)s) hat die falsche Länge"

#: tavletta/ui/texts.py:421
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Element %(n)d: Die Prüfziffer des Datenbezeichners (%(ai)s) ist falsch"

#: tavletta/ui/texts.py:424
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Element %(n)d: Der Wert des Datenbezeichners (%(ai)s) ist ungültig: ein Datum, eine Zahl oder ein Zeichen, das er nicht erlaubt"

#: tavletta/ui/texts.py:428
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Element %(n)d: Keine UPC-A-Nummer lässt sich auf diese UPC-E-Ziffern kürzen – Ziffern prüfen oder UPC-A verwenden"

#: tavletta/ui/texts.py:432
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Element %(n)d: Scanner im Full-ASCII-Modus lesen ein $, /, + oder %% vor einem Grossbuchstaben als anderes Zeichen"

#: tavletta/ui/texts.py:435
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Element %(n)d: Der Inhalt ist zu lang für diesen Codetyp"

#: tavletta/ui/texts.py:436
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Element %(n)d: Der Inhalt lässt sich in diesem Codetyp nicht codieren"

#: tavletta/ui/texts.py:438
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Element %(n)d: Dieser Codetyp braucht die Bibliothek Zint (zint-bindings), die nicht installiert ist"

#: tavletta/ui/texts.py:441
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Element %(n)d: Das Bild lässt sich nicht lesen"

#: tavletta/ui/texts.py:442
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Element %(n)d: Dieses Symbol ist nicht in der Symbolbibliothek"

#: tavletta/ui/texts.py:443
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Element %(n)d: Das Dokument lässt sich nicht lesen"

#: tavletta/ui/texts.py:445
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Element %(n)d: PDF-Dateien brauchen Poppler (poppler-glib), das nicht installiert ist"

#: tavletta/ui/texts.py:447
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Element %(n)d lässt sich nicht zeichnen"

#: tavletta/ui/texts.py:449
#, python-format
msgid ""
"Element %(n)d: the text is too long to be drawn in one line – break it into "
"lines or shorten it"
msgstr "Element %(n)d: Der Text ist zu lang, um in einer Zeile gezeichnet zu werden – teilen Sie ihn auf Zeilen auf oder kürzen Sie ihn"

#: tavletta/ui/texts.py:453
#, python-format
msgid ""
"Element %(n)d: the text is too tall to be drawn – use fewer lines or a "
"smaller size"
msgstr "Element %(n)d: Der Text ist zu hoch, um gezeichnet zu werden – verwenden Sie weniger Zeilen oder eine kleinere Grösse"

#: tavletta/ui/texts.py:456
#, python-format
msgid ""
"Element %(n)d: the font %(font)s is not installed – another font is used"
msgstr "Element %(n)d: Die Schrift %(font)s ist nicht installiert – eine andere wird verwendet"

#: tavletta/ui/texts.py:459
msgid ""
"Safety margin, border, its inset and edge spacing leave no room – reduce them"
msgstr "Sicherheitsabstand, Rahmen, sein Einzug und Randabstand lassen keinen Platz – bitte verkleinern"

#: tavletta/ui/texts.py:461
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "Die feste Länge ist kürzer als der Abstand – bitte vergrössern"

#: tavletta/ui/texts.py:462
msgid "The background image cannot be read"
msgstr "Das Hintergrundbild lässt sich nicht lesen"

#: tavletta/ui/texts.py:464
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Element %(n)d: Die Module des Codes sind nur einen Druckpunkt breit und lassen sich womöglich nicht scannen – Code grösser machen"

#: tavletta/ui/texts.py:468
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Element %(n)d: Der Leerraum, den der Code um sich braucht, hat keinen Platz – Code grösser machen"

#: tavletta/ui/texts.py:472
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Element %(n)d: Der Code passt nicht in seinen Platz, auch nicht mit einem Druckpunkt pro Modul – Etikett grösser machen oder den Inhalt kürzen"

#: tavletta/ui/texts.py:475
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Element %(n)d: %(name)s ist keine bekannte Variable"

#: tavletta/ui/texts.py:477
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Element %(n)d: Das Datum von %(name)s liegt vor dem Jahr 1 oder nach 9999"

#: tavletta/ui/texts.py:480
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Element %(n)d: die Variable %(name)s… ist nicht geschlossen – mit } beenden"

#: tavletta/ui/texts.py:483
#, python-format
msgid ""
"Element %(n)d: on a black-and-white printer it hardly stands out from what "
"lies behind it, as a whole or in part – choose another colour or move it"
msgstr "Element %(n)d: Auf einem Schwarzweissdrucker hebt es sich ganz oder teilweise kaum von dem ab, was dahinter liegt – eine andere Farbe wählen oder es verschieben"

#: tavletta/ui/texts.py:486
#, python-format
msgid "Element %(n)d: the shape has neither a line nor a fill"
msgstr "Element %(n)d: Die Form hat weder Linie noch Füllung"

#: tavletta/ui/texts.py:488
#, python-format
msgid ""
"Element %(n)d reaches beyond the edge of the label and is cut off there – "
"move it or make it smaller"
msgstr "Element %(n)d reicht über den Rand des Etiketts hinaus und wird dort abgeschnitten – es verschieben oder kleiner machen"

#: tavletta/ui/texts.py:492
#, python-format
msgid ""
"Element %(n)d: the padding, frame, outline or shadow leave no room for the "
"text – make them smaller"
msgstr "Element %(n)d: Innenabstand, Rahmen, Kontur oder Schatten lassen keinen Platz für den Text – sie kleiner machen"

#: tavletta/ui/texts.py:507
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Bereits gedruckte Bögen: %(n)d von %(total)d."

#: tavletta/ui/texts.py:509
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Bereits gedruckte Etiketten: %(n)d von %(total)d."

#: tavletta/ui/texts.py:513
msgid "The sheets still waiting in the queue were canceled."
msgstr "Die Bögen, die noch in der Warteschlange standen, wurden abgebrochen."

#: tavletta/ui/texts.py:515
msgid "The labels still waiting in the queue were canceled."
msgstr "Die Etiketten, die noch in der Warteschlange standen, wurden abgebrochen."

#: tavletta/ui/texts.py:526
#, python-format
msgid ""
"The label is %(size)s, but labels of %(loaded)s are loaded. Check the label "
"size, or load the matching roll."
msgstr "Das Etikett ist %(size)s gross, eingelegt sind aber Etiketten von %(loaded)s. Prüfen Sie die Etikettengrösse, oder legen Sie die passende Rolle ein."

#: tavletta/ui/texts.py:534
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap, or calibrate the printer."
msgstr "Das Etikett ist %(size)s gross mit %(gap)s Lücke, also beginnt alle %(pitch)s ein neues. Der Drucker hat alle %(measured)s ein Etikett gemessen. Prüfen Sie Etikettengrösse und Lücke, oder kalibrieren Sie den Drucker."

#: tavletta/ui/texts.py:540
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap."
msgstr "Das Etikett ist %(size)s gross mit %(gap)s Lücke, also beginnt alle %(pitch)s ein neues. Der Drucker hat alle %(measured)s ein Etikett gemessen. Prüfen Sie Etikettengrösse und Lücke."

#: tavletta/ui/texts.py:557
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Der Drucker wurde nicht gefunden. Prüfen Sie, ob er eingeschaltet und im selben Netzwerk ist, oder geben Sie seine IP-Adresse ein."

#: tavletta/ui/texts.py:561
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "Der Drucker ist über USB nicht zu finden. Prüfen Sie das Kabel und ob der Drucker eingeschaltet und wach ist, und suchen Sie dann erneut."

#: tavletta/ui/texts.py:564
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "Der Drucker antwortet nicht. Prüfen Sie, ob er eingeschaltet und wach ist."

#: tavletta/ui/texts.py:566
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "Der Drucker nimmt keine Daten mehr an. Prüfen Sie, ob er ein Problem anzeigt, etwa fehlende Etiketten oder einen offenen Deckel, und versuchen Sie es dann erneut."

#: tavletta/ui/texts.py:570
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "Der Drucker verweigert die Verbindung. Schalten Sie ihn aus und wieder ein. Bietet seine Weboberfläche eine Option „Port 9100“, schalten Sie sie ein."

#: tavletta/ui/texts.py:573
msgid "No cassette is inserted. Insert one and try again."
msgstr "Keine Kassette eingelegt. Legen Sie eine ein und versuchen Sie es erneut."

#: tavletta/ui/texts.py:574
msgid "The printer's cover is open. Close it and try again."
msgstr "Die Abdeckung des Druckers ist offen. Schliessen Sie sie und versuchen Sie es erneut."

#: tavletta/ui/texts.py:575
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Das Etikett klemmt. Öffnen Sie die Abdeckung, entfernen Sie es und versuchen Sie es erneut."

#: tavletta/ui/texts.py:576
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Die Kassette wird nicht erkannt. Legen Sie sie erneut ein oder versuchen Sie eine andere."

#: tavletta/ui/texts.py:577
msgid "The printer is busy. Wait a moment and try again."
msgstr "Der Drucker ist beschäftigt. Warten Sie einen Moment und versuchen Sie es erneut."

#: tavletta/ui/texts.py:578
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Das Etikett ist zu lang für diesen Drucker: höchstens %(max)s."

#: tavletta/ui/texts.py:579
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "Das Etikett ist zu breit für diesen Drucker: höchstens %(max)s."

#: tavletta/ui/texts.py:580
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "Der Drucker hat keine Etiketten mehr. Legen Sie eine neue Rolle ein und versuchen Sie es erneut."

#: tavletta/ui/texts.py:581
msgid "The print head is open. Close it and try again."
msgstr "Der Druckkopf ist offen. Schliessen Sie ihn und versuchen Sie es erneut."

#: tavletta/ui/texts.py:583
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "Der Drucker findet das nächste Etikett nicht. Prüfen Sie, ob die Etiketten richtig eingelegt sind und durch den Etikettensensor laufen."

#: tavletta/ui/texts.py:587
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Mit dem Farbband stimmt etwas nicht. Prüfen Sie, ob es richtig eingelegt ist und zum am Drucker eingestellten Druckverfahren passt."

#: tavletta/ui/texts.py:593
#, python-format
msgid ""
"The printer finds no ribbon. Load a ribbon and try again. Labels that print "
"without one need “%(direct)s” under “%(method)s”."
msgstr "Der Drucker findet kein Farbband. Legen Sie ein Farbband ein und versuchen Sie es erneut. Etiketten, die ohne Farbband drucken, brauchen „%(direct)s“ unter „%(method)s“."

#: tavletta/ui/texts.py:600
#, python-format
msgid ""
"A ribbon is loaded, but the printer prints without it (thermal direct). For "
"labels that need the ribbon choose “%(transfer)s” under “%(method)s”, or "
"remove the ribbon."
msgstr "Ein Farbband ist eingelegt, aber der Drucker druckt ohne (Thermodirekt). Für Etiketten, die das Farbband brauchen, wählen Sie „%(transfer)s“ unter „%(method)s“, oder nehmen Sie das Farbband heraus."

#: tavletta/ui/texts.py:605
msgid "The printer is paused. Resume it on its display and try again."
msgstr "Der Drucker ist angehalten. Setzen Sie ihn am Display fort und versuchen Sie es erneut."

#: tavletta/ui/texts.py:606
msgid "The printer is out of paper. Load paper and try again."
msgstr "Der Drucker hat kein Papier mehr. Papier einlegen und erneut versuchen."

#: tavletta/ui/texts.py:608
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Papierstau. Das Papier so entfernen, wie es das Display des Druckers zeigt, und erneut versuchen."

#: tavletta/ui/texts.py:610
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "Toner oder Tinte ist leer. Ersetzen und erneut versuchen."

#: tavletta/ui/texts.py:611
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "Der Drucker kann diese Grösse nicht drucken. Ein Papierformat wählen, das er anbietet."

#: tavletta/ui/texts.py:613
msgid ""
"The printer takes none of the formats Tavletta can send (PDF, PWG Raster, "
"JPEG)."
msgstr "Der Drucker nimmt keines der Formate an, die Tavletta senden kann (PDF, PWG Raster, JPEG)."

#: tavletta/ui/texts.py:616
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "Die Warteschlange des Druckers ist angehalten. In den Druckereinstellungen des Systems fortsetzen und erneut versuchen."

#: tavletta/ui/texts.py:620
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "Der Druckauftrag wurde in der Warteschlange zurückgehalten, zum Beispiel bis er freigegeben oder ein Passwort eingegeben wird. Die Warteschlange in den Druckereinstellungen des Systems prüfen und erneut versuchen."

#: tavletta/ui/texts.py:624
msgid "The print job was canceled at the printer or in the queue."
msgstr "Der Druckauftrag wurde am Drucker oder in der Warteschlange abgebrochen."

#: tavletta/ui/texts.py:625
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "Der Drucker hat seine Auflösung nicht rechtzeitig gemeldet. Wählen Sie sie unter „%s“."

#: tavletta/ui/texts.py:628
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "Die eingelegte Rolle passt nicht zum Etikett. Legen Sie eine passende Rolle ein, oder wählen Sie die Etikettengrösse oder das Druckermodell der eingelegten Rolle."

#: tavletta/ui/texts.py:631
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "Der Akku des Druckers ist fast leer – aufladen oder das Netzteil anschliessen."

#: tavletta/ui/texts.py:632
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "Der Druckkopf ist zu heiss. Warten Sie, bis er abgekühlt ist, und versuchen Sie es dann erneut."

#: tavletta/ui/texts.py:634
msgid ""
"Tavletta cannot print on this printer model: it does not take the raster "
"images Tavletta sends."
msgstr "Tavletta kann auf diesem Druckermodell nicht drucken: Es nimmt die Rasterbilder, die Tavletta sendet, nicht an."

#: tavletta/ui/texts.py:638
msgid "Tavletta does not know this printer model and cannot print on it yet."
msgstr "Tavletta kennt dieses Druckermodell nicht und kann noch nicht darauf drucken."

#: tavletta/ui/texts.py:641
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "Der Drucker ist im Modus Editor Lite und erscheint als USB-Laufwerk. Schalten Sie Editor Lite am Drucker aus (die Lampe erlischt) und suchen Sie dann erneut."

#: tavletta/ui/texts.py:645
msgid ""
"Tavletta is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Tavletta darf den USB-Anschluss des Druckers nicht verwenden. Den Benutzer zur Gruppe „lp“ hinzufügen (sudo usermod -aG lp $USER), dann ab- und wieder anmelden."

#: tavletta/ui/texts.py:649
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "Die Seite ist zu gross, um sie in der Auflösung zu erstellen, die der Drucker annimmt. Ein kleineres Papierformat wählen oder auf einem Drucker drucken, der PDF annimmt."

#: tavletta/ui/texts.py:653
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Ein Code passt bei der Auflösung dieses Druckers nicht aufs Etikett und würde abgeschnitten. Etikett grösser machen oder den Inhalt des Codes kürzen."

#: tavletta/ui/texts.py:657
msgid ""
"Tavletta is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "Tavletta darf die serielle Schnittstelle des Druckers nicht verwenden. Den Benutzer zur Gruppe „dialout“ hinzufügen (sudo usermod -aG dialout $USER; unter Arch Linux heisst die Gruppe „uucp“), dann ab- und wieder anmelden."

#: tavletta/ui/texts.py:662
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "Der Drucker hat ein Problem gemeldet. Schalten Sie ihn aus und wieder ein und versuchen Sie es dann noch einmal."

#: tavletta/ui/texts.py:673 tavletta/server/web/ui.js:452
msgid "Printed"
msgstr "Gedruckt"

#: tavletta/ui/texts.py:679
msgid "Sent to the printer – it prints when its turn comes"
msgstr "An den Drucker gesendet – wird gedruckt, sobald der Auftrag an der Reihe ist"

#: tavletta/ui/texts.py:681
msgid "Sent to the printer – it did not confirm printing"
msgstr "An den Drucker gesendet – er hat das Drucken nicht bestätigt"

#: tavletta/ui/texts.py:685
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "Mit „%(used)s“ gedruckt, weil die eingelegte Rolle das braucht"

#: tavletta/ui/texts.py:689
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "Farbmodus „%(wanted)s“ ist auf diesem Drucker nicht verfügbar, gedruckt mit „%(used)s“"

#: tavletta/ui/texts.py:699
msgid "Warming up…"
msgstr "Aufwärmen …"

#: tavletta/ui/texts.py:700
msgid "Cooling down…"
msgstr "Abkühlen …"

#: tavletta/ui/texts.py:701
msgid "Cleaning…"
msgstr "Reinigen …"

#: tavletta/ui/texts.py:702
msgid "Swipe the printer's panel to cut the label"
msgstr "Zum Abschneiden über das Bedienfeld des Druckers streichen"

#: tavletta/ui/texts.py:704
msgid "Out of paper – load paper to continue"
msgstr "Kein Papier – Papier einlegen, dann geht es weiter"

#: tavletta/ui/texts.py:705
msgid "Cover open – close it to continue"
msgstr "Abdeckung offen – schliessen, dann geht es weiter"

#: tavletta/ui/texts.py:706
msgid "Paper jammed – remove it to continue"
msgstr "Papierstau – Papier entfernen, dann geht es weiter"

#: tavletta/ui/texts.py:717
msgid "This label needs a newer version of Tavletta"
msgstr "Dieses Etikett braucht eine neuere Version von Tavletta"

#: tavletta/ui/texts.py:719
#, python-format
msgid "%s is not a Tavletta label"
msgstr "%s ist kein Tavletta-Etikett"

#: tavletta/ui/texts.py:720 tavletta/ui/texts.py:740
#: tavletta/server/service.py:914
#, python-format
msgid "The file is damaged: %s"
msgstr "Die Datei ist beschädigt: %s"

#: tavletta/ui/texts.py:727
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "Die Datendatei %s ist nicht mehr da. Sie erneut wählen oder entfernen."

#: tavletta/ui/texts.py:731
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s hat kein Blatt namens %(sheet)s"

#: tavletta/ui/texts.py:733
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s ist keine Tabelle. Eine CSV-, ODS- oder XLSX-Datei verwenden."

#: tavletta/ui/texts.py:735
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s ist zu gross für Serienetiketten. In kleinere Dateien aufteilen oder nicht benötigte Zeilen und Spalten entfernen."

#: tavletta/ui/texts.py:738
#, python-format
msgid "%s contains no data."
msgstr "%s enthält keine Daten."

#: tavletta/ui/texts.py:749
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "Der Druck hat bei Zeile %(row)d angehalten. Zum Fortsetzen ab Zeile %(row)d erneut drucken."

#: tavletta/ui/texts.py:753
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "Bereits gedruckte Exemplare von Zeile %(row)d: %(copies)d."

#: tavletta/ui/texts.py:758
#, python-format
msgid "Row %(row)d goes at position %(position)d of sheet %(sheet)d."
msgstr "Zeile %(row)d kommt an Position %(position)d von Bogen %(sheet)d."

#: tavletta/ui/texts.py:769
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "%s lässt sich nicht speichern: keine Schreibrechte"

#: tavletta/ui/texts.py:771
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "%s lässt sich nicht speichern: der Datenträger ist voll"

#: tavletta/ui/texts.py:781
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Diese Kassette stammt vermutlich von %(month)s %(year)d. Altes ZINK-Papier druckt blassere Farben."

#: tavletta/ui/variables.py:24
msgid "Date"
msgstr "Datum"

#: tavletta/ui/variables.py:25
msgid "Best before (in 30 days)"
msgstr "Mindestens haltbar bis (in 30 Tagen)"

#: tavletta/ui/variables.py:26
msgid "Time"
msgstr "Uhrzeit"

#: tavletta/ui/variables.py:27 tavletta/ui/variables.py:113
msgid "Counter"
msgstr "Zähler"

#: tavletta/ui/variables.py:28
msgid "Counter with leading zeros"
msgstr "Zähler mit führenden Nullen"

#: tavletta/ui/variables.py:29
msgid "Copy number"
msgstr "Nummer des Exemplars"

#: tavletta/ui/variables.py:30
msgid "Number of copies"
msgstr "Anzahl Exemplare"

#: tavletta/ui/variables.py:31
msgid "Random ID"
msgstr "Zufällige ID"

#: tavletta/ui/variables.py:41
msgid "Insert variable"
msgstr "Variable einfügen"

#: tavletta/ui/variables.py:67
msgid ""
"Variables are filled in when printing. Every printed label gets the next "
"counter value, also from copy to copy. The preview shows the values of the "
"next print."
msgstr "Variablen werden beim Drucken eingesetzt. Jedes gedruckte Etikett erhält den nächsten Zählerstand, auch von Exemplar zu Exemplar. Die Vorschau zeigt die Werte des nächsten Drucks."

#: tavletta/ui/variables.py:77
msgid "More about variables"
msgstr "Mehr über Variablen"

#: tavletta/ui/variables.py:113
msgid "Goes up with every printed label, by the step"
msgstr "Steigt mit jedem gedruckten Etikett um die Schrittweite"

#: tavletta/ui/variables.py:119
msgid "Next number"
msgstr "Nächste Nummer"

#: tavletta/ui/variables.py:122 tavletta/server/web/batch.js:628
msgid "Step"
msgstr "Schrittweite"

#: tavletta/ui/window.py:176 tavletta/server/web/app.js:49
#: tavletta/server/web/app.js:342
msgid "Templates"
msgstr "Vorlagen"

#: tavletta/ui/window.py:208
msgid "Shipping label…"
msgstr "Versandetikett …"

#: tavletta/ui/window.py:211
msgid "Data for serial labels…"
msgstr "Daten für Serienetiketten …"

#: tavletta/ui/window.py:212
msgid "Forget allowed data files"
msgstr "Erlaubte Datendateien vergessen"

#: tavletta/ui/window.py:213
msgid "Export PNG…"
msgstr "Als PNG exportieren …"

#: tavletta/ui/window.py:217
msgid "Report a problem…"
msgstr "Problem melden …"

#: tavletta/ui/window.py:218
msgid "About Tavletta"
msgstr "Über Tavletta"

#: tavletta/ui/window.py:743
msgid "Unsaved label"
msgstr "Ungespeichertes Etikett"

#: tavletta/ui/window.py:915
msgid "content scaled down to fit"
msgstr "Inhalt verkleinert, damit er passt"

#: tavletta/ui/window.py:919
#, python-format
msgid "Problem: %s"
msgstr "Problem: %s"

#: tavletta/ui/window.py:938
#, python-format
msgid "Too long for this printer: at most %s"
msgstr "Zu lang für diesen Drucker: höchstens %s"

#: tavletta/ui/window.py:942
#, python-format
msgid "Too wide for this printer: at most %s"
msgstr "Zu breit für diesen Drucker: höchstens %s"

#: tavletta/ui/window.py:1020
msgid "The browser cannot be opened"
msgstr "Der Browser lässt sich nicht öffnen"

#: tavletta/ui/window.py:1022
msgid "Copy link"
msgstr "Link kopieren"

#: tavletta/ui/window.py:1094
msgid "Only local files can be dropped"
msgstr "Nur lokale Dateien können abgelegt werden"

#: tavletta/ui/window.py:1147
msgid "Please wait until printing has finished"
msgstr "Bitte warten, bis der Druck fertig ist"

#: tavletta/server/config.py:79
#, python-format
msgid "%(file)s: %(key)s: %(problem)s"
msgstr "%(file)s: %(key)s: %(problem)s"

#: tavletta/server/config.py:89 tavletta/server/config.py:93
#: tavletta/server/config.py:99 tavletta/server/main.py:383
#, python-format
msgid "Cannot read %(file)s: %(reason)s"
msgstr "%(file)s lässt sich nicht lesen: %(reason)s"

#: tavletta/server/config.py:109
msgid "expected a table"
msgstr "Tabelle erwartet"

#: tavletta/server/config.py:119 tavletta/server/config.py:455
#: tavletta/server/oidc.py:226 tavletta/server/oidc.py:318
msgid "missing"
msgstr "fehlt"

#: tavletta/server/config.py:122
msgid "expected text"
msgstr "Text erwartet"

#: tavletta/server/config.py:124
msgid "control characters are not allowed"
msgstr "Steuerzeichen sind nicht erlaubt"

#: tavletta/server/config.py:130
msgid "expected true or false"
msgstr "true oder false erwartet"

#: tavletta/server/config.py:141
#, python-format
msgid "expected a number from %(min)s to %(max)s"
msgstr "Zahl von %(min)s bis %(max)s erwartet"

#: tavletta/server/config.py:148
#, python-format
msgid "expected one of: %s"
msgstr "eines davon erwartet: %s"

#: tavletta/server/config.py:153 tavletta/server/config.py:159
#: tavletta/server/oidc.py:287
msgid "unknown key"
msgstr "unbekannter Schlüssel"

#: tavletta/server/config.py:162
msgid "nothing defined"
msgstr "nichts festgelegt"

#: tavletta/server/config.py:168
msgid "not a valid name: letters, digits, . _ - (up to 64)"
msgstr "kein gültiger Name: Buchstaben, Ziffern, . _ - (bis 64)"

#: tavletta/server/config.py:209
msgid "only one printer can be the default"
msgstr "nur ein Drucker kann der Standard sein"

#: tavletta/server/config.py:223
msgid "not a valid printer address"
msgstr "keine gültige Druckeradresse"

#: tavletta/server/config.py:245
msgid "this printer model does not cut"
msgstr "dieses Druckermodell schneidet nicht"

#: tavletta/server/config.py:247
msgid "this printer model has no colour settings"
msgstr "dieses Druckermodell hat keine Farbeinstellungen"

#: tavletta/server/config.py:410
