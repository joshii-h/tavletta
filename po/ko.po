msgstr "파선"

#: tavletta/ui/texts.py:181 tavletta/ui/texts.py:206
msgid "Dotted"
msgstr "도트"

#: tavletta/ui/texts.py:183
msgid "Double"
msgstr "이중선"

#: tavletta/ui/texts.py:185
