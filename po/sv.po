#: tavletta/app.py:150 tavletta/ui/styles.py:183
msgid "Box and frame"
msgstr "Ruta och ram"

#: tavletta/app.py:224 tavletta/cli.py:186
msgid "Design and print labels"
msgstr "Designa och skriv ut etiketter"

#: tavletta/app.py:227
msgid ""
"Tavletta is Romansh for a small tablet (from tavla, table/board). Pronounced "
"tav-LET-ta."
msgstr "Tavletta är rätoromanska för en liten tavla (av tavla, tavla/bräde). Uttalas tav-LET-ta."

#. translators: replace with your name to be credited in the About dialog
#: tavletta/app.py:233
msgid "translator-credits"
msgstr "Tavletta contributors"

#: tavletta/app.py:241
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Idéer till variablerna (räknare, datum, UUID), ingen kod"

#: tavletta/app.py:244
msgid "Protocol knowledge"
msgstr "Protokollkunskap"

#: tavletta/app.py:249
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "Från %(projects)s och tillverkarnas handböcker, nyskrivet utan deras kod; se THIRD_PARTY_NOTICES.md"

#: tavletta/cli.py:110
#, python-format
msgid "%(name)s is filled from the data rows ({%(name)s}) and cannot be set"
msgstr "%(name)s fylls i från dataraderna ({%(name)s}) och kan inte anges"

#: tavletta/cli.py:112
#, python-format
msgid "%(name)s is a data column ({%(name)s}) – give a data file with --data"
msgstr "%(name)s är en datakolumn ({%(name)s}) – ange en datafil med --data"

#: tavletta/cli.py:130
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "förväntade NAME=VALUE: %s"

#: tavletta/cli.py:146
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "förväntade ett heltal från %(min)d till %(max)d: %(value)s"

#: tavletta/cli.py:180
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "rader förväntades, t.ex. 3-10, 5 eller 7-: %s"

#: tavletta/cli.py:187
msgid "Without a command the application starts; label files given open in it."
msgstr "Utan kommando startar appen; angivna etikettfiler öppnas i den."

#: tavletta/cli.py:193
msgid "print a label file without opening a window"
msgstr "skriv ut en etikettfil utan att öppna något fönster"

#: tavletta/cli.py:194
msgid "Print a label file without opening a window."
msgstr "Skriv ut en etikettfil utan att öppna något fönster."

#: tavletta/cli.py:196
msgid "the label (.tavletta)"
msgstr "etiketten (.tavletta)"

#: tavletta/cli.py:199
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "skrivarmodell, som standard etikettens: %s"

#: tavletta/cli.py:202
msgid "printer address, by default the one set in the app"
msgstr "skrivaradress, som standard den som är inställd i appen"

#: tavletta/cli.py:205
msgid "number of copies"
msgstr "antal kopior"

#: tavletta/cli.py:215
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "text i elementet NAME, eller värdet för variabeln {=NAME}; variabler i en text fylls i; kan upprepas"

#: tavletta/cli.py:225
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "som --set, men värdet används som det är: klammerparenteser är inga variabler"

#: tavletta/cli.py:231
msgid "counter of the first label, instead of the one saved in the label"
msgstr "räknare för den första etiketten, i stället för den som är sparad i etiketten"

#: tavletta/cli.py:237
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "skriv ut med skrivarmodellens standardvärden i stället för den skärning, de färger, den kvalitet, de tillägg (kedjeutskrift, hög upplösning, tejpmatning), de skrivarinställningar och de konturer på etikettark som senast valdes i appen; adressen och säkerhetsmarginalen behålls"

#: tavletta/cli.py:246
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, with --printer-defaults the "
"one set on the printer"
msgstr "utskriftsmetod för en termoskrivare som har inställningen: printer (som inställt på skrivaren), transfer (med färgband) eller direct (direkttermisk, utan färgband); som standard den som valts i appen, med --printer-defaults den som är inställd på skrivaren"

#: tavletta/cli.py:255
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "fråga inte skrivaren före renderingen (modell, tejp och upplösning)"

#: tavletta/cli.py:261
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "spara inte nästa räknarvärde i etiketten (en skrivskyddad fil); nästa utskrift börjar på samma nummer"

#: tavletta/cli.py:270
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "serieetiketter: en etikett för varje rad i den här CSV-, ODS- eller XLSX-filen; som standard etikettens datafil"

#: tavletta/cli.py:275
msgid "the sheet of the data file, by default the first"
msgstr "datafilens blad, som standard det första"

#: tavletta/cli.py:281
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "bara de här raderna i datafilen, t.ex. 3-10, 5 eller 7- (räknat från 1)"

#: tavletta/cli.py:284
msgid "check and render only, do not print"
msgstr "kontrollera och rendera bara, skriv inte ut"

#: tavletta/cli.py:290
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "med --dry-run: spara varje etikett som PNG så som fönstret exporterar den, högst 600 dpi (- för stdout: bara den första)"

#: tavletta/cli.py:296
msgid "list the printers found on the network"
msgstr "lista skrivarna som hittas på nätverket"

#: tavletta/cli.py:297
msgid "List the printers found on the network: model, address, name."
msgstr "Lista skrivarna som hittas på nätverket: modell, adress, namn."

#: tavletta/cli.py:299
#, python-format
msgid "only this printer model: %s"
msgstr "bara denna skrivarmodell: %s"

#: tavletta/cli.py:311
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "förväntade en adress eller ett nät som 172.16.0.0/12: %s"

#: tavletta/cli.py:321
msgid "the folder with the label files the server may use"
msgstr "mappen med de etikettfiler som servern får använda"

#: tavletta/cli.py:328
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "skriv bara ut på denna skrivaradress (* matchar vad som helst); kan upprepas"

#: tavletta/cli.py:334
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: skrivarna som klienter får använda, efter namn"

#: tavletta/cli.py:341
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "högst så många etiketter i ett utskriftsjobb, kopior gånger rader (standard 10000)"

#: tavletta/cli.py:346
msgid "search the network for printers (off by default)"
msgstr "sök efter skrivare på nätverket (av som standard)"

#: tavletta/cli.py:352
msgid ""
"allow document pages (PDF, images) in labels sent with the request; PDFs are "
"then drawn in a separate process with limits (off by default)"
msgstr "tillåt dokumentsidor (PDF, bilder) i etiketter som skickas med begäran; PDF-filer ritas då i en egen process med gränser (av som standard)"

#: tavletta/cli.py:361
msgid "run a print server with a REST API"
msgstr "kör en utskriftsserver med ett REST API"

#: tavletta/cli.py:362
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Kör en utskriftsserver: ett REST API och, med --mcp, MCP för AI-klienter."

#: tavletta/cli.py:365
msgid "address to listen on (default 127.0.0.1)"
msgstr "adress att lyssna på (standard 127.0.0.1)"

#: tavletta/cli.py:371
#, python-format
msgid "port to listen on (default %d)"
msgstr "port att lyssna på (standard %d)"

#: tavletta/cli.py:377
msgid ""
"file with the access token; else the environment variable TAVLETTA_TOKEN"
msgstr "fil med åtkomsttoken; annars miljövariabeln TAVLETTA_TOKEN"

#: tavletta/cli.py:383
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: namngivna åtkomsttoken med roller"

#: tavletta/cli.py:385
msgid "also serve MCP at /mcp"
msgstr "tillhandahåll även MCP på /mcp"

#: tavletta/cli.py:389
msgid "do not serve the web page at /: only the REST API (and MCP)"
msgstr "servera inte webbsidan på /: bara REST API:et (och MCP)"

#: tavletta/cli.py:396
msgid "largest request body in MB (default 4)"
msgstr "största förfrågningsinnehåll i MB (standard 4)"

#: tavletta/cli.py:405
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "en omvänd proxy vars X-Forwarded-For-huvud anger klienten, t.ex. 172.16.0.0/12; kan upprepas"

#: tavletta/cli.py:414
msgid "allow requests from web pages of this origin; repeatable"
msgstr "tillåt förfrågningar från webbsidor med detta ursprung; kan upprepas"

#: tavletta/cli.py:419
msgid "serve MCP on standard input and output"
msgstr "tillhandahåll MCP via standard in och ut"

#: tavletta/cli.py:421
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "Tillhandahåll MCP via standard in och ut, för AI-klienter som Claude Desktop."

#: tavletta/cli.py:431
msgid "manage the access tokens of the print server"
msgstr "hantera utskriftsserverns åtkomsttoken"

#: tavletta/cli.py:432
msgid "Manage the access tokens of the print server."
msgstr "Hantera utskriftsserverns åtkomsttoken."

#: tavletta/cli.py:437
msgid "make a token and add its hash to tokens.toml"
msgstr "skapa en token och lägg till dess hash i tokens.toml"

#: tavletta/cli.py:438
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Skapa en token, lägg till dess hash i tokens.toml och visa token en gång."

#: tavletta/cli.py:440
msgid "name of the token, e.g. the device"
msgstr "namn på token, t.ex. enheten"

#: tavletta/cli.py:445
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: bara titta; print: även skriva ut; admin: även alla jobb"

#: tavletta/cli.py:447
msgid "tokens.toml to add it to"
msgstr "tokens.toml att lägga till den i"

#: tavletta/cli.py:453
msgid "only this printer of printers.toml; repeatable"
msgstr "bara denna skrivare från printers.toml; kan upprepas"

#: tavletta/cli.py:456
msgid "printers.toml, to check --printer"
msgstr "printers.toml, för att kontrollera --printer"

#: tavletta/cli.py:458
msgid "valid until, e.g. 2027-12-31"
msgstr "giltig till, t.ex. 2027-12-31"

#: tavletta/cli.py:459
msgid "a note for people"
msgstr "en anteckning för människor"

#: tavletta/cli.py:461
msgid "store the hash with scrypt instead of SHA-256"
msgstr "lagra hashen med scrypt i stället för SHA-256"

#: tavletta/cli.py:467
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "ta en egenvald token från standard in (lagras med scrypt) i stället för att skapa en"

#: tavletta/cli.py:487 tavletta/server/config.py:220
#: tavletta/server/service.py:612
#, python-format
msgid "Unknown printer model: %s"
msgstr "Okänd skrivarmodell: %s"

#: tavletta/cli.py:494 tavletta/ui/files.py:84 tavletta/ui/files.py:137
#: tavletta/ui/texts.py:347 tavletta/ui/texts.py:729
#: tavletta/server/service.py:903
#, python-format
msgid "Cannot open %s"
msgstr "Kan inte öppna %s"

#: tavletta/cli.py:516 tavletta/server/main.py:262
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s är inget datum, förväntade t.ex. 2026-12-31 eller 2026-12-31T08:30"

#: tavletta/cli.py:564
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} fylls i vid utskrift och kan inte anges"

#: tavletta/cli.py:570
#, python-format
msgid "The label has no element or variable named %s"
msgstr "Etiketten har inget element eller någon variabel med namnet %s"

#: tavletta/cli.py:599 tavletta/ui/printing.py:123
#: tavletta/server/service.py:1288
msgid "The label is empty"
msgstr "Etiketten är tom"

#: tavletta/cli.py:636
msgid "Cannot write the output"
msgstr "Det går inte att skriva utdata"

#: tavletta/cli.py:667
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output skriver PNG-bilder: ange ett namn som slutar på .png"

#: tavletta/cli.py:692 tavletta/cli.py:901 tavletta/ui/printing.py:582
#: tavletta/ui/printing.py:746 tavletta/server/service.py:1147
#: tavletta/server/service.py:1170 tavletta/server/service.py:1472
#: tavletta/server/service.py:1708
msgid "The label cannot be prepared for printing."
msgstr "Etiketten kan inte förberedas för utskrift."

#: tavletta/cli.py:779
msgid "No printer found – give its address with --host"
msgstr "Ingen skrivare hittades – ange adressen med --host"

#: tavletta/cli.py:781
msgid ""
"Several printers found – choose one with --host (tavletta list-printers)"
msgstr "Flera skrivare hittades – välj en med --host (tavletta list-printers)"

#: tavletta/cli.py:792 tavletta/ui/texts.py:772 tavletta/server/service.py:1698
#, python-format
msgid "Cannot save %s"
msgstr "Kan inte spara %s"

#: tavletta/cli.py:794 tavletta/server/service.py:1701
msgid "the labels were printed, but the next counter value was not saved"
msgstr "etiketterna skrevs ut, men nästa räknarvärde sparades inte"

#: tavletta/cli.py:809 tavletta/server/service.py:1317
msgid "nothing was printed: the next counter value could not be saved"
msgstr "inget skrevs ut: nästa räknarvärde skulle inte kunna sparas"

#: tavletta/cli.py:869 tavletta/cli.py:896 tavletta/cli.py:1260
msgid "Interrupted"
msgstr "Avbruten"

#: tavletta/cli.py:952 tavletta/ui/printing.py:488
#: tavletta/server/service.py:1193
#, python-format
msgid "At most %d labels in one print job"
msgstr "Högst %d etiketter i ett utskriftsjobb"

#: tavletta/cli.py:971
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method: den här skrivarmodellen har ingen inställning för utskriftsmetod: %s"

#: tavletta/cli.py:1013
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet och --rows kräver en datafil (--data)"

#: tavletta/cli.py:1022 tavletta/ui/printing.py:615
#: tavletta/server/service.py:1005
msgid "No rows to print"
msgstr "Inga rader att skriva ut"

#: tavletta/cli.py:1032
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Etiketten använder en datafil utanför sin mapp: ange den med --data"

#: tavletta/cli.py:1059 tavletta/ui/window.py:922
#: tavletta/server/service.py:1064
#, python-format
msgid "No such column: %s"
msgstr "Okänd kolumn: %s"

#: tavletta/cli.py:1064 tavletta/ui/printing.py:695
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Streckkoden eller QR-koden för de här raderna kan inte skapas från deras värden, till exempel en EAN-13 med bokstäver eller en tom cell. Rätta datafilen och läs den igen, eller skriv ut utan de här raderna."

#: tavletta/cli.py:1069 tavletta/ui/printing.py:700
#, python-format
msgid "Rows: %s"
msgstr "Rader: %s"

#: tavletta/cli.py:1077
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Väntar på att en annan utskrift av %s ska bli klar…"

#: tavletta/cli.py:1084 tavletta/server/service.py:791
#: tavletta/server/service.py:1466
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s är fortfarande låst av en annan utskrift – försök igen senare"

#: tavletta/cli.py:1090
msgid "--output needs --dry-run"
msgstr "--output kräver --dry-run"

#: tavletta/cli.py:1107
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Nästa räknarvärde sparas inte: nästa utskrift upprepar numren"

#: tavletta/cli.py:1203
msgid "Waiting for the printer's answer…"
msgstr "Väntar på skrivarens svar…"

#: tavletta/cli.py:1231 tavletta/ui/printer.py:343
msgid "No printer found"
msgstr "Ingen skrivare hittades"

#: tavletta/ui/data.py:91
msgid "Tables (CSV, ODS, XLSX)"
msgstr "Tabeller (CSV, ODS, XLSX)"

#: tavletta/ui/data.py:98
msgid "Choose data file"
msgstr "Välj datafil"

#: tavletta/ui/data.py:108 tavletta/ui/files.py:104 tavletta/ui/files.py:126
#: tavletta/ui/files.py:207 tavletta/ui/texts.py:220
msgid "Only local files can be used"
msgstr "Endast lokala filer kan användas"

#: tavletta/ui/data.py:167
msgid "Tavletta asks again before reading data files outside a label's folder"
msgstr "Tavletta frågar igen innan datafiler utanför en etiketts mapp läses"

#: tavletta/ui/data.py:179
msgid "Read the data file?"
msgstr "Läsa datafilen?"

#: tavletta/ui/data.py:181
#, python-format
msgid ""
"This label uses a data file outside its folder:\n"
"\n"
"%s\n"
"\n"
"Read it only if you know where the label comes from."
msgstr "Den här etiketten använder en datafil utanför sin mapp:\n\n%s\n\nLäs den bara om du vet var etiketten kommer ifrån."

#: tavletta/ui/data.py:186
msgid "Not now"
msgstr "Inte nu"

#: tavletta/ui/data.py:187
msgid "Read data file"
msgstr "Läs datafil"

#: tavletta/ui/data.py:265
msgid "Reading…"
msgstr "Läser…"

#: tavletta/ui/data.py:267
msgid "Not read: outside the label's folder"
msgstr "Inte läst: utanför etikettens mapp"

#: tavletta/ui/data.py:270
#, python-format
msgid "Rows: %(rows)d · Columns: %(columns)d"
msgstr "Rader: %(rows)d · Kolumner: %(columns)d"

#: tavletta/ui/data.py:281 tavletta/ui/shortcuts.py:90
msgid "Serial labels"
msgstr "Serieetiketter"

#: tavletta/ui/data.py:283
msgid ""
"One label for each row of a table. Insert columns into texts and codes; each "
"label shows the values of its row."
msgstr "En etikett för varje rad i en tabell. Infoga kolumner i texter och koder; varje etikett visar värdena från sin rad."

#: tavletta/ui/data.py:290
msgid "No data file"
msgstr "Ingen datafil"

#: tavletta/ui/data.py:290
msgid "CSV, ODS or XLSX"
msgstr "CSV, ODS eller XLSX"

#: tavletta/ui/data.py:291 tavletta/ui/elements.py:355
#: tavletta/ui/elements.py:373 tavletta/ui/elements.py:386
msgid "Choose…"
msgstr "Välj…"

#: tavletta/ui/data.py:304
msgid "Columns"
msgstr "Kolumner"

#: tavletta/ui/data.py:320
msgid "Read again"
msgstr "Läs in igen"

#: tavletta/ui/data.py:324
msgid "Choose another file"
msgstr "Välj en annan fil"

#: tavletta/ui/data.py:326
msgid "Remove data file"
msgstr "Ta bort datafilen"

#: tavletta/ui/data.py:337 tavletta/server/web/batch.js:404
msgid "Sheet"
msgstr "Blad"

#: tavletta/ui/data.py:357
msgid "Insert column"
msgstr "Infoga kolumn"

#: tavletta/ui/editor.py:738
#, python-format
msgid "Elements removed: %d"
msgstr "Element borttagna: %d"

#: tavletta/ui/editor.py:738 tavletta/ui/shortcuts.py:53
#: tavletta/ui/window.py:187 tavletta/ui/window.py:987
msgid "Undo"
msgstr "Ångra"

#: tavletta/ui/editor.py:819
msgid "Elements can be moved in the free layout"
msgstr "Element kan flyttas i den fria layouten"

#: tavletta/ui/editor.py:820
msgid "Use free layout"
msgstr "Använd fri layout"

#: tavletta/ui/editor.py:830
msgid "No element selected"
msgstr "Inget element markerat"

#: tavletta/ui/editor.py:832
#, python-format
msgid "Elements selected: %(n)d of %(total)d"
msgstr "Element markerade: %(n)d av %(total)d"

#: tavletta/ui/editor.py:838
#, python-format
msgid "Element %(n)d of %(total)d: %(name)s"
msgstr "Element %(n)d av %(total)d: %(name)s"

#: tavletta/ui/editor.py:883
msgid "Arrange"
msgstr "Ordna"

#: tavletta/ui/editor.py:884
msgid "Align, distribute and snap the selected elements"
msgstr "Justera, fördela och fäst de markerade elementen"

#: tavletta/ui/editor.py:900 tavletta/ui/image_crop.py:82
#: tavletta/ui/texts.py:120
msgid "Left"
msgstr "Vänster"

#: tavletta/ui/editor.py:901 tavletta/ui/texts.py:76 tavletta/ui/texts.py:120
msgid "Centre"
msgstr "Mitten"

#: tavletta/ui/editor.py:902 tavletta/ui/texts.py:120
msgid "Right"
msgstr "Höger"

#: tavletta/ui/editor.py:903 tavletta/ui/image_crop.py:82
#: tavletta/ui/texts.py:171
msgid "Top"
msgstr "Överkant"

